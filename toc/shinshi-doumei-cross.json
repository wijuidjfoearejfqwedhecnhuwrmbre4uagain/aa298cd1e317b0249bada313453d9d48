097356723","33","8",0,19279,[1,0],"В такую ночь я думаю о тебе, и ты ближе, чем если бы находилась рядом..."],["41517942759776691","32.5","7",0,19279,[1,0],"Экстра : Майнд Оракл Дженерэйшн Маоры"],["41517942407455155","32","7",0,19279,[1,0],"Воспоминания, песня канарейки"],["41517942071910835","31","7",0,19279,[1,0],"Гортензия всегда расцветает во время дождя"],["41517941736366515","30","7",0,19279,[1,0],"Мелодия твоего дыхания"],["41517941384044979","29","7",0,19279,[1,0],"Фантазия открытого сердца"],["41517941014946227","28","7",0,19279,[1,0],"Биение моего сердца: врата из цветов сакуры"],["41517214091731379","27.5","6",0,19279,[1,0],"Экстра : Чья Хайне сестра?!"],["41517213739409843","27","6",0,19279,[1,0],"Не он один"],["41517213420642739","26","6",0,19279,[1,0],"Порывистая главная героиня. Молодая госпожа соизволит гневаться!"],["41517213101875635","25","6",0,19279,[1,0],"Маора. Сенсация!!!"],["41517212732776883","24","6",0,19279,[1,0],"Осколки любви"],["41517212346900915","23","6",0,19279,[1,0],"Одна единственная любовь"],["41516424438505907","22.5","5",0,19279,[1,0],"Экстра : Ключ к любви Кусами и Комаки"],["41516424119738803","22","5",0,19279,[1,0],"Полночный лабиринт"],["41516423733862835","21","5",0,19279,[1,0],"Любовь на одну ночь"],["41516423364764083","20","5",0,19279,[1,0],"Столь важный отцу белоснежный мир"],["41516423012442547","19","5",0,19279,[1,0],"Я все еще могу улыбаться от всего сердца"],["41515481122759091","18.5","4",0,19279,[1,0],"Экстра"],["41515480770437555","18","4",0,19279,[1,0],"Прощай, Платиновая!"],["41515480434893235","17","4",0,19279,[1,0],"Снег солнца - лед луны"],["41515480065794483","16","4",0,19279,[1,0],"Волшебство для Золушки"],["41515479713472947","15","4",0,19279,[1,0],"Монолог Магури"],["41514355254124979","14","3",0,19279,[1,0],"Так похоже на чудо. И нет никаких проблем!"],["41514354885026227","13","3",0,19279,[1,0],"Океан и балет. Любовь тени"],["41514354515927475","12","3",0,19279,[1,0],"Лагерь подготовки к летнему фестивалю. Насыщенное лето, тропические соки и другие напитки"],["41514354029388211","11","3",0,19279,[1,0],"И увидев тебя, я поняла, что ты - моя сила"],["41514353626735027","10","3",0,19279,[1,0],"Предрассветный этюд"],["41512965630878131","9","2",0,19279,[1,0],"Принцесса, иллюстрированная книжка и принц"],["41512965228224947","8","2",0,19279,[1,0],"Два Котея"],["41512964842348979","7","2",0,19279,[1,0],"Теория Котея. Он так напряженно думал"],["41512964422918579","6","2",0,19279,[1,0],"Ты нравишься мне такой, какая ты есть"],["41512964003488179","5","2",0,19279,[1,0],"Друг 06"],["41512185909764531","4.5","1",0,19279,[1,0],"Экстра"],["41512185540665779","4","1",0,19279,[1,0],"Сможет ли вера в тебя сделать меня сильнее?"],["41512185188344243","3","1",0,19279,[1,0],"Кто же кукловод? Неужели только тот, кто заберется на гору Фудзи, сможет понять, что она высокая?"],["41512184819245491","2","1",0,19279,[1,0],"Волнующее чувство любви! Студенческий совет полон тайн!"],["41512184466923955","1","1",0,19279,[1,0],"Давай же, Котей!"]],"w":{"n":["Альянс Джентльменов +","Shinshi Doumei Cross","The Gentleman's Alliance Cross","紳士同盟†","Umi no Chikyuugi Nocturne","Umi no C","The Globe of the Sea - Nocturne","The Gentlemen's Alliance Cross","Shoujo Eve Ringo Jikake no 24 Ji","Shojo Eve: Eve's Applework 24 Hours","Shinshi Doumei +","Kusame and Komaki and the Key of Love"],"t":"manga","p":105,"s":["shinshi-doumei-cross",62,"2023-02-28","41511130153116083/covers/b2ab91a35fc3f9212b315f0fddd5f20b40af3e17_49226660607713683.jpeg",1],"h":["the_gentlemen_alliance_cross","0018/40/1739684.jpeg"],"l":[22,58,8,1],"st":"f"}}