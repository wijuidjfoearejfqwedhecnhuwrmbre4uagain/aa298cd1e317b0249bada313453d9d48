{"slug":"zhe-ge-bi-xia-bu-dui-jin","m":"45028195405226430","at":"2026-10-18","hidden":1,"b":["45028195405291966"],"t":[["45024068277133758","Правители Тартара"]],"c":[["82783993589686666","9","1",0,19564,[0],"Ты называешь эту штуку кошкой?!"],["82783992549499274","8","1",0,19564,[0],"Но мой всё равно больше!"],["82783991005995402","7","1",0,19564,[0],"Ты думаешь, что ты крут, но это не так"],["82783989445714314","6","1",0,19564,[0],"Что? Токсичный командир \"крут\"?"],["82783986643919242","5","1",0,19564,[0],"Отдай мне свою жизнь"],["82783323658674570","4","1",0,19564,[0],"Как бы ты не умолял, это не сработает"],["82783318323519882","3","1",0,19564,[0],"Император уронил ведро!"],["82783316511580554","2","1",0,19564,[0],"Все разрушено, зло приближается"],["82783315555279242","1","1",0,19564,[0],"Превращение в прекрасного мужчину"]]}