{"slug":"my-life-as-a-loser","m":"92772265212535217","at":"2026-10-15","b":["92772265212600753"],"t":[["80516244045848992","Viralys"],["92774161205715377","Not Bad"]],"c":[["92858049198318001","55","1",0,19633,[0],"Конец"],["92857950430847409","54","1",0,19633,[0],"Так перед кем мне извиняться?!"],["92857839214682545","53","1",0,19633,[0],"Зверь"],["92857715080061361","52","1",0,19633,[0],"Я не смог сказать ей..."],["92857604014891441","51","1",0,19633,[0],"Теперь я всё осознал"],["92857482531135921","50","1",0,19633,[0],"Бегать нагишом по улице!"],["92857343196357041","49","1",0,19633,[0],"Извинитесь... Вы все!"],["92857249881481649","48","1",0,19633,[0],"Дружба"],["92857212719882673","47","1",0,19633,[0],"Нет, так я не закончу инцидент!"],["92857066556776881","46","1",0,19633,[0],"В этот момент я сломался..."],["92856970993754545","45","1",0,19633,[0],"4-ый инцидент"],["92856878954013105","44","1",0,19633,[0],"Как же это больно... Терять всех.."],["92856765070270897","43","1",0,19633,[0],"Перед днём рождения Дабин"],["92856672963355057","42","1",0,19633,[0],"UFC"],["92856555120189873","41","1",0,19633,[0],"Я принял решение!"],["92856442360521137","40","1",0,19633,[0],"Вор Джинву"],["92856336060015025","39","1",0,19633,[0],"Мне так жаль!"],["92856210801320369","38","1",0,19633,[0],"Все маски будут сорваны!"],["92856082522726833","37","1",0,19633,[0],"Остановить ценой жизни!"],["92855918189961649","36","1",0,19633,[0]],["92855792092406193","35","1",0,19633,[0]],["92855612475466161","34","1",0,19633,[0],"Почему всё не так?"],["92855475254616497","33","1",0,19633,[0]],["92855401535594929","32","1",0,19633,[0]],["92855332950335921","31","1",0,19633,[0],"Твоя преданность"],["92855263677145521","30","1",0,19633,[0],"Ах~ это так трудно"],["92855204386529713","29","1",0,19633,[0],"Смотришь на меня с тех пор, как я пришёл в библиотеку, тц, тц"],["92855138619908529","28","1",0,19633,[0],"Когда произойдёт третий инцидент?"],["92855062233113009","27","1",0,19633,[0],"Я убью тебя до того, как приедет полиция!"],["92854995526967729","26","1",0,19633,[0],"Я здесь по другой причине"],["92854902480527793","25","1",0,19633,[0],"Это девушка, которая раздаёт штрафы?"],["92854833190625713","24","1",0,19633,[0],"Неравный бой"],["92854749036044721","23","1",0,19633,[0],"Я не заинтересован в 3D"],["92854665066144177","22","1",0,19633,[0],"Хочешь защитить меня?!"],["92798542527160753","21","1",0,19633,[0],"Обрезание — не такое уж большое дело, хехе"],["92797995053048241","20","1",0,19633,[0],"Так вот почему над вами издевались"],["92797461956944305","19","1",0,19633,[0],"Сегодня я без чулок"],["92796585280364977","18","1",0,19633,[0],"Ты мне наскучил до смерти"],["92795861561598385","17","1",0,19633,[0],"Закрой дверь, холодно"],["92795809904550321","16","1",0,19633,[0],"Руки прочь от карточки Югио"],["92794442192347569","15","1",0,19633,[0],"Ты... хочешь посмотреть?"],["92794392447836593","14","1",0,19633,[0],"Пожалуйста, издевайся надо мной!"],["92794098896888241","13","1",0,19633,[0],"Он профессионал в уличных боях"],["92794059386610097","12","1",0,19633,[0],"Ты чёртов извращенец"],["92794018383094193","11","1",0,19633,[0],"Пожалуйста... позволь мне у тебя переночевать"],["92793966138778033","10","1",0,19633,[0],"Взрывной вес Сонни!"],["92793814221087153","9","1",0,19633,[0],"Людей делают манеры (2)"],["92793772026388913","8","1",0,19633,[0],"Почему ты плачешь?"],["92793555969401265","7","1",0,19633,[0],"Джанг Анчул был сущим дьяволом"],["92783604563796401","6","1",0,19633,[0],"Первый инцидент"],["92783423017542065","5","1",0,19633,[0],"Как насчёт геройского имени \"Розовый муж\"?"],["92783293681918385","4","1",0,19633,[0],"Беспричинное удушение!"],["92778306738348465","3","1",0,19633,[0],"Может всем рассказать, что тебя избил неудачник?"],["92774857745457585","2","1",0,19633,[1],"Людей делают манеры (1)"],["92774663314301361","1","1",0,19633,[1],"Бывший лузером, даже вырастя, останется лузером"],["92774600382964145","0","1",0,19633,[1],"Пролог"]],