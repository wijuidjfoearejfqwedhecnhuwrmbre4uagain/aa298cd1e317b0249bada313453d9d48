{"slug":"meolliseo-bomyeon-pureun-bom","m":"62425875148202428","at":"2026-10-18","b":["62425875148267964"],"t":[["39804024769241531","Rikudou-Sennin Clan"]],"c":[["77971769692021136","131","3",0,19530,[0],"Ничего не делай"],["77971769255813520","130","3",0,19530,[0],"Очнись"],["77971768349843856","129","3",0,19530,[0],"Так что посмейся, Нам Сухён"],["77971767930413456","128","3",0,19530,[0],"Давно мы с тобой в двоем не болтали"],["66470867764273596","127","3",0,19451,[0],"Потому что мне тебя..."],["63183284225466808","126","3",0,19428,[0],"Джун... Он какой?"],["63183283856368056","125","3",0,19428,[0],"Хочешь отомстить?"],["63183283487269304","124","3",0,19428,[0],"Это ты называешь стараниями?"],["63183283101393336","123","3",0,19428,[0],"Неловкая лягушка"],["63183282732294584","122","3",0,19428,[0],"Чем скорее отплачу, тем раньше полегчает"],["63183282329641400","121","3",0,19428,[0],"Не хочу никого любить"],["63183281943765432","120","3",0,19428,[0],"Везёт тебе"],["63183281155236280","119","3",0,19428,[0],"Условия дружбы"],["63183280752583096","118","3",0,19428,[0],"Я тебе не нравлюсь"],["63183280349929912","117","3",0,19428,[0],"А ты пока всё ещё студент!"],["63183276256289208","116","3",0,19428,[0],"Я решила"],["63183275635532216","115","3",0,19428,[0],"Тогда какая у тебя причина?"],["63183275283210680","114","3",0,19428,[0],"Если покажу, может, ты перестанешь извиняться?"],["63183274897334712","113","3",0,19428,[0],"Просто скажите, что вы живы"],["63183273739706808","112","3",0,19428,[0],"Если же нет"],["63183273353830840","111","3",0,19428,[0],"Я же всё правильно делаю?"],["63183272951177656","110","3",0,19428,[0],"Сам себе на уме"],["63183272196202936","109","3",0,19428,[0],"Сохраняя дистанцию"],["63183271793549752","108","3",0,19428,[0],"Тебе со мной дискомфортно?"],["63183271005020600","107","3",0,19428,[0],"Я не хочу тосковать"],["63181989762589112","106","2",0,19428,[0],"Старались изо всех сил"],["63181988688847288","105","2",0,19428,[0],"Я всего лишь..."],["63181988319748536","104","2",0,19428,[0],"Как будто я уже понимаю, что это скоро закончится"],["63181987598328248","103","2",0,19428,[0],"Не напрягайся"],["63181987246006712","102","2",0,19428,[0],"Для меня друзья..."],["63181986860130744","101","2",0,19428,[0],"Один (+экстра)"],["63181986105156024","100","2",0,19428,[0],"Создать собственный капитал"],["63181985702502840","99","2",0,19428,[0],"Проси прощения"],["63181984913973688","98","2",0,19428,[0],"Хэппи бёздей"],["63181984125444536","97","2",0,19428,[0],"Нам нельзя вместе"],["63181983722791352","96","2",0,19428,[0],"Всё из-за меня"],["63181566087553464","95","2",0,19428,[0],"Почему?"],["63181565349355960","94","2",0,19428,[0],"В последний раз"],["63181564980257208","93","2",0,19428,[0],"Я хотел бы..."],["63181564258836920","92","2",0,19428,[0],"С Днём Рождения"],["63181563117986232","91","2",0,19428,[0],"Чем хочешь заниматься?"],["63181562564338104","90","2",0,19428,[0],"Можно будет отдохнуть"],["63181562094576056","89","2",0,19428,[0],"Это полезный опыт"],["63181561691922872","88","2",0,19428,[0],"Каково это, зарабатывать?"],["63181560551072184","87","2",0,19428,[0],"Любить проще?"],["63181560165196216","86","2",0,19428,[0],"Муравей и цикада"],["63181316140589496","85","2",0,19428,[0],"В моей жизни... ты самый"],["63181305872933304","84","2",0,19428,[0],"Чтобы мы стали равными"],["63181305000518072","83","2",0,19428,[0],"Третьего шанса не будет"],["63181303624786360","82","2",0,19428,[0],"Поговорим за ужином"],["63181302668485048","81","2",0,19428,[0],"Заново искать своё место"],["63181289011831224","80","2",0,19428,[0],"Не прощай меня больше"],["63181287753540024","79","2",0,19428,[0],"Чёртовы братья Ё"],["63181286948233656","78","2",0,19428,[0],"Никто не может того, что могу я"],["63181286730129848","77","2",0,19428,[0],"Станешь меня презирать"],["63181286059041208","76","2",0,19428,[0],"Это всё из-за хёна"],["63181285840937400","75","2",0,19428,[0],"Двадцать пять, двадцать девять"],["63181285236957624","74","2",0,19428,[0],"Как он меня раздражает!"],["63181284263879096","73","2",0,19428,[0],"Зелёный свет"],["63181283777339832","72","2",0,19428,[0],"Не надо ненавидеть меня"],["63181282888147384","71","2",0,19428,[0],"Семья?"],["63181282233835960","70","2",0,19428,[0],"Свободное время"],["63181280321233336","69","2",0,19428,[0],"Чтобы не причинить боль"],["63181279801139640","68","2",0,19428,[0],"Когда произносишь «если бы»..."],["63181279247491512","67","2",0,19428,[0],"Резкие слова"],["63181278106640824","66","2",0,19428,[0],"Упустила"],["63180660906418616","65","2",0,19428,[0],"В свои 25"],["63180660570874296","64","2",0,19428,[0],"Выбор за тобой"],["63180291841221048","63","2",0,19428,[0],"Проблема во мне"],["63180291505676728","62","2",0,19428,[0],"Не бросай меня, что бы ни случилось"],["63180290415157688","61","2",0,19428,[0],"Я могу тебя кое о чём попросить?"],["63180290046058936","60","2",0,19428,[0],"Взгляни на меня"],["63180289676960184","59","2",0,19428,[0],"Чёртова бедность"],["63180288586441144","58","2",0,19428,[0],"Я понимаю, что мы разные"],["63180288217342392","57","2",0,19428,[0],"Не хочу ничего от тебя получать"],["63180287479144888","56","2",0,19428,[0],"«Не будь такой обидчивой» - странная фраза"],["63180286724170168","55","2",0,19428,[0],"Чтобы меня не затянуло"],["63180286355071416","54","2",0,19428,[0],"О ком ты мечтаешь"],["63180285616873912","53","2",0,19428,[0],"Пока живём вместе..."],["63180285230997944","52","2",0,19428,[0],"Теперь-то можно выбрасывать?"],["63180281338683832","51","2",0,19428,[0],"Так стыдно"],["63180280952807864","50","2",0,19428,[0],"Дальше будет только веселее"],["63180279912620472","49","2",0,19428,[0],"Страшнее врага"],["63180279526744504","48","2",0,19428,[0],"Я буду продолжать тебя обманывать"],["63180279174422968","47","2",0,19428,[0],"Не очень-то доверяй"],["63180278453002680","46","2",0,19428,[0],"Как плод с Древа Познания"],["63180278067126712","45","2",0,19428,[0],"Какие, к чёрту, отношения..."],["63180277698027960","44","2",0,19428,[0],"Все ждут весну"],["63180276926276024","43","2",0,19428,[0],"Пролог"],["63178767547261368","42","1",0,19428,[0],"Эпилог"],["63178767178162616","41","1",0,19428,[0],"Добро пожаловать"],["63178766809063864","40","1",0,19428,[0],"У нас больше не будет повода увидеться"],["63178766439965112","39","1",0,19428,[0],"Я сам"],["63178765684990392","38","1",0,19428,[0],"За нынешнюю молодежь..."],["63178765315891640","37","1",0,19428,[0],"Просто... это ранит"],["63178764896461240","36","1",0,19428,[0],"Это перестанет быть ложью"],["63178142881178040","35","1",0,19428,[0],"Нам Сухён-сонбэним!.."],["63178142193312184","34","1",0,19428,[0],"Плесень и Цыпленок"],["63178076191744440","33","1",0,19428,[0],"Дайте пять?"],["63178075772379576","32","1",0,19428,[0],"Первая любовь"],["63178075436769720","31","1",0,19428,[0],"Я так не могу!"],["63178075101225400","30","1",0,19428,[0],"Справился на отлично"],["63178074748903864","29","1",0,19428,[0],"Самый. Лучший. Сын"],["63178074363027896","28","1",0,19428,[0],"Он навсегда забудет обо мне"],["63178074010706360","27","1",0,19428,[0],"У тебя всё просто"],["63178073658384824","26","1",0,19428,[0],"Для тебя я всё..."],["63178073306063288","25","1",0,19428,[0],"Ё ДжунВан"],["63178072953741752","24","1",0,19428,[0],"Больше всего на свете..."],["63178072584643000","23","1",0,19428,[0],"После проекта мы..."],["63178072215544248","22","1",0,19428,[0],"Говорят, что слова ничего не значат"],["63178071846445496","21","1",0,19428,[0],"Это правда"],["62427598403166652","20","1",0,19423,[0],"По своей узкой тропинке"],["62427596339569084","19","1",0,19423,[0],"Может статься, он прекрасный человек"],["62427594192085436","18","1",0,19423,[0],"Мне ничего не стоит солгать"],["62427317284135356","17","1",0,19423,[0],"Избитое выражение"],["62427314901770684","16","1",0,19423,[0],"Все улетучится"],["62427314113241532","15","1",0,19423,[0],"Ты же остался"],["62427312636846524","14","1",0,19423,[0],"Никто тебе не поможет"],["62427310371922364","13","1",0,19423,[0],"Это не любовь"],["62427309868605884","12","1",0,19423,[0],"Покончи с этим"],["62427307654013372","11","1",0,19423,[0],"Алкашка"],["62427306580271548","10","1",0,19423,[0],"Возможно, мы похожи"],["62427304952881596","9","1",0,19423,[0],"Вот бы поменяться с Джуном местами"],["62427031266156988","8","1",0,19423,[0],"Ничем не могу помочь"],["62427030460850620","7","1",0,19423,[0],"Помогите мне..."],["62427028682465724","6","1",0,19423,[0],"Итить"],["62427028296589756","5","1",0,19423,[0],"Это бесмысленно"],["62427026652422588","4","1",0,19423,[0],"Вы из тех, кто катит, а не катится?"],["62427026266546620","3","1",0,19423,[0],"Откуда такие берутся только?"],["62427024991478204","2","1",0,19423,[0],"Не стоит волноваться"],["62427019740209596","1","1",0,19423,[0],"Остановка «Университет Мёниль»"],["62427019337556412","0","1",0,19423,[0],"Пролог"]],"w":{"n":["Молодо-зелено","Meolliseo bomyeon pureun bom"],"t":"manhwa","p":1191,"s":["meolliseo-bomyeon-pureun-bom",132,"2023-06-22","62425875148202428/covers/285be3ea1e05c1866c57c27d8f37d8c14474cde0_62425986599248316.jpeg",1],"x":1,"l":[48,22,15,393,203],"st":"f","cc":[131,1,132]}}