{"slug":"kono-s-o-mi-yo-cupid-no-itazura","m":"36279313703657876","at":"2026-10-15","b":["36279313703723412"],"t":[["36240557764272525","Violent Manga Project"]],"c":[["37168549352989064","146","14",0,19249,[0],"Я люблю тебя, Рин."],["37168528633127304","145","14",0,19249,[0],"Словно возлюбленные."],["37168527139955080","144","14",0,19249,[0],"Лик девушки."],["37168525864886664","143","14",0,19249,[0],"Что же я творю..."],["37168524539486600","142","14",0,19249,[0],"Не рожай."],["37168523113423240","141","14",0,19249,[0],"Извращенец."],["37168521502810504","140","14",0,19249,[0],"Пожалуйста."],["37168519724425608","139","14",0,19249,[0],"Правда?"],["37168516956184968","138","14",0,19249,[0],"Люблю."],["37168515228131720","137","14",0,19249,[0],"Предсвадебная поездка."],["37168513600741768","136","13",0,19249,[0],"Я все еще..."],["37168512006906248","135","13",0,19249,[0],"Горе или счастье."],["37168510463402376","134","13",0,19249,[0],"Родимые пятна и раны - 14"],["37168508567576968","133","13",0,19249,[0],"Родимые пятна и раны - 13"],["37168506554311048","132","13",0,19249,[0],"Родимые пятна и раны - 12"],["37167221637669256","131","13",0,19249,[0],"Родимые пятна и раны - 11"],["37167219389522312","130","13",0,19249,[0],"Родимые пятна и раны - 10"],["37167217829241224","129","13",0,19249,[0],"Родимые пятна и раны - 9"],["37167216151519624","128","13",0,19249,[0],"Родимые пятна и раны - 8"],["37164889235546504","127","12",0,19249,[0],"Родимые пятна и раны - 7"],["37164887960478088","126","12",0,19249,[0],"Родимые пятна и раны - 6"],["37164886484083080","125","12",0,19249,[0],"Родимые пятна и раны - 5"],["37164696666661256","124","12",0,19249,[0],"Родимые пятна и раны - 4"],["37164694166856072","123","12",0,19249,[0],"Родимые пятна и раны - 3"],["37164692254253448","122","12",0,19249,[0],"Родимые пятна и раны - 2"],["37164690677195144","121","12",0,19249,[0],"Родимые пятна и раны."],["37164330420035976","120","12",0,19249,[0],"Ведь на самом деле..."],["37164328054448520","119","12",0,19249,[0],"Съемки."],["37164194944016776","118","12",0,19249,[0],"Заявление."],["37164193182409096","117","12",0,19249,[0],"Это правда!"],["37162308715176328","116","11",0,19249,[0],"Злой умысел."],["37162183624253832","115","11",0,19249,[0],"Запретный след."],["37162069203640712","114","11",0,19249,[0],"Истинное лицо."],["37162004779131272","113","11",0,19249,[0],"Отори Шинья - 4"],["37162003369845128","112","11",0,19249,[0],"Отори Шинья - 3"],["37161688964817288","111","11",0,19249,[0],"Отори Шинья - 2"],["37161687370981768","110","11",0,19249,[0],"Отори Шинья?"],["37161685542265224","109","11",0,19249,[0],"Ошибаешься!"],["37161449520390536","108","11",0,19249,[0],"Вместе."],["37161312014328200","107","11",0,19249,[0],"Неприглядная истина."],["37160510348616072","106","10",0,19249,[0],"Тяжесть денег."],["37160390391521672","105","10",0,19249,[0],"Наказание."],["37160369168343432","104","10",0,19249,[0],"И каждый решил для себя."],["37160285131268488","103","10",0,19249,[0],"Моя ответственность."],["37160140478112136","102","10",0,19249,[0],"Я освобожу тебя."],["37160078737957256","101","10",0,19249,[0],"Да у нее не все дома!"],["37160076741468552","100","10",0,19249,[0],"Пленник диких фантазий."],["37159968964632968","99","10",0,19249,[0],"Не могу выбрать."],["37159966917812616","98","10",0,19249,[0],"Что за чушь!"],["37159742975533448","97","10",0,19249,[0],"Предназначен самой судьбой."],["37159741230702984","96","10",0,19249,[0],"Он стал совсем другим."],["37159600436306312","95","9",0,19249,[0],"Ошибаешься!"],["37159531129627016","94","9",0,19249,[0],"Преступить черту."],["37159428436287880","93","9",0,19249,[0],"Тот взгляд."],["37159426574016904","92","9",0,19249,[0],"Она все видела!"],["37159281048445320","91","9",0,19249,[0],"Деньги есть деньги."],["37159273750356360","90","9",0,19249,[0],"Их счастье."],["37158999207993736","89","9",0,19249,[0],"Всего лишь вещь."],["37158937534947720","88","9",0,19249,[0],"Готов на все. Что дальше?"],["37158862725341576","87","9",0,19249,[0],"Прозрение."],["37158779275469192","86","9",0,19249,[0],"Я тебя покупаю. ❤️"],["37158658815058312","85","9",0,19249,[0],"Любовь и деньги."],["37157504274162056","84","8",0,19249,[0],"Женись на мне!"],["37157494912475528","83","8",0,19249,[0],"Оскверни!"],["37157402671341960","82","8",0,19249,[0],"Герой-любовник."],["37157313114562952","81","8",0,19249,[0],"Сила, приносящая несчастье."],["37157095463739784","80","8",0,19249,[0],"Тиран и деспот"],["37156959165637000","79","8",0,19249,[0],"Отори и Чизуру."],["37156884037263752","78","8",0,19249,[0],"У меня ничего нет."],["37156809277989256","77","8",0,19249,[0],"Всегда вместе."],["37156726348210568","76","8",0,19249,[0],"Жестокий выбор."],["37156724720820616","75","8",0,19249,[0],"Я не брошу тебя."],["37156722975990152","74","8",0,19249,[0],"Тристан и Изольда."],["37156219357520264","73","7",0,19249,[0],"Ртом."],["37156218787094920","72","7",0,19249,[0],"Зависть."],["37156218401218952","71","7",0,19249,[0],"Груди."],["37156217797239176","70","7",0,19249,[0],"Покажи мне свое пятно ❤️"],["37156216639611272","69","7",0,19249,[0],"Я хочу кое-что тебе показать."],["37156216270512520","68","7",0,19249,[0],"Словно во сне."],["37156215414874504","67","7",0,19249,[0],"Я люблю тебя, Рин-кун."],["37156214995444104","66","7",0,19249,[0],"Не заставляй меня волноваться."],["37156214576013704","65","7",0,19249,[0],"Тот день для них обоих."],["37155633597800840","64","7",0,19249,[0],"Взрослый."],["37155632389841288","63","7",0,19249,[0],"Во что бы то ни стало."],["37155524411679112","62","6",0,19249,[0],"Мне нужно просто использовать ее."],["37155523035947400","61","6",0,19249,[0],"Я ее не отдам."],["37155521576329608","60","6",0,19249,[0],"Я так не могу."],["37155291543921032","59","6",0,19249,[0],"Мадлен."],["37155290268852616","58","6",0,19249,[0],"Личные чувства."],["37155289027338632","57","6",0,19249,[0],"Я так и думала."],["37155287433503112","56","6",0,19249,[0],"Путешествие на спине. ❤️"],["37155285923553672","55","6",0,19249,[0],"Прыгай, дельфин, прыгай!"],["37155024702300552","54","6",0,19249,[0],"Воспоминания Чизуру. Часть 5."],["37154965545836936","53","6",0,19249,[0],"Воспоминания Чизуру. Часть 4."],["37154866711257480","52","6",0,19249,[0],"Воспоминания Чизуру. Часть 3."],["37153996158296456","51","5",0,19249,[0],"Воспоминания Чизуру. Часть 2."],["37153846404866440","50","5",0,19249,[0],"Воспоминания Чизуру. Часть 1."],["37153786426319240","49","5",0,19249,[0],"Это я, Чизуру..."],["37153785017033096","48","5",0,19249,[0],"Разве мы не в одном и том же положении?"],["37153665210933640","47","5",0,19249,[0],"Не шути со мной!"],["37153643417330056","46","5",0,19249,[0],"Трахни, или облажаешься."],["37153545723601288","45","5",0,19249,[0],"Через год."],["37153544029102472","44","5",0,19249,[0],"Так значит, это правда?"],["37153420146139528","43","5",0,19249,[0],"Мужчина моей жизни."],["37153418803962248","42","5",0,19249,[0],"Я не проиграю!"],["37153249672847752","41","5",0,19249,[0],"Способ выражения чувств."],["37153213970932104","40","4",0,19249,[0],"О родимом пятне."],["37153108157030792","39","4",0,19249,[0],"Я люблю тебя."],["37153076229988744","38","4",0,19249,[0],"Рин-кун виноват."],["37152983032553864","37","4",0,19249,[0],"Ночь секса."],["37152897955291528","36","4",0,19249,[0],"Секс с Рином."],["37152896797663624","35","4",0,19249,[0],"Чтоя, черт возьми, делаю?!"],["37152895254159752","34","4",0,19249,[0],"Я не понимаю."],["37152421935341960","33","4",0,19249,[0],"Тревога."],["37152367006736776","32","4",0,19249,[0],"Плохая старшая сестра."],["37152326993076616","31","4",0,19249,[0],"В ад с любовью."],["37152325416018312","30","4",0,19249,[0],"Ну я и дурак!"],["37151230602011016","29","3",0,19249,[0],"Плохая женщина."],["37151210167361928","28","3",0,19249,[0],"Разделить счастье."],["37151149232513416","27","3",0,19249,[0],"С самого начала."],["37151147353465224","26","3",0,19249,[0],"Я так и знал!"],["37150993405731208","25","3",0,19249,[0],"Пожилая леди."],["37150991593791880","24","3",0,19249,[0],"Это приказ."],["37150870529401224","23","3",0,19249,[0],"Откладывать удовольствие."],["37150840196194696","22","3",0,19249,[0],"Это выражение лица."],["37150838921126280","21","3",0,19249,[0],"Место встречи."],["37150837511840136","20","3",0,19249,[0],"Я верю ей!"],["37150836018667912","19","3",0,19249,[0],"Горячка, горячка, горячка!"],["37150454722879880","18","2",0,19249,[0],"Йах!"],["37150452139188616","17","2",0,19249,[0],"Не собираюсь тебя отпускать!"],["37150450478244232","16","2",0,19249,[0],"Не верь ей!"],["37150288410337672","15","2",0,19249,[0],"Пока мы не поженимся."],["37150195011576200","14","2",0,19249,[0],"Хотела забрать ее?"],["37150192595722632","13","2",0,19249,[0],"Ограничения родимого пятна."],["37150114178949512","12","2",0,19249,[0],"Прощай!"],["37150030880072072","11","2",0,19249,[0],"Мой первый раз."],["37150029084909960","10","2",0,19249,[0],"Не похож на себя."],["37150026635436424","9","2",0,19249,[0],"Ночной хищник."],["37149825661165960","8","1",0,19249,[0],"Увидь во мне мужчину..."],["37149765783282056","7","1",0,19249,[0],"Немного поразвлечься."],["37149709076291976","6","1",0,19249,[0],"Я поймала!"],["37149677501571464","5","1",0,19249,[0],"Ты смеешься надо мной..."],["37149563886264712","4","1",0,19249,[0],"Обнажить \"клыки\"."],["37149513403621768","3","1",0,19249,[0],"Даже если ты все еще ни на что не годишься."],["37149446965846408","2","1",0,19249,[0],"Магия родимого пятна."],["37149417924485512","1","1",0,19249,[0],"Я жид, скрывая свою задницу."]],"w":{"n":["Взгляните-ка на эту S!","Take a Look at This S!","Kono S o, Mi yo! - Cupid no Itazura","このSを、見よ! クピドの悪戯","Ecce S, Take a Look at This S!","Ecce S"],"t":"manga","p":6321,"s":["kono-s-o-mi-yo-cupid-no-itazura",146,"2022-09-14","36279313703657876/covers/3a4b74234fcc8bca61919be60b6d7e8e8b6d0b8b_74600455094690177.jpeg",1],"d":["take-a-look-at-this-s",214],"h":["take_a_look_at_this_s","0012/99/1198855.png"],"x":1,"l":[2