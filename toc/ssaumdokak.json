,"149","2",0,19360,[0],"\"Я так не могу\""],["53295780739441071","148","2",0,19360,[0],"\"Все понарошку\""],["53294719463088559","147","2",0,19360,[0],"\"Ты жениться хочешь?!\""],["53294718255129007","146","2",0,19360,[0],"\"Как сражаться против вооруженного ножом\""],["53294717030392239","145","2",0,19360,[0],"\"Личность поставщика.\""],["53294425475932591","144","2",0,19360,[0],"\"Падение Козырей\""],["53294420157555119","143","2",0,19360,[0],"\"Жук-навозник\""],["53294418026848687","142","2",0,19360,[0],"\"Остается только убить его.\""],["53294416617562543","141","2",0,19360,[0],"\"Смотрю, яйца у тебя стальные.\""],["53294415426380207","140","2",0,19360,[0],"\"Прямо божий одуванчик.\""],["53294413010461103","139","2",0,19360,[0],"\"Есть че поесть?\""],["53294411869610415","138","2",0,19360,[0],"\"Он на нашей стороне?\""],["53294405209055663","137","2",0,19360,[0],"\"Любой ценой\""],["53294404084982191","136","2",0,19360,[0],"\"Вот и вся причина.\""],["53294403296453039","135","1",0,19360,[0],"\"Вы это хотели услышать?\""],["53294399454470575","134","1",0,19360,[0],"\"Да ты с ума сошел.\""],["53294398229733807","133","1",0,19360,[0],"\"Больно уж вы расшумелись\""],["53294397390873007","132","1",0,19360,[0],"\"Этот извращенец заставил меня пить через нос.\""],["53294396166136239","131","1",0,19360,[0],"\"Не пяльтесь так, ладненько?\""],["53293238169133487","130","1",0,19360,[0],"Так вот как все они тебе проиграли."],["53293235837100463","129","1",0,19360,[0],"\"Парнишка отстаивает справедливость\""],["53293071269388719","128","1",0,19360,[0],"\"Все потому, что их уже отп*здили, лол.\""],["53292981293179311","127","1",0,19360,[0],"\"Твой противник не Бог\""],["53292980940857775","126","1",0,19360,[0],"'‘Готовь хлеборезку’'"],["53292980571759023","125","1",0,19360,[0],"\"Псих\" Хан Ван-Гук"],["53292975941247407","124","1",0,19360,[0],"‘‘Как победить против пистолета’’"],["53292975588925871","123","1",0,19360,[0],"\"Пора начинать\""],["53292975186272687","122","1",0,19360,[0],"\"Это безумие\""],["53292974800396719","121","1",0,19360,[0],"\"Пререкаться вздумал?\""],["53292974448075183","120","1",0,19360,[0],"\"В постели ты все-таки победила\""],["53292974045421999","119","1",0,19360,[0],"\"Ты шо, не хочешь стать живым оружием?\""],["53292971847606703","118","1",0,19360,[0],"\"C каких пор мы начали встречаться за чашечкой кофе\""],["53292971075854767","117","1",0,19360,[0],"\"Ты следующий, Ю Хобин\""],["53292970270548399","116","1",0,19360,[0],"\"Один уже умер\""],["53292967686857135","115","1",0,19360,[0],"\"Гребаный Якудза\""],["53292966864773551","114","1",0,19360,[0],"\"А по тебе так и не скажешь\""],["53292966025912751","113","1",0,19360,[0],"\"Это настоящий нож?\""],["53291837825245615","112","1",0,19360,[0],"\"Мы должны отомстить\""],["53291800227504559","111","1",0,19360,[0],"\"Мягенько\""],["53291648846684591","110","1",0,19360,[0],"\"Алкогольный этикет\""],["53291637924716975","109","1",0,19360,[0],"‘Ты ж та п*здючка?’’"],["53291632170131887","108","1",0,19360,[0],"‘‘Ты, бл*ть, меня не услышал?’’"],["53291630324638127","107","1",0,19360,[0],"\"Прости, что веду себя как полный неудачник\""],["53291629502554543","106","1",0,19360,[0],"А ты напористый..."],["53291623529865647","105","1",0,19360,[0],"\"Давай посмотрим вместе\""],["53291622623895983","104","1",0,19360,[0],"\"Мне нравится Чои Боми\""],["53291621181055407","103","1",0,19360,[0],"\"Это против правил\""],["53290978143920559","102","1",0,19360,[0],"\"Сегодня он горчит\""],["53290923903181231","101","1",0,19360,[0],"\"Ты был взрослым\""],["53290919222337967","100","1",0,19360,[0],"Повеселимся?"],["53290715244945839","99","1",0,19360,[0],"\"Он был другим.\""],["53290708349510063","98","1",0,19360,[0],"‘‘Смотри, не вздумай отказаться от своих слов, ладно?’’"],["53290585473180079","97","1",0,19360,[0],"‘‘Третьесортный якудза’’"],["53290583711572399","96","1",0,19360,[0],"\"Я бросил свою мать\"."],["53290580289020335","95","1",0,19360,[0],"‘‘Я не должен был этого делат