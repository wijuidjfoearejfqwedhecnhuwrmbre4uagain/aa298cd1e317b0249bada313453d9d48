{"slug":"kakkou-no-iinazuke","m":"53695392079962529","at":"2026-10-15","b":["53695392080028065"],"t":[["35748932906672555","Кофейный Домик"],["40966771636724129","Nippa Team"],["47609590740705726","Japit Comics"],["68326900937810342","Solo&MeTeam"]],"c":[["204039070643406342","214","25",0,20400,[3],"Куда плывёт эта лодка?"],["203912347146798598","213","24",0,20399,[3],"Сегодня день свободный, так что..."],["203667642173638150","212","24",0,20398,[3],"Мои прошлые слова были правдой"],["203519245433193990","211","24",0,20397,[3],"Ночь - это же самое лучшее время!"],["203485438822860294","210","24",0,20396,[3],"Куда, по-твоему, мы едем?"],["203485453150602758","209","24",0,20396,[3],"Я как будто сплю!"],["203485455985952262","208","24",0,20396,[3],"Я не понимаю японских старшеклассниц!"],["203485431122118150","207","24",0,20396,[3],"...Сидит прямо передо мной!"],["203485441222002182","206","24",0,20396,[3],"...Теперь мы третьегодки!"],["203485492191184390","205","24",0,20396,[3],"Каким будет подарок?"],["203485392014427654","204","23",0,20396,[3],"С днём рождения вас!"],["203484973154452998","203","23",0,20396,[3],"...Как будто я одна осталась в стороне!"],["203484931161081350","202","23",0,20396,[3],"Не хочу ему проиграть!"],["203484926614455814","201","23",0,20396,[3],"Прыгайте! Прокачу с ветерком!"],["203484934164203014","200","23",0,20396,[3],"Неужели пора?!"],["203484883916441094","199","23",0,20396,[3],"Подождите хотя бы пять минут"],["203484934046762502","198","23",0,20396,[3],"Добро пожаловать в виллу Небула"],["203484939348362758","197","23",0,20396,[3],"Мы собираемся победить..."],["203484848885614086","196","23",0,20396,[3],"Вы в самом деле очень похожи..."],["203484914736186886","195","22",0,20396,[3],"Несмотря на то, что они родственники?!"],["203485089470891526","194","22",0,20396,[3],"Хочу кое-что тебе показать..."],["203484932201268742","193","22",0,20396,[3],"Нежная братско-сестринская любовь"],["203484943039350278","192","22",0,20396,[3],"Тебе лучше поторопиться и выбрать одного из них"],["203484821958182406","191","22",0,20396,[3],"На чьей стороне мне быть?!"],["203484775132972550","190","22",0,20396,[3],"Какие-то проблемы, да?"],["203484743541474822","189","22",0,20396,[3],"Идём на разведку!"],["203484873514567174","188","22",0,20396,[3],"Что насчёт тебя?!"],["203484841235203590","187","22",0,20396,[3],"У меня почти получилось!"],["203484944633185798","186","21",0,20396,[3],"Почему я плачу?"],["203484820397901318","185","21",0,20396,[3],"Не смей недооценивать туристический бизнес!"],["203484748356535814","184","21",0,20396,[3],"Это проблема семьи Умино!"],["203484783974565382","183","21",0,20396,[3],"Спасибо вам за всё!"],["203484765469296134","182","21",0,20396,[3],"Кажется, словно так было всегда"],["203484769462273542","181","21",0,20396,[3],"Никогда ещё такого не делала!"],["203484882322605574","180","21",0,20396,[3],"Понятия не имею!"],["203484776357709318","179","21",0,20396,[3],"Взгляни в глаза страху"],["203484743239484934","178","21",0,20396,[3],"Пятьдесят на пятьдесят"],["203484694132573702","177","20",0,20396,[3],"Я об этом позабочусь!"],["203484750017480198","176","20",0,20396,[3],"Я со всем справлюсь!"],["203484749094733318","175","20",0,20396,[3],"Совсем скоро..."],["182026854264227366","174","20",0,20248,[3]],["182026823578699302","173","20",0,20248,[3]],["182026786433943078","172","20",0,20248,[3]],["182026744692229670","171","20",0,20248,[3]],["182026697548252710","170","20",0,20248,[3]],["182026646377743910","169","20",0,20248,[3]],["182026602807313958","168","19",0,20248,[3]],["182026553515853350","167","19",0,20248,[3]],["182026513384752678","166","19",0,20248,[3]],["182026458892355110","165","19",0,20248,[3]],["182026426696877606","164","19",0,20248,[3]],["182026407403079206","163","19",0,20248,[3]],["182026364067530278","162","19",0,20248,[3]],["182026320547431974","161","19",0,20248,[3]],["182026290046453286","160","19",0,20248,[3]],["182026248237631014","159","18",0,20248,[3]],["182026210153350694","158","18",0,20248,[3]],["182026177270007334","157","18",0,20248,[3]],["182026143698798118","156","18",0,20248,[3]],["182026108701525542","155","18",0,20248,[3]],["182026075918845478","154","18",0,20248,[3]],["182026037331248678","153","18",0,20248,[3]],["182026001797105190","152","18",0,20248,[3]],["182025946029639206","151","18",0,20248,[3]],["182025914438141478","150","17",0,20248,[3]],["182025874491590182","149","17",0,20248,[3]],["182025832867317286","148","17",0,20248,[3]],["134046718525261356","147","17",0,19917,[3]],["134046695188088364","146","17",0,19917,[3]],["134046663059785260","145","17",0,19917,[3]],["68367716498563494","144","16",0,19464,[3],"Он — живое доказательство!"],["68367715525484966","143","16",0,19464,[3],"Разве этого недостаточно?"],["68334132958093734","142","16",0,19464,[3],"Неужели сегодня?!"],["68334131817243046","141","16",0,19464,[3],"Однажды я бы всё равно увидела"],["68334130777055654","140","16",0,19464,[3],"«Лучшее что было в моей жизни!»"],["68334129787199910","139","16",0,19464,[3],"Потому что я не хочу проиграть"],["68334128713458086","138","16",0,19464,[3],"Мы будем расти над собой!"],["68334127018959270","137","16",0,19464,[3],"...Ага, я очень сильно люблю его"],["68333518777770406","136","16",0,19464,[3],"Потому что ты больше не часть семьи"],["68333346073108902","135","16",0,19464,[3],"Это правда так странно?"],["68333294181179814","134","16",0,19464,[3],"И так, наш «любовный треугольник» начинается"],["68333289970098598","133","16",0,19464,[3],"Но даже так, я всё равно люблю его"],["68333282118361510","132","15",0,19464,[3],"Не хочешь прислушаться к своей девушке?"],["68333278343487910","131","15",0,19464,[3],"Остаться с ней"],["68332823194395046","130","15",0,19464,[3],"Что я вообще делаю?"],["68332814990336422","129","15",0,19464,[3],"Она тебе нравится?"],["68332807323148710","128","15",0,19464,[3],"Я хочу дать должный ответ!"],["68332803548275110","127","15",0,19464,[3],"Я принцесса!"],["68332801384014246","126","15",0,19464,[3],"Сегодня, выглянуло солнце!"],["68332440740979110","125","15",0,19464,[3],"Что-то подобное - это уже слишком?.."],["68332438241173926","124","15",0,19464,[3],"Так вот, что она имела ввидую"],["68332436127244710","123","14",0,19464,[3],"Яненаю"],["68332434197864870","122","14",0,19464,[3],"Это... Довольно смущающе, не правда ли?"],["68332116672274854","121","14",0,19464,[3],"Ведь для меня всё так же"],["68332114541568422","120","14",0,19464,[3],"Я вижу всё насквозь"],["68332111722996134","119","14",0,19464,[3],"Именно в такие моменты"],["68332108904423846","118","14",0,19464,[3],"Я подумала, что тоже хочу попробовать"],["68332078436999590","117","14",0,19464,[3],"Я одобряю твои отношения!"],["68332075349991846","116","14",0,19464,[3],"Мне это всё-таки не нравится!"],["68332073621938598","115","14",0,19464,[3],"И вот мой ответ!"],["68332071306682790","114","13",0,19464,[3],"Так вот в чём дело!.."],["68332070719480230","113","13",0,19464,[3],"Я знала, что ты поймёшь, Умино-кун"],["68332068253229478","112","13",0,19464,[3],"Я и не думал, что настанет день, когда ты это скажешь"],["68331073347543462","111","13",0,19464,[3],"Я благодарен тебе, за твои чувства"],["68331072273801638","110","13",0,19464,[3],"Просто... Забудь что я это вообще говорила"],["68330770434908582","109","13",0,19464,[3],"Наги, у тебя всё лицо красное..."],["68330770032255398","108","13",0,19464,[3],"Прости, что мы не выиграли"],["68330608568328614","107","13",0,19464,[3],"Команда «Дом Ама-Уми»"],["68330560619045286","106","13",0,19464,[3],"Я рада, что смогла погулять с тобой по школе!"],["68330557397819814","105","12",0,19464,[3],"Знаю! Давай сделаем фото на память!"],["68330555350999462","104","12",0,19464,[3],"Ты хочешь на мне жениться?"],["68330221199188390","103","12",0,19464,[3],"Иметь четырёх родителей это весело, не правда ли?!"],["68330149292040614","102","12",0,19464,[3],"Ты же знаешь, что это была не я?"],["68330146624463270","101","12",0,19464,[3],"Просто я была так взволнована"],["68330144476979622","100","12",0,19464,[3],"Я надеюсь стать твоим партнером, Наги-кун!"],["68329889865949606","99","12",0,19464,[3],"Ты просто не можешь быть моим братом!"],["68329806952948134","98","12",0,19464,[3],"Она моя единственная дорогая младшая сестра...!"],["68329717832376742","97","12",0,19464,[3],"Сати-чан - Настоящий враг!"],["68329715752001958","96","11",0,19464,[3],"Однажды я тоже стану взрослым"],["68329595459363238","95","11",0,19464,[3],"Несомненно, сегодня Сэгава-сан — «звезда»"],["68329594184294822","94","11",0,19464,[3],"Ты правда любишь этот храм, так?"],["68329587406299558","93","11",0,19464,[3],"Ты бы не сделал это для того кого ты ненавидишь"],["68329585711800742","92","11",0,19464,[3],"Я хочу сделать Сэгаву-сан звездой!"],["68329583111332262","91","11",0,19464,[3],"Ты такой милый Наги-кун!"],["68329581819486630","90","11",0,19464,[3],"Мы увидим друг друга, да? Всего лишь через неделю!"],["68329054763245990","89","11",0,19464,[3],"Всё же только мы вольны прокладывать наш путь"],["68329053035192742","88","11",0,19464,[3],"Это родственная любовь, никакой романтики!"],["68329044143268262","87","10",0,19464,[3],"Амано-сан, ты когда-нибудь целовалась?"],["68329042499101094","86","10",0,19464,[3],"Вы хотите знать подхожу ли я Амано-сан?"],["68329041677017510","85","10",0,19464,[3],"Ты сильно изменилась с появления Наги-куна в твоей жизни!"],["68329040234176934","84","10",0,19464,[3],"Если ты двинешься, то я тебя замечу!"],["68329038522900902","83","10",0,19464,[3],"Как будто бы я могу вести себя нормально!"],["68329037163946406","82","10",0,19464,[3],"Ты и правда «мамина дочка»!"],["68328487559127462","81","10",0,19464,[3],"Я не прощу того кто это сделал!"],["68328487173251494","80","10",0,19464,[3],"Меня это тоже касается!"],["68328486753821094","79","10",0,19464,[3],"Расскажи мне про свои летние каникулы!"],["68328485914960294","78","9",0,19464,[3],"Как это произошло?"],["68328228216922534","77","9",0,19464,[3],"Конечно же это был мой первый раз!"],["68328226992185766","76","9",0,19464,[3],"Какой у неё костюм?"],["68328226203656614","75","9",0,19464,[3],"Вот это совпадение!"],["65474699089437095","74","9",0,19444,[0],"Словно на седьмом небе!"],["62282473907708290","73","9",0,19422,[0],"Сделаем шаг вперёд"],["60260543260287363","72","8",0,19408,[0],"Чем ты занимаешься?"],["57065949504758192","71","8",0,19386,[0],"В таком случае, каковы твои выводы?"],["55618485513904557","70","8",0,19376,[0],"Что за настроение?"],["53707068921635233","69","8",0,19363,[0],"Умножь это чувство где-то на сто"],["53707068669976993","68","8",0,19363,[0],"Ну и в кого же он такой?!"],["53707068418318753","67","8",0,19363,[0],"Проводишь меня до дома?"],["53707068183437729","66","8",0,19363,[0],"Так Наги признался тебе?"],["53707067931779489","65","8",0,19363,[0],"Без меня ты просто безнадёжен!"],["53707067680121249","64","8",0,19363,[0],"Помнишь, что тогда произошло?"],["53707067411685793","63","8",0,19363,[0],"Больше никогда не говори со мной!.."],["53702943756542369","62","8",0,19363,[0],"Мы сами вершим свою судьбу!"],["53702943270003105","61","8",0,19363,[0],"Я никогда не женюсь!"],["53702942783463841","60","7",0,19363,[0],"Начинаем операцию по лечению Эрики-тян!"],["53702942313701793","59","7",0,19363,[0],"С какой стати мы живём вместе?.."],["53702941776830881","58","7",0,19363,[0],"В кого Умино-кун впервые влюбился?"],["53702941256737185","57","7",0,19363,[0],"Я буду жить с Хиро-тян?"],["53702940703089057","56","7",0,19363,[0],"Самое важное, чтобы вы были счастливы"],["53702498204017057","55","7",0,19363,[0],"Мне что, нельзя быть плохой?.."],["53702497969136033","54","7",0,19363,[0],"Выходит, ты мой сообщник!"],["53702365680787873","53","7",0,19363,[0],"Что нам теперь делать?"],["53702290267201953","52","7",0,19363,[0],"Когда мы его найдём, я буду с тобой"],["53702289881325985","51","6",0,19363,[0],"Не против, если я заберу его?.."],["53702289042465185","50","6",0,19363,[0],"Отношения, которые стоят на месте? Таких не бывает!"],["53702288203604385","49","6",0,19363,[0],"Ещё раз так поступишь, и я прокляну тебя!.."],["53702287381520801","48","6",0,19363,[0],"То, что между нами, — наш секрет"],["53702286559437217","47","6",0,19363,[0],"Будто что-то изменилось в моей судьбе"],["53702285703799201","46","6",0,19363,[0],"Если бы я попросила жениться на мне…"],["53702279445897633","45","6",0,19363,[0],"Я хочу наконец-то стать взрослой!"],["53702278657368481","44","6",0,19363,[0],"Разве ещё не понял?"],["53702277449408929","43","6",0,19363,[0],"В тот самый день…"],["53702276644102561","42","5",0,19363,[0],"Это кто?"],["53702275822018977","41","5",0,19363,[0],"Эта поездка ведь так важна для тебя…"],["53702275419365793","40","5",0,19363,[0],"Я так рада, что встретила тебя"],["53702274580504993","39","5",0,19363,[0],"Неудивительно, если что-нибудь случится!"],["53702273422877089","38","5",0,19363,[0],"Тогда поддержим друг друга!"],["53702272986669473","37","5",0,19363,[0],"Вот как? Не знаю, по душе ли мне это"],["53702272550461857","36","5",0,19363,[0],"У нас вся семья в сборе!"],["53702272114254241","35","5",0,19363,[0],"Я знала! И у неё есть тёмная сторона!"],["53702271644492193","34","5",0,19363,[0],"Нам остается только раскрыть ей наш секрет!"],["53702271124398497","33","4",0,19363,[0],"Я никогда не забуду это лето!"],["53701019107877281","32","4",0,19363,[0],"Горы существуют чтобы их покорять"],["53701014544474529","31","4",0,19363,[0],"Мне судьбой определено делать то, что скажет отец!"],["53701013755945377","30","4",0,19363,[0],"Ты потерял хватку, да?"],["53701012262773153","29","4",0,19363,[0],"Это не меняет твоей ценности как человека!"],["53701011843342753","28","4",0,19363,[0],"Что значит \"любить\" кого-то?"],["53701011423912353","27","4",0,19363,[0],"Ты никогда при мне не улыбался..."],["53700070138208673","26","4",0,19363,[0],"Я не позволю так всему закончится!"],["53700069366456737","25","4",0,19363,[0],"Ты всё ещё моя сестрёнка, но..."],["53700068980580769","24","4",0,19363,[0],"Притворись, что ничего не произошло!"],["53700068561150369","23","3",0,19363,[0],"Не относись ко мне, как к младшей сестре"],["53699831733969313","22","3",0,19363,[0],"Решила сбежать из дома? Сделаем это правильно!"],["53699257550528929","21","3",0,19363,[1],"Но у него есть невеста! Это подло!"],["53698260816126369","20","3",0,19363,[1],"Я знала, что ты будешь не против со мной пойти"],["53698260598022561","19","3",0,19363,[1],"Течение зовёт меня!"],["53698260363141537","18","3",0,19363,[1],"Сколько человек тебе призналось в любви?!"],["53698259675275681","17","3",0,19363,[1],"Он просто возьмёт и поженится?"],["53698258349875617","16","3",0,19363,[1],"Подними голову и взгляни в лицо своим проблемам"],["53698257863336353","15","3",0,19363,[1],"Ты беспокоишься за них?"],["53697841335394721","14","2",0,19363,[1],"Может... Моя судьба изменится?"],["53697839959663009","13","2",0,19363,[1],"Я знала, что ты справишься с этим, Умино-кун"],["53697838483268001","12","2",0,19363,[1],"Ты ведь живёшь одна?"],["53697837963174305","11","2",0,19363,[1],"Ну разве вы не идеально подходите друг другу?"],["53697601471537569","10","2",0,19363,[1],"Мы можем быть вместе по утрам?."],["53697601001775521","9","2",0,19363,[1],"Мы можем быть вместе по утрам?.."],["53697600683008417","8","2",0,19363,[1],"Вы правда похожи"],["53697599374385569","7","2",0,19363,[1],"Спасибо за всё!"],["53697597965099425","6","2",0,19363,[1],"Ты будешь со мной встречаться?.."],["53697457774682529","5","1",0,19363,[1],"Ты совсем дурак?!"],["53697456969376161","4","1",0,19363,[1],"Я ни за что тебе не проиграю!!!"],["53697456449282465","3","1",0,19363,[1],"Мы даже смотреть не будем друг на друга"],["53697453362274721","2","1",0,19363,[1],"Я не собираюсь выходить за тебя"],["53697452305310113","1","1",0,19363,[1],"Стань моим парнем"],["53696176045711777","0","1",0,19363,[2]]],"w":{"n":["Обручённые","Сведённые кукушкой","Kakkou no Iinazuke","A Couple of Cuckoos","カッコウの許嫁","Cuckoo's Fiancee"],"t":"manga","p":7969,"s":["kakkou-no-iinazuke",215,"2025-11-08","53695392079962529/covers/4c48466a7f29055c93d5f1ca8e7feb84be11d218_53695438385078689.jpeg",1],"d":["kakkou-no-iinazuke",2025],"h":["kakkou_no_iinazuke","0026/81/2580433.jpg"],"l":[11,8,27,1,10,17,15,117],"st":"o"}}