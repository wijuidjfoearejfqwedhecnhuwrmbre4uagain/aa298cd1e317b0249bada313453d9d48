{"slug":"junkzero-s-twitter-comics","m":"175836435356601591","at":"2026-10-15","b":["175836435356667127"],"t":[["144548207517517363","Одноглазый с нейросетью"]],"c":[["227531277069207084","224","1",0,20562,[0],"Не смей пялится! (Динозавр Тина 8)"],["227577766717965868","223","1",0,20562,[0],"Захлопни варежку! (Хамелеон Камилла 18)"],["227577761701578284","222","1",0,20562,[0],"Просто закончи это. (Дуллахан Эния 12)"],["227577757289170476","221","1",0,20562,[0],"День дурака?.. (Робот Ева 15)"],["227577752927094316","220","1",0,20562,[0],"Как кошка. (Тигр Леона 3)"],["224049355588388379","219","1",0,20538,[0],"Как пёрышко. (Мимик 2)"],["223324556218091051","218","1",0,20533,[0],"Да или конечно? (Мимик 1)"],["222599778456847915","217","1",0,20528,[0],"Что она делает под столом? (Призрак Юки 7)"],["222567064529815083","216","1",0,20528,[0],"Невнимательный парень. (Гаргулья Терра 10)"],["222283193179457030","215","1",0,20526,[0],"У неё большое сердце! (Муравей 1)"],["221005273525929491","214","1",0,20517,[0],"Статическое электричество. (Тигр 2)"],["220425457235936787","213","1",0,20513,[0],"Вы арестованы! (Тигр 1)"],["219555847775208979","212","1",0,20507,[0],"Свободные руки. (Акула Мэг 14)"],["218975902166435347","211","1",0,20503,[0],"Кажется, ты не так поняла меня. (Гаргулья Терра 9)"],["218698078952113683","210","1",0,20501,[0],"Глянь сюда.  (Хамелеон Камилла 17)"],["218106172480177683","209","1",0,20497,[0],"Я соврал! (Косатка Кира 11)"],["217381455167243795","208","1",0,20492,[0],"Он мой. (Призрак 6)"],["217367310178993683","207","1",0,20492,[0],"Я сей!.. \\ Меня сейчас выжмут! (Альраун 1)"],["216789496602052115","206","1",0,20488,[0],"Судьбоносная встреча. \\ Спросим у плюшки.  (Они 1)"],["215502011989247514","205","1",0,20479,[0],"Встреча боссов подземелья. \\ Твоё тело говорит другое.  (Дуллахан Эния 12)"],["215193477997151770","204","1",0,20477,[0],"Перестал сопротивляться. \\ Кушай. (Сова Селена 13)"],["214483805753329178","203","1",0,20472,[0],"\"Двигаться\" и \"хватать\". \\ Начнём игру! (Робот Ева 14)"],["213887875803006490","202","1",0,20468,[0],"Безопасное место. \\ Это место подходит... (Кошка Эвелин 7)"],["213753494346155546","201","1",0,20467,[0],"Огромное давление. \\ Ч-что ты имеешь ввиду?.. (Собака Ану 12)"],["212876209141335578","200","1",0,20461,[0],"Она победила. (Собака Ану 11)"],["212311995863549466","199","1",0,20457,[0],"Должно быть, это судьба. (Гриб Аманита 6)"],["212313474607367706","198","1",0,20457,[0],"Кошмар перед Рождеством. (Дуллахан Эния 11)"],["211147316093011482","197","1",0,20449,[0],"Ну так новый год же. (Дуллахан Эния 10)"],["210695848542094874","196","1",0,20446,[0],"Я уже твоя. (Дуллахан Эния 9)"],["210419017582659098","195","1",0,20444,[0],"Время кушать! (Сова Селена 12)"],["209696757729216026","194","1",0,20439,[0],"Подзарядка! (Робот Ева 13)"],["209398799070676506","193","1",0,20437,[0],"Свет больше не включится. (Мышь Мята 4)"],["208531585329284616","192","1",0,20431,[0],"Двуногий волк. (Гоблин Габби 4)"],["208091179902846472","191","1",0,20428,[0],"Что этот парень выпил? (Гриб Аманита 5)"],["207233527714956819","190","1",0,20422,[0],"Проклятая кукла (Гриб Аманита 4)"],["207154108719711763","189","1",0,20422,[0],"Ей становится все труднее и труднее сдерживаться. (Акула Мэг 15)"],["207154176348669459","188","1",0,20422,[0],"Ничего страшного... Я только чуть-чуть...  (Акула Мэг 14)"],["207154120967079443","187","1",0,20422,[0],"Ты выглядишь как цундере. (Дуллахан Эния 8)"],["207154146468447763","186","1",0,20422,[0],"Потому что ты мне нравишься. (Дуллахан Эния 7)"],["207154127963178515","185","1",0,20422,[0],"Слушай меня! (Дуллахан Эния 6)"],["207154130697864723","184","1",0,20422,[0],"Звучит как-то пошло. (Гаргулья Терра 8)"],["207154122007266835","183","1",0,20422,[0],"Не копируй меня! (Гаргулья Терра 7)"],["207154120866416147","182","1",0,20422,[0],"Вакцинация. (Собака Ану 10)"],["207154106823886355","181","1",0,20422,[0],"Умная девочка. (Динозавр Тина 6)"],["207154113081787923","180","1",0,20422,[0],"Напарник по стае. (Динозавр Тина 5)"],["207233764407920147","179","1",0,20422,[0],"А ну, принеси! (Динозавр Тина 4)"],["207154168211719699","178","1",0,20422,[0],"Воу! Осторожно!.. Это мне. (Гриб 3)"],["207154121369732627","177","1",0,20422,[0],"Я таююю— (Скоро) (Гриб 2)"],["207154114172306963","176","1",0,20422,[0],"Грибное рагу. (Гриб 1)"],["207154156518000147","175","1",0,20422,[0],"Чувствую что-то на спине...  (Косатка Кира 10)"],["207154113283114515","174","1",0,20422,[0],"Особый солнцезащитный крем. (Слайм Джунипер 9)"],["207154127560525331","173","1",0,20422,[0],"Что я только что выпил?  (Слайм Джунипер 8)"],["207154103351002643","172","1",0,20422,[0],"Мы снаружи? (Хамелеон Камилла 16)"],["207154094542964243","171","1",0,20422,[0],"Тогда что это?.. (Робот Ева 12)"],["207154168815699475","170","1",0,20422,[0],"Хороший блок. (Робот Ева 11)"],["207154194350622227","169","1",0,20422,[0],"Двойная мощность. (Гоблин Габби 3)"],["207154184905049619","168","1",0,20422,[0],"Ты приняла меня за кого-то другого.  (Гоблин 2)"],["207154196565214739","167","1",0,20422,[0],"Я стану \"Убицей авантюристов\"! (Гоблин 1)"],["207154180157097491","166","1",0,20422,[0],"Взгляд хищника. (Акула Мэг 13)"],["207154193058776595","165","1",0,20422,[0],"Проснись! (Акула Мэг 12)"],["207154189988546067","164","1",0,20422,[0],"Хорошая девочка~ (Косатка Кира 9)"],["207154194400953875","163","1",0,20422,[0],"Они должны соответствовать моим стандартам! (Демон 2)"],["207154175157487123","162","1",0,20422,[0],"Твоя голова в порядке? (Гаргулья Терра 6)"],["207154150075549203","161","1",0,20422,[0],"Хм-м... (Гаргулья Терра 5)"],["207154148532045331","160","1",0,20422,[0],"Скажи сыр~ (Мышь Мята 3)"],["207154160913630739","159","1",0,20422,[0],"Моё тело не слушается меня! (Дуллахан Эния 4)"],["207154195038488083","158","1",0,20422,[0],"Признай это. (Дуллахан Эния 3)"],["207154186733766163","157","1",0,20422,[0],"Если ты так хочешь! (Собака Ану 9)"],["207154158363493907","156","1",