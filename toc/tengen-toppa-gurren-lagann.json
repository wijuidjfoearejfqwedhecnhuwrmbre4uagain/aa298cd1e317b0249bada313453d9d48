{"slug":"tengen-toppa-gurren-lagann","m":"245876312261019164","at":"2026-10-15","b":["245876312261084700"],"t":[["45241483413971349","Unnamed Manga"]],"c":[["245880136493188640","43","8",0,20689,[0],"И как всегда — планка до небес"],["245880089131107872","42","7",0,20689,[0],"Здесь мне спокойнее всего"],["245880026031998496","41","7",0,20689,[0],"Добро пожаловать в тюрьму"],["245879959963321888","40","7",0,20689,[0],"Мне за тебя страшно"],["245879903474435616","39","6",0,20689,[0],"Безликие"],["245879844200531488","38","6",0,20689,[0],"Моя мечта"],["245879785010513440","37","6",0,20689,[0],"Дорогой Камина"],["245879714160330272","36","6",0,20689,[0],"Навстречу завтрашнему дню"],["245879645793175072","35","6",0,20689,[0],"У нас нет шансов победить"],["245879583465817632","34","6",0,20689,[0],"Человек с силой спирали"],["245879516809938464","33","6",0,20689,[0],"То место посередине"],["245879455757649440","32","6",0,20689,[0],"Вращайся, вращайся!"],["245879384471258656","31","6",0,20689,[0],"Пожалуйста, ждите этого с нетерпением."],["245879316892632608","30","6",0,20689,[0],"Тебе никогда не понять"],["245879269111121440","29","6",0,20689,[0],"Это недопустимо!"],["245879230104094240","28","5",0,20689,[0],"Дайте мне ганмена"],["245879162642908704","27","5",0,20689,[0],"Ты точно хочешь, чтобы я это сделала?"],["245879101942941216","26","5",0,20689,[0],"Нет возможности слияния"],["245879083689330208","25","5",0,20689,[0],"Пожалуйста, пойдёмте с нами"],["245879072616367648","24","5",0,20689,[0],"Это конец твоего путешествия"],["245879057399432736","23","5",0,20689,[0],"Когда дело доходит до показа кожи"],["245878995072075296","22","5",0,20689,[0],"Кажется, он повзрослел, не так ли?"],["245878968513742368","21","4",0,20689,[0],"Я в долгу перед тобой"],["245878938834847264","20","4",0,20689,[0],"Я одолжу этот бур ненадолго"],["245878913501251104","19","4",0,20689,[0],"Все вы подохните самой ничтожной смертью!"],["245878886187943456","18","4",0,20689,[0],"В остальном полагаюсь на вас!"],["245878853791139360","17","4",0,20689,[0],"Ты не должен умирать!"],["245878825286649376","16","4",0,20689,[0],"Это не Гуррен-Дан..."],["245878796312397344","15","3",0,20689,[0],"Прощайте, братцы!.."],["245878754939782688","14","3",0,20689,[0],"Ты пришел в себя!?"],["245878729304196640","13","3",0,20689,[0],"Тварь! Где голова?!"],["245878696437630496","12","3",0,20689,[0],"Со спины ты абсолютно беззащитен"],["245878665919874592","11","3",0,20689,[0],"Я оставлю этот бой на тебя!"],["245878639294432800","10","2",0,20689,[0],"Мы не отступим, и не мечтай!"],["245878609296770592","9","2",0,20689,[0],"Всё скрытое должно быть открыто!"],["245878582067349024","8","2",0,20689,[0],"Место, что я зову домом"],["245878557186737696","7.5","2",0,20689,[0],"Бонус!"],["245878551197271584","7","2",0,20689,[0],"Ваша одежда неприлична!"],["245878524454389280","6","2",0,20689,[0],"Ни хрена ты не понимаешь!"],["245878497292076576","5","1",0,20689,[0],"Мне этого не понять!"],["245878468972135968","4","1",0,20689,[0],"Смерти нет!"],["245878444057970208","3","1",0,20689,[0],"Нам нужна сила духа!"],["245878422197257760","2","1",0,20689,[0],"Поверь в себя!"],["245878396612003360","1","1",0,20689,[0],"Пронзи своим буром небеса!"]]}