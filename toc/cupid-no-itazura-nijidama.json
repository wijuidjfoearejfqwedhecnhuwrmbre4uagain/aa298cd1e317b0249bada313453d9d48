{"slug":"cupid-no-itazura-nijidama","m":"36278305023877524","at":"2026-10-15","b":["36278305023943060"],"t":[["36240557764272525","Violent Manga Project"]],"c":[["36930263678214553","67","7",0,19247,[0],"Я такой..."],["36930263275561369","66","7",0,19247,[0],"Ты готова забеременеть?"],["36930262822576537","65","7",0,19247,[0],"Мы не можем?"],["36930262252151193","64","7",0,19247,[0],"А, доброе утро."],["36929770545504665","63","7",0,19247,[0],"Вперед Муттян!"],["36929710885724569","62","7",0,19247,[0],"Тебе и правда хочется знать?"],["36929710650843545","61","7",0,19247,[0],"Так что давай."],["36929710399185305","60","7",0,19247,[0],"Ты вообще слушаешь?"],["36929710147527065","59","7",0,19247,[0],"Так странно."],["36929521470955929","58","7",0,19247,[0],"Я не смогу это выдержать!"],["36929520195887513","57","6",0,19247,[0],"Говорила же."],["36929519172477337","56","6",0,19247,[0],"Люблю"],["36929518400725401","55","6",0,19247,[0],"Расстроен?"],["36929518098735513","54","6",0,19247,[0],"Это обрадует."],["36929516689449369","53","6",0,19247,[0],"Я хочу с тобой поговорить."],["36929515733148057","52","6",0,19247,[0],"Я больше не какой-то там сопляк!"],["36929515313717657","51","6",0,19247,[0],"И снова потерпеть неудачу?"],["36929514927841689","50","6",0,19247,[0],"Не хочешь?"],["36929513837322649","49","6",0,19247,[0],"Это ведь хорошо."],["36929512897798553","48","6",0,19247,[0],"Но я был даже рад."],["36929512058937753","47","5",0,19247,[0],"Что ты хочешь сказать?"],["36928863938306457","46","5",0,19247,[0],"Все идет своим чередом."],["36928863585984921","45","5",0,19247,[0],"Так завидно!"],["36928863283995033","44","5",0,19247,[0],"Мы уде встречались с тобой."],["36928862998782361","43","5",0,19247,[0],"Что у тебя с лицом?"],["36928862696792473","42","5",0,19247,[0],"Мне перестать?"],["36928862428357017","41","5",0,19247,[0],"В самый неподходящий момент..."],["36928862092812697","40","5",0,19247,[0],"Все потому, что она говорит это таким голосом."],["36928861421724057","39","5",0,19247,[0],"Это место..."],["36928861052625305","38","5",0,19247,[0],"А каким он был?.."],["36928860146655641","37.5","4",0,19247,[0],"Следующая история является экстра-главой."],["36928859358126489","37","4",0,19247,[0],"Аа, Куми-тян?"],["36928858989027737","36","4",0,19247,[0],"Рассказать бы кому-нибудь..."],["36928858015949209","35","4",0,19247,[0],"Жестокая девушка"],["36928857680404889","34","4",0,19247,[0],"Случайно."],["36928856053014937","33","4",0,19247,[0],"Не слишком воняет машинным маслом?"],["36928855683916185","32","4",0,19247,[0],"Хочу умереть..."],["36926901389910425","31","4",0,19247,[0],"Не доверяешь ты мне..."],["36926900769153433","30","4",0,19247,[0],"Беспокоится?.."],["36926900332945817","29","4",0,19247,[0],"Уже достаточно..."],["36926899762520473","28","3",0,19247,[0],"Я хочу это увидеть!"],["36926899292758425","27","3",0,19247,[0],"Это шутка!"],["36926898588115353","26","3",0,19247,[0],"Ты нервничаешь?"],["36926897497596313","25","3",0,19247,[0],"Давай отдам половину."],["36926896725844377","24","3",0,19247,[0],"Ты слишком застенчивый"],["36926895987646873","23","3",0,19247,[0],"Это было один раз, когда я была в шестом классе младшей школы"],["36926895534662041","22","3",0,19247,[0],"Мы не сильно задержимся?.."],["36926894477697433","21","3",0,19247,[0],"Слабак."],["36926893924049305","20","3",0,19247,[0],"Я знаю."],["36926893403955609","19","3",0,19247,[0],"Я училась в школе для девочек..."],["36926892900639129","18","2",0,19247,[0],"Кто это? Ты знаешь ее?"],["36925952940335513","17","2",0,19247,[0],"Ты наконец-то завел девушку?"],["36925930525974937","16","2",0,19247,[0],"Теперь я спокойна."],["36925592330854809","15","2",0,19247,[0],"Хороший цвет."],["36925591324221849","14","2",0,19247,[0],"Не шали там!"],["36925590955123097","13","2",0,19247,[0],"Тебе хорошо?"],["36925590552469913","12","2",0,19247,[0],"Польсти мне еще..."],["36925590166593945","11","2",0,19247,[0],"А у тебя хорошая память..."],["36925589394842009","10","2",0,19247,[0],"Ты в порядке?"],["36925588992188825","9","2",0,19247,[0],"Нужно побыстрее тебя вытереть!"],["36925578204438937","8","1",0,19247,[0],"У тебя слишком тихий голос..."],["36923162805428633","7","1",0,19247,[0],"До меня просто еще не дошло..."],["36923160993489305","6","1",0,19247,[0],"Я просто не могу этого сделать!"],["36923159131218329","5","1",0,19247,[0],"Вы видели меня там, внизу."],["36923157319279001","4","1",0,19247,[0],"Та самая девушка, да?"],["36923155238904217","3","1",0,19247,[0],"Я могу съесть много."],["36923048871354777","2","1",0,19247,[0],"Все нормально, но..."],["36922979849888153","1","1",0,19247,[0],"Все еще нет?"]]}