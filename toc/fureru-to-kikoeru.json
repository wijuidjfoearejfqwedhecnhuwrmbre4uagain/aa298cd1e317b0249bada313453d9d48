{"slug":"fureru-to-kikoeru","m":"36152692128637368","at":"2026-10-15","b":["36152692128702904"],"t":[["36087100008849847","Onibaku Manga Team"]],"c":[["36177944036532664","37","4",0,19242,[0],"Коснись и слушай"],["36177926202352056","36","4",0,19242,[0],"Сатори"],["36177713165263288","35","4",0,19242,[0],"Я всегда любил тебя"],["36177700381024696","34","4",0,19242,[0],"То, что было сказано, и то, что осталось невысказанным"],["36177672732172728","33","4",0,19242,[0],"Кое-что важное"],["36177626611605944","32","4",0,19242,[0],"Значит, это правда..."],["36177613441491384","31","4",0,19242,[0],"Из-за Сатори..."],["36177484072378808","30","4",0,19242,[0],"Надежда преодолеть всё"],["36177471405580728","29","4",0,19242,[0],"Последствия..."],["36177461507023288","28","4",0,19242,[0],"Доверие и ревность"],["36177114856186296","27","3",0,19242,[0],"Ты для меня"],["36176893497598392","26","3",0,19242,[0],"Возможно"],["36176825482764728","25","3",0,19242,[0],"Говоря о проблемах"],["36176768993878456","24","3",0,19242,[0],"Совсем как ты"],["36176728275575224","23","3",0,19242,[0],"Ты волнуешься за меня?"],["36176698848338360","22","3",0,19242,[0],"Свидание с Сатори"],["36176606355546552","21","3",0,19242,[0],"Всегда скрыт"],["36176573019218360","20","3",0,19242,[0],"Горечь"],["36176533022335416","19","3",0,19242,[0],"Я думал, прошло уже достаточно времени"],["36176499669230008","18","3",0,19242,[0],"Всё обязательно станет как раньше"],["36176376105034168","17","2",0,19242,[0],"Поиграй со мной в баскетбол!"],["36176359344595384","16","2",0,19242,[0],"У меня проблема с Такуми!"],["36176314683646392","15","2",0,19242,[0],"Ты была с Со?"],["36176304097223096","14","2",0,19242,[0],"Хочу, чтобы все прошло хорошо"],["36176293527577016","13","2",0,19242,[0],"Это снова со мной..."],["36176224573219256","12","2",0,19242,[0],"Популярный парень и его друзья"],["36176212644618680","11","2",0,19242,[0],"И ты, и я!"],["36176194609111480","10","2",0,19242,[0],"Тайком касаясь"],["36176178737865