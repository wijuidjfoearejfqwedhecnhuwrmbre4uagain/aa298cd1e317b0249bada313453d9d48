{"slug":"the-seductive-wife","m":"197226844691383813","at":"2026-10-15","b":["197226844691449349"],"t":[["45241483413971349","Unnamed Manga"]],"c":[["224775652593649196","50","1",0,20543,[0],"Так близко и так далеко. Спин-офф"],["223712658891753003","49","1",0,20536,[0],"Слишком долгое молчание вызывает беспокойство. Спин-офф"],["223712650234709547","48","1",0,20536,[0],"Сила первой любви"],["222296311402087942","47","1",0,20526,[0],"Ужасно сексуальный, когда злишься"],["222299299189376518","46","1",0,20526,[0],"Мой муж стал знаменитостью"],["220266932174079507","45","1",0,20512,[0],"Единственный и самый любимый ребёнок"],["219252241586996755","44","1",0,20505,[0],"Потому что люблю тебя"],["218237064242546195","43","1",0,20498,[0],"Желаю тебе спокойной ночи"],["217222382094403091","42","1",0,20491,[0],"Глоток свежего воздуха"],["217228811308123667","41","1",0,20491,[0],"Всё ради тебя"],["215183426632828442","40","1",0,20477,[0],"Лицемерное заявление"],["214174321348724250","39","1",0,20470,[0],"Ненавижу эту чудовищную часть себя"],["213063041510557210","38","1",0,20462,[0],"Любовь"],["213060456661665306","37","1",0,20462,[0],"Поставлю всё на кон"],["202181768793572906","36","1",0,20387,[0],"Лучик солнца в моменты отчаяния"],["200586354386552347","35","1",0,20376,[0],"Причина была в этом?"],["198234340889478679","34","1",0,20360,[0],"Она – та самая..."],["197227114603234839","33","1",0,20353,[0],"Как сделать так, чтобы друг другу было лучше"],["197227126498280983","32","1",0,20353,[0],"Монстр"],["197227027797919255","31","1",0,20353,[0],"Я не дам тебя в обиду"],["197227035465106967","30","1",0,20353,[0],"Как мне завладеть тобой полностью?"],["197227034844349975","29","1",0,20353,[0],"Если я что-то задумал, то не отступлю"],["197227022244660759","28","1",0,20353,[0],"В поисках нашего счастья"],["197227035817428503","27","1",0,20353,[0],"Закон един для всех"],["197227035112785431","26","1",0,20353,[0],"Пора уходить"],["197227007212275223","25","1",0,20353,[0],"Он ещё узнает, кто здесь главный"],["197227028016023063","24","1",0,20353,[0],"Во имя любви?"],["197227024543139351","23","1",0,20353,[0],"С этого дня ты для меня – пустое место"],["197227036941501975","22","1",0,20353,[0],"Ты украла моё сердце, И Чжэ"],["197227032965301783","21","1",0,20353,[0],"Неужто ревнуете, сэр?"],["197227019090544151","20","1",0,20353,[0],"Если бы я носила твоего ребёнка"],["197227025952425495","19","1",0,20353,[0],"Это ведь ты использовала меня"],["197226993136190999","18","1",0,20353,[0],"Ну же, доставь мне удовольствие"],["197227010987148823","17","1",0,20353,[0],"«Впервые ты честна со мной»"],["197226971594245655","16","1",0,20353,[0],"«Я бы хотела задержаться друг у друга как можно дольше»"],["197227005920429591","15","1",0,20353,[0],"«Полагаю, ты только сейчас об этом задумалась»"],["197227012564207127","14","1",0,20353,[0],"«Непослушная девочка И Чжэ.»"],["197227001659016727","13","1",0,20353,[0],"«Как я могу утешить тебя?»"],["197227105023444503","12","1",0,20353,[0],"«Я создам для тебя новый мир, в котором ты будешь жить»"],["197227021103810071","11","1",0,20353,[0],"«Это их вина, не твоя»"],["197227011272427031","10","1",0,20353,[0],"«Перечисли мне все свои страховые выплаты»"],["197227000702715415","9","1",0,20353,[0],"Зачем закрываешь глаза?"],["197227400319223319","8","1",0,20353,[0],"Мне станет легче, если ты будешь рядом"],["197227399815906839","7","1",0,20353,[0],"Ты всегда была инициатором событий"],["197227126330508823","6","1",0,20353,[0],"Я бы поддался своему влечению"],["197227001222809111","5","1",0,20353,[0],"Твой соблазнительный взгляд"],["197227009259095575","4","1",0,20353,[0],"Меня назначили личным секретарём Ю Хёна?"],["197226944901694999","3","1",0,20353,[0],"Не нужно жить со мной из жалости"],["197227009376536087","2","1",0,20353,[0],"Волшебная ночь"],["197227007883363863","1","1",0,20353,[0],"Чертовски привлекательная жена"]]}