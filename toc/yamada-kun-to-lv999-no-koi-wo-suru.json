6069030333","73","7",0,19502,[4]],["73904919903494589","72","7",0,19502,[4]],["73034849119658397","71","7",0,19496,[1],"Задержись чутка"],["73034748506694045","70","7",0,19496,[1],"Переезжаете?"],["66224876599402914","69","7",0,19449,[1],"Эта ночь только для нас."],["66224875206893986","68","7",0,19449,[1],"Хочешь яблоко?"],["66224873260736930","67","7",0,19449,[1],"Как насчет сегодня вечером?"],["66224872220549538","66","7",0,19449,[1],"Путь кровавой бойни."],["66224871163584930","65","7",0,19449,[1],"Время наказания"],["66224869754298786","64","7",0,19449,[1],"Думаю, мне просто любопытно."],["66224101777236386","63","7",0,19449,[1],"Я учусь каждый день"],["66224100888043938","62","6",0,19449,[1],"Заткнись"],["66224099579421090","61","6",0,19449,[1],"Может тебе больше спать?"],["62194332202983817","60","6",0,19422,[1],"Передай своей сестренке - Удачи"],["62194238015693193","59","6",0,19422,[1],"Так было всегда"],["62194198035587465","58","6",0,19422,[1],"Если я прекращу это..."],["62194197683265929","57","6",0,19422,[1],"Не говори о таком так небрежно!"],["62194196961845641","56","6",0,19422,[1],"В этом нет ничего такого"],["62194100476076425","55","6",0,19422,[1],"Но мы все еще друзья"],["62194099754656137","54","6",0,19422,[1],"Мы..."],["62194099402334601","53","6",0,19422,[1],"Итак, она и я..."],["62194099033235849","52","6",0,19422,[1],"Хотел бы я поцеловать девушку"],["62194098680914313","51","6",0,19422,[1],"Ты даже представить себе не можешь"],["62194098311815561","50","5",0,19422,[1],"Тебе лучше его бросить"],["62194097959494025","49","5",0,19422,[1],"Я уйду через 10 минут"],["62194097590395273","48","5",0,19422,[1],"Человек с противоположного экрана"],["62194097204519305","47","5",0,19422,[1],"Он даже не прочитал..."],["62194096835420553","46","5",0,19422,[1],"Зная Эйту-Куна, я была уверена..."],["62194096466321801","45","5",0,19422,[1],"Кто эта девушка!?"],["62194096080445833","44","5",0,19422,[1],"Я совсем не понимаю девушек"],["62194095711347081","43","5",0,19422,[1],"В некотором роде, это было ложью"],["62194095342248329","42","5",0,19422,[1],"Я твой друг"],["62194094956372361","41","5",0,19422,[1],"Ты издеваешься надо мной..."],["62194094570496393","40","4",0,19422,[1],"Утром, когда проснешься"],["62194090795622793","39","4",0,19422,[1],"Остальное мы оставим на тебя, Ямада-сан"],["62194090443301257","38","4",0,19422,[1],"Даже если никто не заметит"],["62194090090979721","37","4",0,19422,[1],"Ты можешь доверять мне"],["62194089738658185","36","4",0,19422,[1],"Поделишься со мной?"],["62194089386336649","35","4",0,19422,[1],"Это как-то не честно..."],["62194089017237897","34","4",0,19422,[1],"Я люблю тебя!"],["62194088664916361","33","4",0,19422,[1],"Лучше любых групповых свиданий"],["62194088279040393","32","4",0,19422,[1],"Это нам ничего не даст"],["62194087909941641","31","4",0,19422,[1],"Паладин 55-го Уровня"],["62194087540842889","30","3",0,19422,[1],"Разве так не лучше?"],["62194087121412489","29","3",0,19422,[1],"Давай поговорим о прошлом"],["62194086752313737","28","3",0,19422,[1],"Прости меня, Ямада"],["62194086366437769","27","3",0,19422,[1],"Неужели других не нашлось?!"],["62194085997339017","26","3",0,19422,[1],"Не хочу, не буду!!"],["62194085594685833","25","3",0,19422,[1],"Это мерзкая ловушка!"],["62194085208809865","24","3",0,19422,[1],"Если подумать, для меня это было..."],["62194084822933897","23","3",0,19422,[1],"Как насчет того, чтобы встречаться друг с другом?"],["62194084420280713","22","3",0,19422,[1],"Почему ты смеёшься?"],["62194084034404745","21","3",0,19422,[1],"Не используйте схемы в качестве оправдания"],["62194083614974345","20","3",0,19422,[1],"Ты хочешь освободиться?"],["62191513278374281","19","2",0,19422,[0],"Будет лучше, если я не буду подходить слишком близко"],["62191512926052745","18","2",0,19422,[0],"Я думаю, что я сделала что-то очень плохое"],["62190596051198345","17","2",0,19422,[3],"Я хочу, чтобы эта любовная история началась"],["62190595715654025","16","2",0,19422,[3],"На самом деле я не много знаю о компьютерах"],["62190595363332489","15","2",0,19422,[3],"Вы пострадали?"],["62190595027788169","14","2",0,19422,[3],"Не могли бы вы рассказать мне об этом подробнее?"],["62190594675466633","13","2",0,19422,[3],"У меня нет планов"],["62190277569307017","12","2",0,19422,[3],"Подождите здесь десять минут!"],["62190202575151497","11","2",0,19422,[3],"Почему сейчас?"],["62190202206052745","10","2",0,19422,[3],"Вам нравится Ямада-сан?"],["62190201870508425","9","1",0,19422,[3],"Ты же принцесса Рури-тян, верно?"],["62190201518186889","8","1",0,19422,[3],"Я хочу пойти на оффлайн встречу"],["62190201165865353","7","1",0,19422,[3],"Может быть так оно и есть"],["62190200779989385","6","1",0,19422,[3],"Беспокоясь о тебе"],["62189217987453321","5","1",0,19422,[0],"Настало время для босса"],["62189064073273737","4","1",0,19422,[2],"Пожалуйста, выбирай с умом"],["62189063720952201","3","1",0,19422,[2],"Только не говори, что мы провели эту ночь вместе"],["62189063351853449","2","1",0,19422,[2],"Разве Ямада не излишне холоден?"],["62189062965977481","1","1",0,19422,[2],"Вот что я ненавижу в геймерах!!"]],"mb":{"s":"moya-lyubov-999-urovnya-k-yamada-kunu","mode":"merge","f":["c85059f7ca71ddba","94126bc21ee9da67","e8ad3b754d4fae53"],"c":[["1","1",30,0],["1","2",29,0],["1","3",17,0],["1","4",12,0],["1","5",19,0],["1","6",18,0],["1","7",18,0],["1","8",17,0],["1","9",17,0],["1","10",17,0],["1","11",19,0],["1","12",20,0],["1","13",15,0],["1","14",17,0],["1","15",22,0],["1","16",17,0],["1","17",15,0],["1","18",13,0],["1","19",15,0],["1","20",17,0],["1","21",15,0],["1","22",15,0],["1","23",18,0],["1","24",18,0],["1","25",16,0],["1","26",16,0],["1","27",16,0],["1","28",18,0],["1","29",16,0],["1","30",17,0],["1","31",18,0],["1","32",17,0],["1","33",17,0],["1","34",18,0],["1","35",17,0],["1","36",20,0],["1","37",20,0],["1","38",22,0],["1","39",20,0],["1","40",24,0],["1","41",19,0],["1","42",16,0],["1","43",16,0],["1","44",16,0],["1","45",17,0],["1","46",13,0],["1","