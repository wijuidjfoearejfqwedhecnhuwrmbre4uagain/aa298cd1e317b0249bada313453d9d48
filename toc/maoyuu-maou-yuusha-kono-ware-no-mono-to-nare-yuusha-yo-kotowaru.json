{"slug":"maoyuu-maou-yuusha-kono-ware-no-mono-to-nare-yuusha-yo-kotowaru","m":"97226496740975019","at":"2026-10-15","b":["97226496741040555"],"t":[["41411034950427061","Dark Phoenix"],["54909023874474374","Chudo"],["86275694258053561","Dzesukuru Kamui"],["97226751737881003","Маленькое сокровище"],["97228346965909931","KeyZ"],["97236697472852395","ifrit team"],["97237754991108518","Lexcorp"]],"c":[["97241284867088806","58","18",0,19663,[0,4],"Другая сторона холма"],["97241139240853926","57","18",0,19663,[0,4],"Всё это время... Я... была... счастлива"],["97240971888124326","56","18",0,19663,[0,4],"Вы - моё подкрепление"],["97240876593471910","55","17",0,19663,[0,4]],["97240714710180262","54","17",0,19663,[0,4],"Лучший во всем мире - это вовсе не редкость"],["97240546568855974","53","17",0,19663,[0,4],"Таково было желание девушки"],["97240478554087846","52","16",0,19663,[0,4],"В городе Врат ждет \"конец\""],["97240068971848102","51","16",0,19663,[4],"Это то, чего хочет Дух!"],["97239893549343142","50","16",0,19663,[4],"Есть только один ответ: Мир"],["97239765874729382","49","15",0,19663,[4],"Имей надежду в твоей истории, которая когда-нибудь начнется"],["97239629710844326","48","15",0,19663,[4],"Ради завтрашнего дня!"],["97239497053397414","47","15",0,19663,[4],"Сейчас, Я сам определяю кто Я есть"],["97238895892193702","46","14",0,19663,[0],"Во имя тех, кто не вернется"],["97238657437622694","45","14",0,19663,[6],"Это.. сплошная атака"],["97238540231991718","44","14",0,19663,[6],"\"Шар света\""],["97238387626369446","43","13",0,19663,[6],"Этот город... очень важен для меня"],["97238033073529254","42","13",0,19663,[6],"Всегда есть ответ (но он необязательно один и тот же для всех)"],["97237965780050342","41","13",0,19663,[6],"Я люблю героя потому-что мне нужна его помощь"],["97237711554896294","40","12",0,19663,[5],"Мы не можем проиграть после всего, что было"],["97237576095654315","39","12",0,19663,[5],"Ты должна спасти всех на своем пути"],["97237452346974635","38","12",0,19663,[5],"Мушкеты"],["97237054710178219","37","11",0,19663,[5],"Почему это здесь?"],["97236570318332331","36","11",0,19663,[1],"Я хочу видеть за горизонтом..."],["97236448113156523","35","11",0,19663,[1],"Старая легенда"],["97235819269546411","34","10",0,19663,[1],"Люди были окружены миром со своего рождения"],["97235698188378539","33","10",0,19663,[1],"Путь"],["97235606836437419","32","10",0,19663,[1],"Путь ведущий в будущее"],["97235412019405227","31","9",0,19663,[1],"Мы багряные ученики"],["97235327814558123","30","9",0,19663,[1],"Королева Демонов это Настоящий Герой"],["97231714740429227","29","9",0,19663,[2],"Меченый король Лазурных демонов"],["97231292139135403","28","8",0,19663,[2],"К"],["97231213974020523","27","8",0,19663,[2],"Пусть это будет наш первый удар"],["97231125759484331","26","8",0,19663,[2],"Курултай - великий слет кланов"],["97231047527260587","25","7",0,19663,[2],"Эра, которую мы ищем"],["97230807579582891","24","7",0,19663,[2],"Я действительно люблю этот мир!"],["97230682673209771","23","7",0,19663,[2],"Есть время для войны, и есть время для мира"],["97230397745750443","22","6",0,19663,[3],"Извини, что заставила ждать, мой Герой"],["97230297300492715","21","6",0,19663,[3],"\"Спасибо\", - вот что они мне сказали"],["97230132380459435","20","6",0,19663,[3],"За нашу Родину!"],["97230025744540075","19","5",0,19663,[3],"Потому что я торговец"],["97229921054712235","18","5",0,19663,[3],"Герой...В тебе нуждаются"],["97229814754271659","17","5",0,19663,[3],"И навлекли войну люди неразумные"],["97229706155352491","16","4",0,19663,[3],"Чего стоит золотая монета?"],["97229589402640811","15","4",0,19663,[3],"Новая основа"],["97229514341376427","14","4",0,19663,[3],"Потому что я человек!"],["97228792182890923","13","4",0,19663,[3],"Не желаю больше оставаться позади!"],["97228572468470187","12","3",0,19663,[3],"Нечто не делимое на прибыли и убытки"],["97228465362788779","11","3",0,19663,[3],"Что скажете, мой господин?"],["97228381040435627","10","3",0,19663,[3],"С возвращением, Герой!"],["97228298127434155","9","3",0,19663,[3],"Таков мой дом!"],["97228210214822315","8","2",0,19663,[3],"Мы начнем вторую компанию по отвоеванию острова Авроры - высодка!"],["97228117386551723","7","2",0,19663,[3],"Мир полон вещей мне неведомых"],["97228030010745259","6","2",0,19663,[3],"Выбор из двух путей"],["97227943624860075","5","2",0,19663,[3],"Я Темный рыцарь"],["97227863329104299","4","1",0,19663,[3],"Где тебя черти носили все это время?!"],["97227782681092523","3","1",0,19663,[3],"На пустое брюхо всякая ноша тяжела"],["97227708777456043","2","1",0,19663,[3],"Сделайте нас людьми"],["97227628313862571","1","1",0,19663,[3],"Стань моим, герой!"]],"w":{"n":["Королева демонов и Герой: «Стань моим, Герой» — «Я отказываюсь!»","Герой при заклятом враге","Maoyuu Maou Yuusha: 'Kono Ware no Mono to Nare, Yuusha yo' 'Kotowaru!'","Archenemy and Hero - \"Be mine, Hero\" \"I refuse!\"","MAOYU: Archenemy and Hero \"Become mine, Hero\" \"I refuse!\"","まおゆう魔王勇者 「この我のものとなれ、勇者よ」「断る!」","Maoyuu Maou Yuusha - 'Be mine","Maoyu Maou Yusha","Level Hero!","Hero' 'I refuse!'","まおゆう魔王勇者 / Maoyuu Maou Yuusha - Kono Watashi no Mono Tonare, Yuusha yo Kotowaru/Maoyuu Maou Yuusha - Kono Watashi no Mono Tonare, Yuusha yo Kotowaru!/Maoyuu: Maou Yuusha - \"Be mine, Hero\" \"I refuse!\"/Maoyuu: Maou Yuusha - \"Kono Watashi no Mono to Nare, Yu","archenemy and hero"],"t":"manga","p":5892,"s":["maoyuu-maou-yuusha-kono-ware-no-mono-to-nare-yuusha-yo-kotowaru",58,"2023-11-02","97226496740975019/covers/3d69246bd9db97289360f936415f13e656cfa707_97227977716162987.jpeg",1],"d":["maoyuu-maou-yuusha-kono-ware-no-mono-to-nare-yuusha-yo-kotowaru",1304],"h":["archenemy_and_hero",""],"l":[0,24,1,8,25,136],"st":"f"}}