{"slug":"yankee-kun-to-megane-chan","m":"39843031947436424","at":"2026-10-15","b":["39843031947501960"],"t":[["39804024769241531","Rikudou-Sennin Clan"],["42071566812471742","Manga Gears"]],"c":[["42072507896848830","211.5","23",0,19283,[1],"Экстра Эпилог"],["42072276455154110","211","23",0,19283,[0],"Снова вместе."],["42072275331080638","210","23",0,19283,[0],"А что же Адачи-сан?!"],["42072274492219838","209","23",0,19283,[0],"Это всё она."],["42072011006042558","208","23",0,19283,[0],"Ну что, идём?"],["42072010284622270","207","23",0,19283,[0],"Вот оно."],["42072009361875390","206","23",0,19283,[0],"Строительная фирма Вакаяма."],["42072008523014590","205","23",0,19283,[0],"Я принимаю вызов!!!"],["42071566074274238","204","23",0,19283,[0],"Кажется, тебя ждет веселая студенческая жизнь."],["42071565436740030","203","23",0,19283,[0],"10087"],["42071148908798398","202","22",0,19283,[0],"Я собирался сделать так с самого начала"],["42071148120269246","201","22",0,19283,[0],"Горилла"],["42071146660651454","200","22",0,19283,[0],"У тебя всё получится!!"],["42070806720700862","199","22",0,19283,[0],"Именно поэтому"],["42070805764399550","198","22",0,19283,[0],"Вот поэтому-то я и не перевариваю парней!!"],["42070804791321022","197","22",0,19283,[0],"Удачи на вступительном экзамене"],["42069947257479614","196","22",0,19283,[0],"Вместе навсегда"],["42069946603168190","195","22",0,19283,[0],"Мы все по-любому поступим в Тоно-У!"],["42069945915302334","194","22",0,19283,[0],"Это уже и табличкой сложно назвать"],["42069945227436478","193","21",0,19283,[0],"Не ищите меня"],["42069944522793406","192","21",0,19283,[0],"Невозможно, невозможно"],["42069943818150334","191","21",0,19283,[0],"Я дарю надежду!"],["42069943079952830","190","21",0,19283,[0],"Только что ты так просто взбесилась"],["42069942727631294","189","21",0,19283,[0],"Кто же так шутит?!"],["42069941972656574","188","21",0,19283,[0],"Вот это сиськи!!!"],["42069941184127422","187","21",0,19283,[0],"Ты знаешь их?"],["42069084858245566","186","21",0,19283,[0],"Вы кто такие?"],["42069084354929086","185","21",0,19283,[0],"Презренный"],["42068513761812926","184.5","20",0,19283,[0],"Экстра. Урод повержен!"],["42068513124278718","184","20",0,19283,[0],"Если я пойду в университет."],["42068512469967294","183","20",0,19283,[0],"Само собой, ты её вернёш"],["42068511782101438","182","20",0,19283,[0],"Учёба в Тоно-У под девизом Отчаяние"],["42068511094235582","181","20",0,19283,[0],"Это нехорошо!"],["42068507621351870","180","20",0,19283,[0],"Потому что нет стимула"],["42068506715382206","179","20",0,19283,[0],"Отель Одзия"],["42068505574531518","178","20",0,19283,[0],"Ооох... Мммгм... Ооох"],["42067912080515518","177","20",0,19283,[0],"Элегантно и прелестно!"],["42067911006773694","176","19",0,19283,[0],"Неплохое число!"],["42067910335685054","175","19",0,19283,[0],"На сегодня занятия окончены"],["42067909345829310","174","19",0,19283,[0],"Я хочу стать нормальной девушкой!"],["42067903809348030","173","19",0,19283,[0],"Мы самые крутые на районе!"],["42067903490580926","172","19",0,19283,[0],"Ты живешь в этих кустах?"],["42067902836269502","171","19",0,19283,[0],"Я просто жалок!"],["42067902165180862","170","19",0,19283,[0],"Ты всегда был рядом"],["42067901326320062","169","19",0,19283,[0],"Что она творит? Идиотка!"],["42067900973998526","168","19",0,19283,[0],"Это вывод!"],["42067900252578238","167","19",0,19283,[0],"Твои настоящие чувства?"],["42067899514380734","166","18",0,19283,[0],"Прекрати меня так называть"],["42067898390307262","165","18",0,19283,[0],"Сверхнаука"],["42067897618555326","164","18",0,19283,[0],"Это вопрос жизни и смерти"],["42067891914301886","163","18",0,19283,[0],"Она реально странная"],["42067891276767678","162","18",0,19283,[0],"Это Шинагава Дайчи из класса 3-А!"],["42067890941223358","161","18",0,19283,[0],"Он не проклят."],["42067889901035966","160","18",0,19283,[0],"Это что, сталкер?"],["42067889582268862","159","18",0,19283,[0],"Как будто в зеркало смотришь, правда?"],["42067888223314366","158","18",0,19283,[0],"Престижный университет - не мечта!"],["42065771945288126","157","17",0,19283,[0],"Таро Узушио."],["42065771626521022","156","17",0,19283,[0],"Возможно, когда-нибудь я попаду туда!"],["42065771290976702","155","17",0,19283,[0],"Реальность очень жестока."],["42065770955432382","154","17",0,19283,[0],"Туалет общественный."],["42065770603110846","153","17",0,19283,[0],"Отлично!"],["42065770267566526","152","17",0,19283,[0],"Ох, ты еще и подхалим..."],["42065769898467774","151","17",0,19283,[0],"Это алтарь."],["42065769529369022","150","17",0,19283,[0],"Сколько же у тебя свободного времени?!"],["42064982426280382","149","17",0,19283,[0],"Вторжение любви Армагеддон."],["42064981805523390","148","17",0,19283,[0],"Этого не случится!!!"],["42064975027528126","147","16",0,19283,[0],"Пойдем домой!"],["42064974708761022","146","16",0,19283,[0],"А теперь, давайте расстегнем эти пуговицы!"],["42064974088004030","145","16",0,19283,[0],"Так они взаправду бывают!"],["42064973366583742","144","16",0,19283,[0],"Разве это не странно?"],["42064972678717886","143","16",0,19283,[0],"Дом Шинагавы"],["42064971655307710","142","16",0,19283,[0],"Мы шесть невидимок"],["42064970933887422","141","16",0,19283,[0],"В...в-в-вы неправильно меня поняли!!!"],["42064970212467134","140","16",0,19283,[0],"Такое миленькое место"],["42064969423937982","139","16",0,19283,[0],"Больше не существует!"],["42064192856940990","138","16",0,19283,[0],"Ей ничего сказать таким мудакам, как вы!"],["42064191128887742","137","15",0,19283,[0],"Он заболел, или чё?"],["42064190457799102","136","15",0,19283,[0],"Чем быстрее, тем лучше, верно?"],["42064189434388926","135","15",0,19283,[0],"Это революция!"],["42064167523344830","134","15",0,19283,[0],"Насколько крепка твоя голова?"],["42064161517101502","133","15",0,19283,[0],"Та, что тебе нравится…"],["42064152155414974","132","15",0,19283,[0],"Эй! Заждался?"],["42064151400440254","131","15",0,19283,[0],"Миска призрачного риса."],["42064140193259966","130","15",0,19283,[0],"Почему она носит гроб?!"],["42064139186627006","129","15",0,19283,[0],"Они сказали это хором?!"],["42064138381320638","128","15",0,19283,[0],"Ты всех отпугнешь!"],["42062629019083198","127.5","14",0,19283,[0],"Хулиганка и Очкастый"],["42062628666761662","127","14",0,19283,[0],"Мне не нужна замена"],["42062628297662910","126","14",0,19283,[0],"Это... полный отстой!"],["42061815340884414","125","14",0,19283,[0],"Может мне уже начать звать тебя Дайчи, а?"],["42061814434914750","124","14",0,19283,[0],"Что ещё за раз-дв ?"],["42061813445059006","123","14",0,19283,[0],"Как же это ты на них сейчас смотришь?"],["42061813109514686","122","14",0,19283,[0],"Вы должны внимательно следить за моими действиями, чтобы разобраться во всем!"],["42061812723638718","121","14",0,19283,[0],"И! Раз!"],["42061812069327294","120","14",0,19283,[0],"Одним махом!"],["42061811029139902","119","13",0,19283,[0],"Вовсе не плохо!"],["42061804754461118","118","13",0,19283,[0],"У меня спина болит"],["42061804116926910","117","13",0,19283,[0],"К нам приближаются волны!"],["42061803496169918","116","13",0,19283,[0],"Это прокляааатиеее..."],["42061801902334398","115","13",0,19283,[0],"Я стану ветром"],["42061800862147006","114","13",0,19283,[0],"И то, и другое не годится"],["42061799838736830","113","13",0,19283,[0],"Кто же тебе нравится?"],["42061799134093758","112","13",0,19283,[0],"Ты тоже играешь в видеоигры"],["42061798412673470","111","13",0,19283,[0],"Спасибо за ваш нелёгкий труд в этом году!"],["42061788379898302","110","13",0,19283,[0],"Вы можете приходить ко мне"],["42060292523319742","109.5","12",0,19283,[0],"Экстра"],["42060291231474110","109","12",0,19283,[0],"У меня это тоже получилось!"],["42060284906463678","108","12",0,19283,[0],"Хорош уже хрустеть"],["42060284302483902","107","12",0,19283,[0],"Экономьте воду любыми способами!"],["42060283312628158","106","12",0,19283,[0],"Её здание отсюда прекрасно видно!"],["42060282289217982","105","12",0,19283,[0],"Обмануты"],["42060281584574910","104","12",0,19283,[0],"Это тот засранец!"],["42060280510833086","103","12",0,19283,[0],"Ничего странного? А Адачи в зеркало смотрелась?!"],["42060279789412798","102","12",0,19283,[0],"Но я сильнее"],["42060278648562110","101","12",0,19283,[0],"Не мешай, отмороженный!"],["42059452605555134","100","11",0,19283,[0],"Ммм~ Поймал ♥"],["42059450609066430","99","11",0,19283,[0],"Если ты собрался на свидание, то почему не пригласил меня?"],["42059449585656254","98","11",0,19283,[0],"Вы-ы-ы ку-у-уда-а-ато-о со-о-обра-али-ись?"],["42059448495137214","97","11",0,19283,[0],"Что же нам делать?"],["42059448126038462","96","11",0,19283,[0],"Не дай бог, кондратий хватит"],["42059447756939710","95","11",0,19283,[0],"Шинигава-кун дымится"],["42059447387840958","94","11",0,19283,[0],"Тоже мне, Тара-чан"],["42059447018742206","93","11",0,19283,[0],"Твои пять копеек как всегда ни к месту"],["42059446666420670","92","11",0,19283,[0],"В те дни я был своего рода идолом"],["42059440509182398","91","10",0,19283,[0],"Я впервые наблюдаю это со стороны!"],["42059440173638078","90","10",0,19283,[0],"Нам просто некуда больше идти"],["42059439854870974","89","10",0,19283,[0],"Я была такой с самого начала"],["42059439502549438","88","10",0,19283,[0],"Давайте развлечёмся с этим богатеньким мальчиком!"],["42059439099896254","87","10",0,19283,[0],"Потерянный солдат!"],["42059438646911422","86","10",0,19283,[0],"Правду сказать, это приятное ощущение."],["42059438328144318","85","10",0,19283,[0],"Свободен как птица"],["42059437959045566","84","10",0,19283,[0],"Футболки - не твой стиль"],["42059437573169598","83","10",0,19283,[0],"Даже я никогда так не делал"],["42059437204070846","82","10",0,19283,[0],"Танцует на ходу"],["42059436801417662","81","9",0,19283,[0],"С самого рождения я никогда не думал о поражении"],["42059436432318910","80","9",0,19283,[0],"Вы слишком шумные"],["42059436079997374","79","9",0,19283,[0],"Устаревшие взгляды парня"],["42059435710898622","78","9",0,19283,[0],"Это век тактических военных действий!"],["42059435358577086","77","9",0,19283,[0],"Эта сцена потеряла всю свою энергетику!"],["42059434989478334","76","9",0,19283,[0],"Я из Бозоку"],["42059434570047934","75","9",0,19283,[0],"Я из Бозоку"],["42059434200949182","74","9",0,19283,[0],"Почему я не могу на него обижаться?"],["42059433798295998","73","9",0,19283,[0],"Приложи все усилия!"],["42059433395642814","72","9",0,19283,[0],"Я те говорю, он опасен!"],["42054984212177342","71","8",0,19283,[0],"А то оно просочится глубже!"],["42054982987440574","70","8",0,19283,[0],"Немного мелковата, а?"],["42054982014362046","69","8",0,19283,[0],"Привет!"],["42054981024506302","68","8",0,19283,[0],"Я ощущаю лёгкость во всем теле"],["42054979883655614","67","8",0,19283,[0],"Нужно что-нибудь грандиозное!"],["42054978457592254","66","8",0,19283,[0],"Никогда больше не возвращайся!"],["42054972149359038","65","8",0,19283,[0],"Думаю, я немного передохну!"],["42054971545379262","64","8",0,19283,[0],"Это, типа, домогательство"],["42054970253533630","63","8",0,19283,[0],"Эй! Ты чего хотел-то?"],["42054969263677886","62","8",0,19283,[0],"Не говори так, будто ты в полиции!"],["42054967720174014","61","7",0,19283,[0],"Может, утреннее солнце виновато"],["42054966159892926","60","7",0,19283,[0],"Это все из-за демонов!"],["42054959834882494","59","7",0,19283,[0],"Здесь так много лошадок!"],["42054958543036862","58","7",0,19283,[0],"Эти двое - конченные придурки!"],["42054957234414014","57","7",0,19283,[0],"Лучший способ остаться незамеченным"],["42054956043231678","56","7",0,19283,[0],"А почему бы не отправить ему сообщение?"],["42054949013578174","55","7",0,19283,[0],"И что, это единственное требование?"],["42054948376043966","54","7",0,19283,[0],"Пацан, а ты мне нравишься!"],["42054947436519870","53","7",0,19283,[0],"Я научу тебя считать"],["42054946463441342","52","7",0,19283,[0],"Ты похож на ботана"],["42053139037184446","51.5","6",0,19283,[0],"Экстра «У меня нет автокарандаша!»"],["42053136973586878","51","6",0,19283,[0],"Прям вылитая домохозяйка"],["42053136000508350","50","6",0,19283,[0],"Я думал, тебя только страшилы интересуют"],["42053135295865278","49","6",0,19283,[0],"И-и-и-и-и… Поехали!"],["42053131520991678","48","6",0,19283,[0],"Я просто хочу получить свои деньги"],["42053126370386366","47","6",0,19283,[0],"Эти двое мои!"],["42053125749629374","46","6",0,19283,[0],"Это типа шутка юмора?"],["42053125112095166","45","6",0,19283,[0],"А ты меня реально бесишь!"],["42053124457783742","44","6",0,19283,[0],"Это типа шутка юмора?"],["42053123233046974","43","6",0,19283,[0],"Это наверняка идея какого-нибудь старикана, так?"],["42051597596910014","42","5",0,19283,[0],"Хочешь вступить в нашу банду?"],["42051596019851710","41","5",0,19283,[0],"Теперь я могу продавать бананы!"],["42051594375684542","40","5",0,19283,[0],"«Как насчёт яблочка за 200 золотых?»"],["42051592412750270","39","5",0,19283,[0],"Чёрт, я похож на уличного торговца!"],["42051585450205630","38","5",0,19283,[0],"Просто ученик из вечерней школы"],["42051584208691646","37","5",0,19283,[0],"Тут было какое-то празднество?!"],["42051583185281470","36","5",0,19283,[0],"Парни, мы договоримся с вами позже!"],["42051582161871294","35","5",0,19283,[0],"Ну, вот и оставайся там навсегда!"],["42051581088129470","34","5",0,19283,[0],"Команда стрёмных очкариков!"],["42051579863392702","33","5",0,19283,[0],"Это не похоже на творение рук человеческих"],["42050390358778302","32","4",0,19283,[0],"А розовому воину следует заткнуться!"],["42050390040011198","31","4",0,19283,[0],"Значит, я зря старался?"],["42050389268259262","30","4",0,19283,[0],"Слабак"],["42050388949492158","29","4",0,19283,[0],"Лучше бы она занялась учебой"],["42050388630725054","28","4",0,19283,[0],"Это – Вселенная"],["42050388295180734","27","4",0,19283,[0],"Я чувствую себя гораздо лучше!"],["42050387976413630","26","4",0,19283,[0],"Мммф ммфф ммммф!!!"],["42050386550350270","25","4",0,19283,[0],"Я хочу стать лучшей старостой!"],["42050385745043902","24","4",0,19283,[0],"На этот раз, это хулиганка..."],["42046765070836158","23","3",0,19283,[0],"Она очень хорошая девочка!"],["42046753880433086","22","3",0,19283,[0],"Что ты обо мне думаешь?"],["42046752706027966","21","3",0,19283,[0],"Сколько у тебя баллов?!"],["42046751749726654","20","3",0,19283,[0],"Не увиливай!"],["42046750743093694","19","3",0,19283,[0],"Плохо хозяин его выдрессировал"],["42046747454759358","18","3",0,19283,[0],"Это храм."],["42046740844536254","17","3",0,19283,[0],"Это я тебя должна спросить…"],["42046739821126078","16","3",0,19283,[0],"Но ты ведь даже не болен!"],["42046738697052606","15","3",0,19283,[0],"Почему ты ешь это?!"],["42046737589756350","14","3",0,19283,[0],"На этот раз ничего не поделаешь"],["42046735777817022","13","2",0,19283,[0],"Новым С Годом!"],["42046735408718270","12","2",0,19283,[0],"Но я ведь не из клуба"],["42046734938956222","11","2",0,19283,[0],"Если ты хочешь ограбить меня, то сделай это!!!"],["42046734502748606","10","2",0,19283,[0],"Это моё"],["42046734083318206","9","2",0,19283,[0],"В конце концов, это всё было лишь пустой тратой времени"],["42046733647110590","8","2",0,19283,[0],"Иногда, я тоже должна спасать его задницу"],["42046733227680190","7","2",0,19283,[0],"Я хочу пойти на школьный фестиваль!"],["42046732741140926","6","2",0,19283,[0],"Потому что, со мной уже случалось нечто подобное"],["42046732372042174","5","2",0,19283,[0],"Если у тебя хорошее зрение - проваливай отсюда!"],["42046731986166206","4","2",0,19283,[0],"Мясо стынет"],["42045367428080062","3","1",0,19283,[0],"Разве это не Янки-кун во всем виноват?"],["42045367126090174","2","1",0,19283,[0],"Минус 10 баллов, и ты - второгодник"],["42045366807323070","1","1",0,19283,[0],"Планы на будущее?"],["42044973633266110","0.3","1",0,19283,[0],"Сели"],["42044973163504062","0.2","1",0,19283,[0],"Поклонились"],["42044719911428542","0.1","1",0,19283,[0],"Встали!"],["42044422635938238","0","0",0,19283,[0],"Ваншот"]],