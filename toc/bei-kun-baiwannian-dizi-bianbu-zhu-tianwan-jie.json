мнил?!"],["73868681452478903","33","1",0,19502,[1,0],"Явление предка!"],["73868679137223095","32","1",0,19502,[1,0],"Слияние сект"],["73868677140734391","31","1",0,19502,[1,0],"Это действительно он! Древний зверь!"],["73868674640929207","30","1",0,19502,[1,0],"Собственный путь"],["73868701702578615","29","1",0,19502,[1,0],"Первый ученик секты Линьси"],["73868699404100023","28","1",0,19502,[1,0],"Сильнейшего выявит поединок"],["73868681838354871","27","1",0,19502,[1,0],"Нулевой рост? Есть другой путь!"],["73868679640539575","26","1",0,19502,[1,0],"Что происходит?"],["73868677946040759","25","1",0,19502,[1,0],"Нападём на него вместе!"],["73868675463012791","24","1",0,19502,[1,0],"Кто захватил - тот и хозяин"],["73867592426611127","23","1",0,19502,[1,0],"Каяться? Да пошёл ты!"],["73867407055151543","22","1",0,19502,[1,0],"Образование пары?"],["73867174522937783","21","1",0,19502,[1,0],"Преграждая путь"],["73867172358676919","20","1",0,19502,[1,0],"Не забывай об изначальных намерениях"],["73868680714281399","19","1",0,19502,[1,0],"Выбор"],["73868678331916727","18","1",0,19502,[1,0],"Статуи выходят из-под контроля!"],["73868676285096375","17","1",0,19502,[1,0],"Приманка для статуй"],["73867591990403511","16","1",0,19502,[1,0],"Как разделить трофеи?"],["73867407441027511","15","1",0,19502,[1,0],"Чей камень спас меня?"],["73867405075440055","14","1",0,19502,[1,0],"Ожившие статуи!"],["73867173952512439","13","1",0,19502,[1,0],"Кто сказал, что я мёртв?"],["73867171083608503","12","1",0,19502,[1,0],"Тайная техника и обретение тела"],["73866511772574135","11","1",0,19502,[1,0],"Россыпь драгоценностей может быть ловушкой?"],["73866508870115767","10","1",0,19502,[1,0],"Назовите свой уровень, чтобы мы могли действовать вместе!"],["73867405880746423","9","1",0,19502,[1,0],"Путь дао суров, но вдвоём легче идти по нему"],["73867173163983287","8","1",0,19502,[1,0],"Оружие, сражавшееся с богами и демонами"],["73867170261524919","7","1",0,19502,[1,0],"Можешь выбрать любое сокровище!"],