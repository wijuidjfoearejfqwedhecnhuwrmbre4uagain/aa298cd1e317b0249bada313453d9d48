{"slug":"please-bully-me-miss-villainess","m":"41418021083832757","at":"2026-10-18","hidden":1,"b":["41418021083898293"],"t":[["41417684969087413","Bulochnaya Team"],["82327863902101912","♡ Чай с Юри ♡"]],"c":[["127482434877933074","76","1",0,19872,[1],"Для меня нет никого дороже!"],["127482360890476050","75","1",0,19872,[1],"Лизь, лизь!"],["127482273145570834","74","1",0,19872,[1],"Можно вас потрогать?!"],["125055959482582530","73","1",0,19855,[1],"Соперник?!"],["125055887927756290","72","1",0,19855,[1],"Залезай! Поспи со мной!"],["125055830449014274","71","1",0,19855,[1],"Сияй!"],["125055737536792066","70","1",0,19855,[1],"Моя героиня."],["125055663733818882","69","1",0,19855,[1],"Я просто хочу тебя обижать."],["125055546544899586","68","1",0,19855,[1],"Странная девочка."],["122529010424038914","67","1",0,19838,[1],"Наконец-то я тебя нашла."],["122528907042833922","66","1",0,19838,[1],"Прошу, предоставьте это мне."],["108311282909733293","65","1",0,19740,[1],"Причина, по которой я не могу проиграть!"],["108311173270692269","64","1",0,19740,[1],"Тот, кого хочу защищать."],["108311128089649581","63","1",0,19740,[1],"Первая встреча."],["108311059353395629","62","1",0,19740,[1],"Я стала ребёнком?!"],["108311002730291629","61","1",0,19740,[1],"Счастливого пути, Эви."],["101185290168787346","60","1",0,19691,[1],"Решимость изменить всё"],["101185225341559186","59","1",0,19691,[1],"Звери в лесу"],["101185162359955858","58","1",0,19691,[1],"Я останусь с тобой"],["101184827738382738","57.5","1",0,19691,[0],"Пожалуйста, поиздевайся надо мной"],["101184787624059282","57","1",0,19691,[0],"Настоящие любовники"],["101184687229133202","56","1",0,19691,[0],"Признание"],["101184568429732242","55","1",0,19691,[0],"Будь честна со своим сердцем"],["101184441325478290","54","1",0,19691,[0],"Она хочет быть твоей невестой!"],["101184315563532690","53","1",0,19691,[0],"Неужели она нравится мне настолько сильно?"],["101184240821035410","52","1",0,19691,[0],"Я тебя не ненавижу"],["101184191982559634","51","1",0,19691,[0],"Мы раньше не встречались?"],["74760798286668207","50","1",0,19508,[0],"Не прикасайся ко мне."],["74760797716242863","49","1",0,19508,[0],"Эви, пожалуйста, очнись…"],["74760797280035247","48","1",0,19508,[0],"Уникальное зелье."],["74760796860604847","47","1",0,19508,[0],"А ты популярная."],["74760796441174447","46","1",0,19508,[0],"Мы можем быть твоей семьёй."],["74760795988189615","45","1",0,19508,[0],"Она лорд демонов?!"],["74760795535204783","44","1",0,19508,[0],"Куда пропала Эльза?"],["74760795132551599","43","1",0,19508,[0],"У Эви что-то на уме."],["74760794629235119","42","1",0,19508,[0],"Сегодня полнолуние..."],["74757408601170351","41","1",0,19508,[0],"Держись крепче!"],["51429035095384488","40","1",0,19347,[0],"Давай, я отвезу тебя."],["51429034843726248","39","1",0,19347,[0],"Ты можешь делать всё, что пожелаешь, Эви."],["51428958188626344","38","1",0,19347,[0],"Не могу поверить, что я..."],["51428889620144552","37","1",0,19347,[0],"Появление нового варианта."],["51428889217491368","36","1",0,19347,[0],"Я сделаю это, но только один раз."],["51428804056342952","35","1",0,19347,[0],"Нет, я и вправду издеваюсь над ней."],["51428803737575848","34","1",0,19347,[0],"Вы знаете, что значит играть \"недотрогу\"?"],["51428712419189160","33","1",0,19347,[0],"Я такая глупая."],["51428712117199272","32","1",0,19347,[0],"Конечно, Я тебя ненавижу!"],["51428711831986600","31","1",0,19347,[0],"Я забочусь о ней больше, чем предполагала."],["51428711546773928","30.5","1",0,19347,[0],"Экстра"],["51428711244784040","30","1",0,19347,[0],"Могу я задать Грубый вопрос?"],["51428465206911400","29","1",0,19347,[0],"Её типаж."],["51428464972030376","28","1",0,19347,[0],"Ты всё ещё можешь обнимать меня."],["51428464737149352","27","1",0,19347,[0],"Не могу позволить тем людям забрать её!"],["51428464485491112","26","1",0,19347,[0],"Первое свидание с Эви."],["51428464267387304","25","1",0,19347,[0],"Я хочу, чтобы ты звала меня по имени."],["51428464015729064","24","1",0,19347,[0],"Он ей понравился?"],["51428463764070824","23","1",0,19347,[0],"Ещё одно признание?"],["51428463512412584","22","1",0,19347,[0],"Твоя кровь, наверное, сладкая."],["51427972980171176","21","1",0,19347,[0],"Ты можешь спать в моей кровати."],["51427972074201512","20","1",0,19347,[0],"Я хочу выбрать горничную."],["51427876309852584","19","1",0,19347,[0],"Наше обновлённое меню."],["51427875873644968","18","1",0,19347,[0],"Не оставляй меня здесь!"],["51427875454214568","17","1",0,19347,[0],"Победа Злодейки."],["51427875034784168","16","1",0,19347,[0],"Это всё Твоя вина, Ивонна."],["51427874615353768","15","1",0,19347,[0],"Пойдём припудрим носики."],["51427874145591720","14","1",0,19347,[0],"Оказывается, издевательства могут быть такими сострадательными."],["51427873726161320","13","1",0,19347,[0],"Она поймала меня?!"],["51427873256399272","12","1",0,19347,[0],"Я придумаю, как тебя спасти!"],["51427872786637224","11","1",0,19347,[0],"Я слышала, что над Тобой кто-то издевается."],["51427872350429608","10","1",0,19347,[0],"Мне больше ничего и не нужно."],["51427224850555304","9","1",0,19347,[0],"Твоя Подруга ждёт Тебя."],["51427224548565416","8","1",0,19347,[0],"А ей это действительно идёт."],["51427224296907176","7","1",0,19347,[0],"Почему ты здесь?!"],["51427224062026152","6","1",0,19347,[0],"Пойдём ко мне домой!"],["51427223810367912","5","1",0,19347,[0],"Ты хочешь запереть меня?"],["51427223558709672","4","1",0,19347,[0],"Вы, ребята, ничего не понимаете в издевательствах!"],["51427223256719784","3","1",0,19347,[0],"Ты - человек моей судьбы!"],["51427222669517224","2","1",0,19347,[0],"Ты называешь это издевательством?"],["51426579733045672","1","1",0,19347,[0],"Как Злодейка спровоцировала концовку \"Изгнание\"."]]}