{"slug":"koharu-no-hibi","m":"99770055176249756","at":"2026-10-15","b":["99770055176315292"],"t":[["82362181747761560","Sneakers for Dominica from Beaver"]],"c":[["99774321269957020","24","4",0,19681,[0],"Навечно..."],["99774187069071772","23","4",0,19681,[0],"Любимый человек, любимое имя, любимый голос"],["99773986279350684","22","4",0,19681,[0],"О чем вообще мы говорим?!"],["99773868503294364","21","4",0,19681,[0],"На первом свидании!"],["99773749636719004","20","4",0,19681,[0],"Не смотри!"],["99773653654200732","19","4",0,19681,[0],"На седьмом небе?! Нет, в сладком аду!"],["99773491686957468","18","3",0,19681,[0],"То, чего желаю видеть больше всего"],["99773270630424988","17","3",0,19681,[0],"И что же мне делать...?"],["99773088345973148","16","3",0,19681,[0],"Заберу все у тебя я..."],["99772890324492700","15","3",0,19681,[0],"Что я еще могу сказать"],["99772670274527644","14","3",0,19681,[0],"Что ж... и я тогда..."],["99772590213652892","13","3",0,19681,[0],"Еще разок...!?"],["99772418146525596","12","2",0,19681,[0],"Потаенный уголок"],["99772288408248732","11","2",0,19681,[0],"Как же ты не понимаешь...?"],["99772168652546460","10","2",0,19681,[0],"Не рановато ли?"],["99771966872969628","9","2",0,19681,[0],"До завтра"],["99771874145296796","8","2",0,19681,[0],"Это не одно и то же"],["99771715718046108","7","2",0,19681,[0],"Не сойдет, хоть ты смыть пытайся!!"],["99771558666527132","6","1",0,19681,[0],"Да!"],["99771355326669212","5","1",0,19681,[0],"И буду стараться хоть тысячу"],["99771192654782876","4","1",0,19681,[0],"И что же там такое?"],["99771053521330588","3","1",0,19681,[0],"Достучаться до тебя"],["99770921115541916","2","1",0,19681,[0],"Прошу, возьми ее с собой"],["99770772771332508","1","1",0,19681,[0],"Я - Митсуки Кохару"]]}