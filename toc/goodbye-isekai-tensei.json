{"slug":"goodbye-isekai-tensei","m":"92262508177416582","at":"2026-10-15","b":["92262508177482118"],"t":[["46159915126907283","AkaiYuhiMun team"],["63348109903684029","Heavell Team"],["65912185783607708","KulikBand-Os"],["92263417854845318","Dark Resurrection Team"],["92264651584201094","Rebirth Team"]],"c":[["92266715617976710","18","4",0,19629,[2],"Cкажи реинкарнации \"прощай\"!"],["92266635859157382","17","4",0,19629,[2]],["92266494796325254","16","4",0,19629,[2],"Это последняя битва"],["92266360847032710","15","4",0,19629,[2],"Заставил тебя ждать, ха?"],["92266203678073222","14","4",0,19629,[2],"Для принцессы это не проблема"],["92266119120904582","13","4",0,19629,[2],"Сила другого мира"],["92266049629610374","12","3",0,19629,[2],"Сегодня, великий герой, я клянусь я убью тебя"],["92265090677563782","11","3",0,19629,[1],"Давай! У тебя никогда не получится убить меня!"],["92264939246412166","10","3",0,19629,[4],"Держись, Герой!"],["92264830999814534","9","3",0,19629,[4],"Великий герой ужасно несправедлив"],["92264538958750086","8","3",0,19629,[3],"Полагаю, теперь не получится убить героя с помощью грузовика"],["92264451348128134","7","2",0,19629,[3],"Есть вещи, которые человек хочет высказать во чтобы то ни стало"],["92264268510093702","6","2",0,19629,[3],"Характеристики героя"],["92264038259581318","5","2",0,19629,[3],"Кем ты можешь быть?"],["92263877382857094","4","2",0,19629,[3],"А теперь, измени свой класс!"],["92263748349288838","3","1",0,19629,[3],"Благодаря этому мой герой переродится"],["92263116888433030","2","1",0,19629,[0],"«Не позволим тебе умереть, Герой!»"],["92263037918077318","1","1",0,19629,[0],"Ты станешь реинкарнацией героя!"]]}