43,[3]],["79862959538463128","25.5","3",0,19543,[4],"Экстра: Вы зашли слишком далеко, Аяне-сенсей."],["79862958615716248","25","3",0,19543,[4],"Не стесняйся и сними его"],["79862381798252952","24.5","3",0,19543,[2],"Экстра: Пожалуйста, учи нормально!"],["79862381395599768","24","3",0,19543,[2],"Это не то место!"],["79861783791165848","23","3",0,19543,[0],"Я уже на пределе во многих отношениях. Часть 2"],["79861783220740504","22","3",0,19543,[0],"Я уже на пределе во многих отношениях. Часть 1"],["79861782683869592","21","3",0,19543,[0],"Всё так же вместе..."],["79861782130221464","20","3",0,19543,[0],"Наш секрет"],["79861781593350552","19","2",0,19543,[0],"...и вот что вышло в итоге"],["79861781090034072","18","2",0,19543,[0],"Раз так, я буду сотрудничать!"],["79861780620272024","17","2",0,19543,[0],"Почему я должен проходить через это?.."],["79861779764634008","16","2",0,19543,[0],"Ты животное!"],["79861778305016216","15","2",0,19543,[0],"Этот наряд... смущает..."],["79861777835254168","14","2",0,19543,[0],"Я могу быть опозорена"],["79861777399046552","13","2",0,19543,[0],"Я ощущаю аромат Юки!"],["79861776795066776","12","2",0,19543,[0],"Вы собираетесь соблазнить его, да?"],["79861776258195864","11","2",0,19543,[0],"Я не собираюсь входить в раж!"],["79861775620661656","10","2",0,19543,[0],"Я не знаю, сколько сил надо для этого..."],["79861331309650328","9","2",0,19543,[0],"Не делай этого..."],["79861330906997144","8","1",0,19543,[0],"Ты парень, ты должен быть более открытым!"],["79861330504343960","7","1",0,19543,[0],"Мне кажется, что я делаю что-то не так"],["79861330084913560","6","1",0,19543,[0],"Попался"],["79861329665483160","5","1",0,19543,[0],"Почему моё сердце так бешено бьётся из-за парня?"],["79861329262829976","4","1",0,19543,[0],"Не деритесь в ванной"],["79861214271791512","3","1",0,19543,[0],"Только скажи и я разденусь"],["79861213869138328","2","1",0,19543,[0],"Прошу шлепни меня"],["79861213432930712","1","1",0,19543,[0],"Сведём к абсолютному нулю"]],"