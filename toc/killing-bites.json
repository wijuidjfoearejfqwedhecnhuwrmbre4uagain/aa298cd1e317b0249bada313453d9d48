{"slug":"killing-bites","m":"74640862851654036","at":"2026-10-18","b":["74640862851719572"],"t":[["45241483413971349","Unnamed Manga"],["46247178997358990","Flaming Rose"],["50361859101974935","AniStar Team"],["51097979083317692","EleMayo"],["56213102613520790","Sadistic Summer"],["74485247311372735","Kurogitsune"],["74654440098914708","Project GangStar"]],"c":[["251615345490544146","143","28",0,20728,[5],"C этого момента - моргать запрещено"],["247659476532872705","142","28",0,20701,[5],"Притворяться слабой тоже утомительно"],["240176757783676479","141.5","27",0,20649,[5],"Экстра: Слишком большая! Сахара-сан #6"],["240176755132876351","141","27",0,20649,[5],"Я хотела, чтобы у меня было сто друзей!"],["230304459689838141","140","27",0,20581,[5],"Группа поддержки не допустит"],["224944971831068204","139","27",0,20544,[5],"Он хорошо понимает гибридов"],["220178415196587539","138","27",0,20511,[5],"Если так продолжится, распад класса неизбежен."],["216539972373595667","137","27",0,20486,[5],"Вот бы все могли стать гибридами"],["217405077168604691","136.5","26",0,20492,[5],"Экстра: Слишком большая! Сахара-сан #5"],["211456739696985626","136","26",0,20451,[5],"Что она за гибрид?"],["203566124229477894","135","26",0,20397,[5],"Я ещё не чемпион"],["199572583711000092","134","26",0,20369,[5],"Я ждала этого момента"],["194878324529448467","133","26",0,20337,[5],"Это мой \"смертельный укус\""],["189717173697005090","132","26",0,20301,[5],"Сдержи слёзы и скажи прощай"],["185888453773248045","131","26",0,20275,[5],"Пойдёмте домой, президент"],["189717116016936482","130.5","25",0,20301,[5],"Экстра: Слишком большая! Сахара-сан #4"],["182014480329229862","130","25",0,20248,[5],"\"Тебе сначала придется убить меня, верно?\""],["176343085335201307","129","25",0,20209,[5],"Нам не нужно понимать друг друга."],["172547460852370658","128","25",0,20183,[5],"Ты ждала, когда я стану серьёзной."],["167507077739072762","127","25",0,20148,[5],"Я больше не хочу сражаться."],["157251255222158908","126","25",0,20077,[5],"Она не столько сильная, сколько… отвратительная"],["149998429378987553","125","25",0,20027,[5],"Моя работа на этом заканчивается."],["149998426325534241","124.5","24",0,20027,[5],"Экстра: Слишком большая! Сахара-сан #3"],["145941686890022414","124","24",0,19999,[5],"В конце концов, людям суждено убивать друг друга."],["140718802613585459","123","24",0,19963,[5],"Чего ты хочешь?"],["135803553187972664","122","24",0,19929,[5],"Она не из тех, кого можно запугать числом."],["131012038632687151","121","24",0,19896,[5],"Динозавр нашёл меня"],["122745504206439938","120","24",0,19839,[5],"В конце концов, я же убийца"],["118830361185633837","119","24",0,19812,[5],"На этот раз я действительно могу умереть"],["118108449593640468","118.5","23",0,19807,[5],"Экстра: Слишком большая! Сахара-сан #2"],["112624834730542620","118","23",0,19769,[5],"Хорошего конца!"],["108267817974915501","117","23",0,19739,[5],"Они постоянно думают об этом"],["104337908923654529","116","23",0,19712,[5],"Земля возродится"],["100685372383584658","115","23",0,19687,[5],"Я хочу, чтобы ты взяла на себя мою миссию"],["91588032670491025","114","23",0,19624,[5],"Теперь можно поплакать"],["86364668414681493","113","23",0,19588,[5],"Я сделаю всё, что в моих силах"],["82609389176906145","112","23",0,19562,[5],"Пожалуйста, позволь мне остаться здесь"],["104337908554555777","111.5","22",0,19712,[5],"Слишком большая! Сахара-сан"],["78104489818612122","111","22",0,19531,[5],"Очень похожа на Уи-сан"],["74675647322022292","110","22",0,19508,[5],"Не кричи что вздумается"],["74675646416052628","109","22",0,19508,[5],"Удовольствие от победы"],["74674894310236564","108","22",0,19508,[5],"Я никогда тебя не забуду"],["74674891676213652","107","22",0,19508,[5],"Не будь так жесток со мной"],["74674563278987668","106","22",0,19508,[5],"Уродливая рептилия"],["74674561618043284","105","22",0,19508,[5],"Какой несдержанный ребенок"],["74674265382740372","104.5","21",0,19508,[5],"Экстра: Беги и прячься! Инаба-сан. Финал"],["74674265013641620","104","21",0,19508,[5],"Это уже не игра"],["74674187704230292","103","21",0,19508,[5],"Сценарий, по которому мы будем действовать"],["74674186294944148","102","21",0,19508,[5],"Мой брат смотрит"],["74673836640985492","101","21",0,19508,[5],"Я уже зеваю"],["74673835365917076","100","21",0,19508,[5],"Ты и правда сильно подросла, Рио"],["74673833285542292","99","21",0,19508,[5],"Человечество не слабое"],["74673531010441620","98.5","20",0,19508,[5],"Экстра: Беги и прячься! Инаба-сан"],["74673530607788436","98","20",0,19508,[5],"Кого это ты называешь слабой?"],["74673528913289620","97","20",0,19508,[5],"Я собираюсь выложиться на полную"],["74673527202013588","96","20",0,19508,[5],"По правде говоря, я думаю, что она не победима"],["74673526782583188","95","20",0,19508,[5],"Я начисто потеряла уверенность в себе"],["74672961356849556","94","20",0,19508,[5],"Я не могу больше терпеть"],["74672747128578452","93.5","19",0,19508,[5],"Экстра: Беги и прячься! Инаба-сан"],["74672738538643860","93","19",0,19508,[5],"Скорее бросает в дрожь, верно?"],["74672603314282900","92","19",0,19508,[5],"Любовь педагога"],["74672512868311444","91","19",0,19508,[5],"Ни за что не отпущу!"],["74672231866720660","90","19",0,19508,[5],"До чего же поганая девка"],["74671539169026452","89","19",0,19508,[4],"Умение охотиться заложено в моей натуре ❤"],["74671538732818836","88.5","18",0,19508,[4],"Экстра: Беги и прячься! Инаба-сан"],["74671538313388436","88","18",0,19508,[4],"Однако, я разочарована"],["74670617093235092","87","18",0,19508,[4],"Ты не воин"],["74670615147078036","86","18",0,19508,[4],"Ничего не поделаешь, она должна быть особенной этим вечером"],["74670613888786836","85","18",0,19508,[4],"Твоя атака смогла серьёзно меня ранить"],["74670612160733588","84","18",0,19508,[4],"Кто, чёрт , решил это за меня?"],["74670611758080404","83.5","17",0,19508,[4],"Экстра: Беги и прячься! Инаба-сан"],["74670611321872788","83","17",0,19508,[4],"И кто теперь идиот?"],["74670610466234772","82","17",0,19508,[4],"Без шестого чувства не стоит даже и пытаться"],["74670610046804372","81","17",0,19508,[4],"Ты будешь убит мной"],["74670609593819540","80","17",0,19508,[4],"Огромные"],["74669295333826964","79","17",0,19508,[2],"Я согласна"],["74669089796153748","78.5","16",0,19508,[4],"Экстра: Беги и прячься! Инаба-сан"],["74668882714976660","78","16",0,19508,[2],"Хочу вернуть"],["74668882312323476","77","16",0,19508,[2],"Нет никакой гарантии, что я не умру"],["74668881926447508","76","16",0,19508,[2],"И силой, и очарованием я превосхожу его"],["74668881104363924","75","16",0,19508,[2],"Я позволю тебе встретиться с Тасуку"],["74668880684933524","74","16",0,19508,[2],"Непоколебимый царь зверей"],["74667853315334548","73.5","15",0,19508,[0],"Экстра: Беги и прячься! Инаба-сан"],["74667714769084820","73","15",0,19508,[2],"У нас появилась отличная «пешка»"],["74667638768296340","72","15",0,19508,[2],"Ты спас Хитоми"],["74667481632891284","71","15",0,19508,[2],"Я покажу тебе кое-что интересноe"],["74667481247015316","70","15",0,19508,[2],"Раз так хочешь, дарю"],["74667480827584916","69","15",0,19508,[2],"Мне отчаянно приходилось сдерживаться"],["74667480408154516","68","14",0,19508,[2],"Наверное, с тобой я чувствую себя спокойнее всего"],["74666637285941652","67","14",0,19508,[2],"Как тот, кто отвечает за человеческие жизни"],["74666503588307348","66","14",0,19508,[2],"Этого очень не хватает"],["74666473758417300","65","14",0,19508,[2],"Я тоже приму участие в финале турнира"],["74666473372541332","64","13",0,19508,[2],"Сразишься со мной один на один?"],["74666472969888148","63","13",0,19508,[2],"Никто не умирает"],["74666472550457748","62","13",0,19508,[2],"Ты больше не одна"],["74666472147804564","61","13",0,19508,[2],"Я уже давно это знала"],["74666471678042516","60","13",0,19508,[2],"Всё только начинается, ага?"],["74666471258612116","59","12",0,19508,[2],"Поиграем ещё, «Тасманийский дьявол»"],["74666470000320916","58","12",0,19508,[2],"Хоть бы имя запомнила!"],["74665641205850516","57","12",0,19508,[2],"Нодока плачет!"],["74665427044688276","56","12",0,19508,[2],"Я ждала такого шанса"],["74665426239381908","55","12",0,19508,[2],"Наверное, я скоро умру"],["74663051021803924","54.5","11",0,19508,[2],"Экстра: Специальный выпуск"],["74663050602373524","54","11",0,19508,[2],"Пусть они все умрут"],["74663050166165908","53","11",0,19508,[2],"Твоя подруга — я, правда?"],["74663049662849428","52","11",0,19508,[2],"Всё-таки «Смертельный укус» весёлый"],["74663049193087380","51","11",0,19508,[2],"Убери руки от моей подруги"],["74663048756879764","50","11",0,19508,[2],"Помоги, Нунупи"],["74663048320672148","49","10",0,19508,[2],"Впервые в жизни у меня появился друг"],["74663047834132884","48","10",0,19508,[2],"Уже скоро выпадет шанс"],["74662107336958356","47","10",0,19508,[2],"Мне кажется, что если я сейчас сбегу, то не стану чемпионом!"],["74662106917527956","46","10",0,19508,[2],"Меня от неё просто блевать тянет?!"],["74662106531651988","45","10",0,19508,[2],"Оч больненько…"],["74662106145776020","44","9",0,19508,[2],"Давно не виделись, зайчишка"],["74662105709568404","43","9",0,19508,[2],"Я просто хочу пойти в более высокое место"],["74662104870707604","42","9",0,19508,[2],"Сегодня вечером мне везёт"],["74661424135168404","41","9",0,19508,[2],"У меня есть Нунупи!"],["74661423380193684","40","9",0,19508,[2],"Почему ты меня убила?"],["74661422943986068","39","8",0,19508,[2],"Аа, вот засада"],["74661422541332884","38","8",0,19508,[2],"Стать чемпионом – уже не просто мечта"],["74661422121902484","37","8",0,19508,[2],"Мой предок"],["74661421702472084","36","8",0,19508,[2],"Смертельный укус не такой уж мягкий"],["74661421316596116","35","8",0,19508,[2],"Итак, ты потерпела поражение?"],["74661420897165716","34","7",0,19508,[2],"Пожалуйста, закрой глаза на Тасуку"],["74660639615771028","33","7",0,19508,[2],"Теперь ты правда сделаешь меня зверем?"],["74660570527195540","32","7",0,19508,[2],"Я не боюсь умереть!"],["74660570090987924","31","7",0,19508,[2],"Я стану чемпионом «Смертельного укуса»"],["74659791074517396","30","6",0,19508,[0],"Спасибо за все"],["74659790688641428","29","6",0,19508,[0],"Грубое нарушение правил"],["74659594697204116","28","6",0,19508,[0],"А? Где это я опять?"],["74659452191531412","27","6",0,19508,[0],"Убью! Убью! Убью!"],["74659451721769364","26","6",0,19508,[0],"Тебе не разрешали осквернять мою маму"],["74659205751005588","25","5",0,19508,[0],"Эта девочка не животное"],["74659205348352404","24","5",0,19508,[0],"Показывать вам наше превосходство - лучшая вещь на свете"],["74659204928922004","23","5",0,19508,[0],"Как и планировалось"],["74658873612460436","22","5",0,19508,[0],"Я вылезла не в том месте"],["74657247967338900","21","5",0,19508,[3],"Намото, твой боец уже сдох"],["74657247497576852","20","4",0,19508,[3],"Пока я не убью его, снова"],["74657247078146452","19","4",0,19508,[3],"У тебя нет и капли мозгов, ты - амёба"],["74657246658716052","18","4",0,19508,[3],"Я уже решила отдаться кое-кому другому"],["74657246239285652","17","4",0,19508,[3],"Бой, как искусство любовных игр"],["74656656671138196","16","4",0,19508,[3],"Если они будут драться, то он 100% умрет"],["74656656251707796","15","3",0,19508,[3],"Да кого еб#т?"],["74656655832277396","14","3",0,19508,[3],"Господи, кошка, отстань"],["74656655412846996","13","3",0,19508,[3],"Ты должен стать зверем"],["74656272321896852","12","3",0,19508,[3],"Убить тебя за кусок торта"],["74656271936020884","11","3",0,19508,[3],"Почему мы не можем над этим посмеяться?"],["74656271516590484","10","2",0,19508,[3],"Мне пофиг, если такая мелочь, как ты, сделает что-то"],["74656271097160084","9","2",0,19508,[3],"Превзойди свои инстинкты"],["74656270694506900","8","2",0,19508,[3],"Вот почему я сказала тебе свалить, ты мусор!"],["74656270291853716","7","2",0,19508,[3],"Это не проблема!"],["74655143500472724","6","2",0,19508,[6],"Да это ж...чертовски весело"],["74655143114596756","5","1",0,19508,[6],"Чёрт,кажется я влюбилась..."],["74654383710691732","4","1",0,19508,[1],"Ну и обстановка..."],["74654294187467156","3","1",0,19508,[1],"Неосознанная лобовая атака!"],["74654172099666324","2","1",0,19508,[1],"Чертовски восхитительно, верно?"],["74654171646681492","1","1",0,19508,[1],"Тебе лучше не оборачиваться"]],"w":{"n":["Смертельный укус","Killing Bites","キリングバイツ","牙鬥獸娘"],"t":"manga","p":24288,"s":["killing-bites",157,"2026-10-02","74640862851654036/covers/f2fbb57acd1f41b7b7287672a0c2e07406b8b91c_220258661610571326.jpeg",1],"d":["killing-bites",1566],"h":["killing_bites","0018/47/1746103.jpeg"],"x":1,"l":[25,123,86,36,0,24,67,120,23,62,17],"st":"o","cc":[144,13,157]}}