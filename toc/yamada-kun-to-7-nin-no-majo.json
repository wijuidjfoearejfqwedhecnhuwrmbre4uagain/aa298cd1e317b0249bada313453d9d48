{"slug":"yamada-kun-to-7-nin-no-majo","m":"39839994197598600","at":"2026-10-15","b":["39839994197664136"],"t":[["39804024769241531","Rikudou-Sennin Clan"]],"c":[["42156072105959819","243","28",0,19283,[0],"Заключительный эпизод"],["42153026621825419","242","28",0,19283,[0],"Целых десять лет прошло..."],["42153023669035403","241","28",0,19283,[0],"Я полагаюсь на вас, ребята!"],["42152798669791627","240","28",0,19283,[0],"Ни стыда ни совести!!!"],["42152795582783883","239","28",0,19283,[0],"Я не скучная!!!"],["42152793770844555","238","28",0,19283,[0],"Я скучаю по ней"],["42152792109900171","237","28",0,19283,[0],"Исконная ведьма"],["42152790532841867","236","28",0,19283,[0],"Я не знаю никого с таким именем..."],["42151971418825099","235","27",0,19283,[0],"Только Шираиши не говори, ладно?"],["42151969372004747","234","27",0,19283,[0],"Ты уверена?"],["42151964473057675","233","27",0,19283,[0],"Девочка на этой фотографии..."],["42151961453158795","232","27",0,19283,[0],"Мы уже не члены этого клуба."],["42151958450037131","231","27",0,19283,[0],"Ну как ваши летние каникулы?"],["42151956889756043","230","27",0,19283,[0],"Я поступлю точно так же!"],["42151955379806603","229","27",0,19283,[0],"Сила психологии!"],["42151953836302731","228","27",0,19283,[0],"Быть молодым!"],["42150738176008587","227","27",0,19283,[0],"Простые, элементарные задачки."],["42149242839523723","226","26",0,19283,[0],"Средний балл?"],["42149241514123659","225","26",0,19283,[0],"Позволь я помогу тебе."],["42148969907773835","224","26",0,19283,[0],"Они ни за что не станут водиться со мной."],["42148969454789003","223","26",0,19283,[0],"Быть может, ты боишься?"],["42148637031031179","222","26",0,19283,[0],"Я свободный человек!"],["42148616747377035","221","26",0,19283,[0],"Ему нужен Ямада!!!"],["42148613056389515","220","26",0,19283,[0],"Или нет."],["42148609650614667","219","26",0,19283,[0],"Целовались взасос?"],["42148606278394251","218","26",0,19283,[0],"Короче, вы некомпетентны?!"],["42148605707968907","217","25",0,19283,[0],"Я готова!.."],["42148604952994187","216","25",0,19283,[0],"Я сказал «Destiny»!"],["42148604130910603","215","25",0,19283,[0],"Ты просто хочешь, чтобы тебя пожалели."],["42147909872935307","214","25",0,19283,[0],"Приговорён к щекотке!"],["42147909487059339","213","25",0,19283,[0],"Ненавижу тебя!!!"],["42147909084406155","212","25",0,19283,[0],"Впервые вижу, чтобы девчонка из-за такого рыдала!"],["42147908664975755","211","25",0,19283,[0],"Я переродилась!"],["42147907540902283","210","25",0,19283,[0],"Не умирай у меня на руках!"],["42147905879957899","209","25",0,19283,[0],"Вы смотрите на меня этим страстным взглядом!"],["42146780363645323","208","24",0,19283,[0],"Будь благодарен мне!"],["42146769894662539","207","24",0,19283,[0],"Купи дайкона по дороге домой!"],["42146286526292363","206","24",0,19283,[0],"Ты и остался с носом."],["42146282130661771","205","24",0,19283,[0],"За проститута меня держите?!"],["42146279244980619","204","24",0,19283,[0],"Как-то неоригинально, что ли?"],["42146274715132299","203","24",0,19283,[0],"Падкая на тренды"],["42146268759220619","202","24",0,19283,[0],"И у меня появится парень?!"],["42146263910605195","201","24",0,19283,[0],"Рааай"],["42146252904751499","200","24",0,19283,[0],"С видом на побередье океана!"],["42146251428356491","199","23",0,19283,[0],"Я даже не знаю..."],["42146246999171467","198","23",0,19283,[0],"А ещё там есть морские огурцы."],["42146241026482571","197","23",0,19283,[0],"Что сделать?"],["42146235120902539","196","23",0,19283,[0],"Удивлён?"],["42146230070960523","195","23",0,19283,[0],"У меня колет в груди..."],["42146228477125003","194","23",0,19283,[0],"Вот бы у меня был парень..."],["42146226950398347","193","23",0,19283,[0],"Так ещё и самодельный?.."],["42146225423671691","192","23",0,19283,[0],"Всех порешу, крысы малолетние!"],["42146223829836171","191","23",0,19283,[0],"Ка... какой милашка!"],["42143692382822846","190","22",0,19283,[0],"Хостами, что ли?!"],["42143689799131582","189","22",0,19283,[0],"Он идеальный соперник."],["42143688138187198","188","22",0,19283,[0],"Штаны тоже снимать?"],["42143687752311230","187","22",0,19283,[0],"Наш совершенно новый замечательный клуб поэзии!"],["42143686410133950","186","22",0,19283,[0],"Ты идёшь в душ?"],["42142846727250366","185","22",0,19283,[0],"Чему не учат в школе"],["42142844797870526","184","22",0,19283,[0],"Кто будет мятное мороженое с шоколадной крошкой?!"],["42142841928966590","183","22",0,19283,[0],"Можешь ударить меня?"],["42142834278556094","182","22",0,19283,[0],"Что ж, твоя правда"],["42142831879414206","181","21",0,19283,[0],"А хотя я всегда знал об этом."],["42142829631267262","180","21",0,19283,[0],"Ставлю четвёрку."],["42142827416674750","179","21",0,19283,[0],"Дрожу от того, что не могу поговорить с тобой."],["42142826477150654","178","21",0,19283,[0],"Вот тут"],["42142824430330302","177","21",0,19283,[0],"Или ты забыл, что она учится в старшей школе?!"],["42142823373365694","176","21",0,19283,[0],"Фататим им фару!"],["42141932016656830","175","21",0,19283,[0],"Ищешь секретную тетрадку?"],["42141931647558078","174","21",0,19283,[0],"Ты боишься!"],["42141727703720382","173","21",0,19283,[0],"Признайся, ты же вылитый сталкер!"],["42141726244102590","172","20",0,19283,[0],"Не надо драться из-за меняяя!"],["42141725891781054","171","20",0,19283,[0],"Вот это поворот!"],["42141723324867006","170","20",0,19283,[0],"Я обязательно вернусь!.."],["42141722519560638","169","20",0,19283,[0],"Отказано!"],["42140867519078846","168","20",0,19283,[0],"Ты совсем не милый кохай!"],["42140866344673726","167","20",0,19283,[0],"Как будто я стала женой семпая!"],["42140607119909310","166","20",0,19283,[0],"Мы можем целоваться, когда захотим!"],["42140606734033342","165","20",0,19283,[0],"Так что я тебе его не отдам!"],["42139896588034494","164","19",0,19283,[0],"Дотронься до меня..."],["42139895732396478","163","19",0,19283,[0],"Похоже, меня бросили?.."],["42139894960644542","162","19",0,19283,[0],"Все обвинили в том, что они раздеты!"],["42139894105006526","161","19",0,19283,[0],"Цвета фламинго!"],["42139893333254590","160","19",0,19283,[0],"Н-не могу поверить!"],["42139892544725438","159.5","19",0,19283,[0],"Спешл! Аниме доклад!"],["42139881287213502","159","19",0,19283,[0],"Проведу-ка я пару рандори!"],["42139880549015998","158","19",0,19283,[0],"Харуко-чан!!"],["42139879794041278","157","19",0,19283,[0],"Пощады не ждите!"],["42139878770631102","156","19",0,19283,[0],"Это просто игрушка"],["42139877914993086","155","18",0,19283,[0],"Все время..."],["42139876472152510","154","18",0,19283,[0],"Вот это успех!"],["42139875499073982","153","18",0,19283,[0],"Я обещала тебе!"],["42139874173673918","152","18",0,19283,[0],"О твоей измене!"],["42137814921404862","151","18",0,19283,[0],"В лондоне."],["42137814552306110","150","18",0,19283,[0],"Я не лысый!"],["42137025016521150","149","18",0,19283,[0],"Еще один ужасный рисунок?"],["42137024328655294","148","18",0,19283,[0],"Миленький медвежонок."],["42137023590457790","147","18",0,19283,[0],"Проси потрогать её грудь!"],["42137022818705854","146","17",0,19283,[0],"Мы с вами - лучшие."],["42137015755497918","145","17",0,19283,[0],"Как бесит..."],["42137015218627006","144","17",0,19283,[0],"Неотразимое благородство."],["42137013993890238","143","17",0,19283,[0],"Мы говорим «хожу»."],["42137013071143358","142","17",0,19283,[0],"Налей еще колы!"],["42137012601381310","141","17",0,19283,[0],"Налей еще колы!"],["42137011057877438","140","17",0,19283,[0],"Ночь перед выселением студсовета из комнаты..."],["42137010185462206","139","17",0,19283,[0],"Это так заводит!"],["42137009245938110","138","17",0,19283,[0],"Ты меня не поцелуешь?"],["42137007752765886","137","16",0,19283,[0],"Я бы не была в этом так уверена."],["42137006796464574","136","16",0,19283,[0],"Одна ну ооочень надоедливая сила"],["42137006326702526","135","16",0,19283,[0],"Я же сказала, что у нас перерыв в отношениях."],["42134390121193918","134","16",0,19283,[0],"А кофе-то еще не остыл."],["42134388745462206","133","16",0,19283,[0],"Нападайте!"],["42134387403284926","132","16",0,19283,[0],"Не расскажешь?"],["42134386480538046","131","16",0,19283,[0],"Страшнее призрака..."],["42134385993998782","130","16",0,19283,[0],"У меня и без вас голова забита!"],["42134385557791166","129","16",0,19283,[0],"Это все"],["42132551338320318","128","15",0,19283,[0],"Заставляет меня волноваться еще больше"],["42132550533013950","127","15",0,19283,[0],"Сексуальность"],["42132452386300350","126","15",0,19283,[0],"У меня есть соперник"],["42132451564216766","125","15",0,19283,[0],"У меня только 400 иен!"],["42132450742133182","124","15",0,19283,[0],"Стань со мной единым целым..."],["42132449735500222","123","15",0,19283,[0],"Включила тревогу"],["42132448863084990","122","15",0,19283,[0],"Зови меня Линкольн"],["42132448007446974","121","15",0,19283,[0],"Ему нравится большая грудь"],["42132438830309822","120","15",0,19283,[0],"Да ну!"],["42132437672681918","119","14",0,19283,[0],"Завяжи волосы как я!"],["42132437135811006","118","14",0,19283,[0],"Ты вииидел!"],["42132436062069182","117","14",0,19283,[0],"Пора возвращаться!"],["42132434770223550","116","14",0,19283,[0],"Тебя не спрашивали!"],["42132434065580478","115","14",0,19283,[0],"Я на диете!"],["42132433579041214","114","14",0,19283,[0],"Идеально, да?"],["42132433092501950","113","14",0,19283,[0],"Молоко ещё на губах не обсохло"],["42132432639517118","112","14",0,19283,[0],"Всё провоняло"],["42132432152977854","111","14",0,19283,[0],"Вот это фигурка"],["42132431666438590","110","13",0,19283,[0],"Стрёмные"],["42132431163122110","109","13",0,19283,[0],"JK-Маска"],["42132430676582846","108","13",0,19283,[0],"Альянс горько-сладкого типа"],["42132430190043582","107","13",0,19283,[0],"Кажется, ему скучно"],["42132418915754430","106","13",0,19283,[0],"Мыслишки у нее весьма грязные"],["42132418412437950","105","13",0,19283,[0],"Пваститее!"],["42132417758126526","104","13",0,19283,[0],"Прикалывает ходить без трусишек"],["42130757904261566","103","13",0,19283,[0],"Потом загугли!"],["42130079198765502","102","12",0,19283,[0],"Да он как открытая книга"],["42130077437157822","101","12",0,19283,[0],"Береги себя"],["42130076279529918","100","12",0,19283,[0],"Я был действительно зол."],["42130074635362750","99","12",0,19283,[0],"Будешь булочку с бобовой пастой?"],["42130068176134590","98","12",0,19283,[0],"Вот это буфера!"],["42130067169501630","97","12",0,19283,[0],"Сушши"],["42130065709883838","96","12",0,19283,[0],"Прям как нидзя!"],["42130064921354686","95","12",0,19283,[0],"Зыыырк!"],["42130061968564670","94","11",0,19283,[0],"До креветки усох"],["42130060609610174","93","11",0,19283,[0],"Впереди"],["42130049301766590","92","11",0,19283,[0],"Чай!"],["42130048009920958","91","11",0,19283,[0],"Опять темпура?!"],["42130046902624702","90","11",0,19283,[0],"Хуже тебя не придумаешь!"],["42130045241680318","89","11",0,19283,[0],"Без-трусовое правило!!!"],["42130044755141054","88","11",0,19283,[0],"Всем известную?"],["42130044235047358","87","11",0,19283,[0],"Не хочу, чтобы меня прокляли!"],["42130043798839742","86","11",0,19283,[0],"Задохлик!!!"],["42130043396186558","85","10",0,19283,[0],"Тебе так приспичило увидеть ее голой?!"],["42130042993533374","84","10",0,19283,[0],"Тогда накроется клуб медным тазом!"],["42130042590880190","83","10",0,19283,[0],"У меня уже есть нижнее белье"],["42130042205004222","82","10",0,19283,[0],"Да потому что наука ‒ мое второе имя, вы так не думаете?"],["42130041819128254","81","10",0,19283,[0],"Я как раз смотрю фильмец!"],["42128269272703422","80","10",0,19283,[0],"Да ты просто маньяк ушибленный!"],["42128268903604670","79","10",0,19283,[0],"Я так же крут, как Миямура!"],["42128268115075518","78","10",0,19283,[0],"Только не с твоей в паре."],["42128100074480062","77","10",0,19283,[0],"Мерзость!"],["42127614155973054","76","9",0,19283,[0],"Горбатого могила исправит"],["42127612595691966","75","9",0,19283,[0],"Чую веселуху."],["42127606841106878","74","9",0,19283,[0],"Ужик, это не совсем по-джентельменски."],["42127606102909374","73","9",0,19283,[0],"Давай залезем в более укромные местечки."],["42127605767365054","72","9",0,19283,[0],"Жук, фууууу!"],["42127604978835902","71","9",0,19283,[0],"Вышибем к хуям его гребаную дверь!"],["42127604207083966","70","9",0,19283,[0],"Урара любит меня?"],["42127601522729406","69","8",0,19283,[0],"О-он сказочная бестолочь!"],["42127601120076222","68","8",0,19283,[0],"Ха-ха, отсоси-ка!"],["42127600650314174","67","8",0,19283,[0],"Ну знаешь! Трусики – это тебе не абы как!"],["42127600197329342","66","8",0,19283,[0],"Не забудь!"],["42127599694012862","65","8",0,19283,[0],"Вот ты где."],["42127599123587518","64","8",0,19283,[0],"Ну, так как?"],["42127598519607742","63","8",0,19283,[0],"Ыть!"],["42126483707158974","62","8",0,19283,[0],"Не хочу больше видеть тебя такой грустной и одинокой."],["42126478707548606","61","8",0,19283,[0],"Подставляй губки, детка."],["42126477617029566","60","7",0,19283,[0],"Динь-дон"],["42126476543287742","59","7",0,19283,[0],"Долбаный дразнильщик"],["42126475268219326","58","7",0,19283,[0],"Тоже хочешь перекусить?"],["42126474546799038","57","7",0,19283,[0],"Да, именно"],["42126473439502782","56","7",0,19283,[0],"Вы меня беспокоите, мистер Ямада"],["42126467819135422","55","7",0,19283,[0],"Ну, так что?"],["42126466812502462","54","7",0,19283,[0],"Приветики, мистер Ямада"],["42126466476958142","53","7",0,19283,[0],"Вот же ж геморр"],["42126465386439102","52","7",0,19283,[0],"Долой унылые булки!"],["42125288481513918","51","6",0,19283,[0],"С одним условием"],["42125288045306302","50","6",0,19283,[0],"Типичный Ямада"],["42125287625875902","49.5","6",0,19283,[0],"Ху-у-уф"],["42125287206445502","49","6",0,19283,[0],"Срань енотова, Ямада!"],["42125286719906238","48","6",0,19283,[0],"Узнай наконец правду!"],["42125286334030270","47","6",0,19283,[0],"Ыа!"],["42125285646164414","46","6",0,19283,[0],"Женская зависть пугает!"],["42125277475660222","45","6",0,19283,[0],"Санта, по ходу, от меня в восторге"],["42125276905234878","44","6",0,19283,[0],"Иди на хрен, сталкер!"],["42125276418695614","43","5",0,19283,[0],"А я не думаю, что ты помешанный."],["42125275999265214","42","5",0,19283,[0],"Выставка редких животных со всего мира."],["42125275646943678","41","5",0,19283,[0],"Может ей нравится сверкать нижним бельём"],["42125275277844926","40","5",0,19283,[0],"Умоих губ уже давно есть обладатель"],["42125274891968958","39","5",0,19283,[0],"Блааа"],["42125274539647422","38","5",0,19283,[0],"Сам узнай"],["42125274153771454","37","5",0,19283,[0],"Нет времени объяснять"],["42125273784672702","36","5",0,19283,[0],"Встал?"],["42125273398796734","35","5",0,19283,[0],"Она может видеть будущее?!"],["42125273012920766","34","4",0,19283,[0],"Ты хочешь в компенсацию интим?"],["42125272610267582","33","4",0,19283,[0],"Санта пришёл рано!"],["42125272224391614","32","4",0,19283,[0],"Фш-ш-ш Пых Пых"],["42125271804961214","31","4",0,19283,[0],"Сиськи Одагири"],["42125271335199166","30","4",0,19283,[0],"Сиськи"],["42125270898991550","29","4",0,19283,[0],"Новобранец!"],["42125270446006718","28","4",0,19283,[0],"Ших Ших"],["42125269976244670","27","4",0,19283,[0],"Бу-у-у-у-ун-н!"],["42125269321933246","26","4",0,19283,[0],"Хоспаде!"],["42123162455925182","25","3",0,19283,[0],"Бз-з-з, бз-з-з"],["42123161768059326","24","3",0,19283,[0],"Нельзя терять ни минуты!"],["42123161432515006","23","3",0,19283,[0],"Ты не приемлешь мои чувства?"],["42123160677540286","22","3",0,19283,[0],"Печалька!"],["42123159922565566","21","3",0,19283,[0],"Рука болит"],["42123159536689598","20","3",0,19283,[0],"Пораскинь мозгами!"],["42123153631109566","19","3",0,19283,[0],"Дерзай, жеребец!"],["42123152960020926","18","3",0,19283,[0],"Кач-кач"],["42123152624476606","17","3",0,19283,[0],"Ты полное ничтожество и не достоин этого…"],["42123151869501886","16","2",0,19283,[0],"Такие мягкие! Так и просятся в руки!"],["42123151500403134","15","2",0,19283,[0],"Святые бананы"],["42123150728651198","14","2",0,19283,[0],"Шинджи Иккю"],["42123150325998014","13","2",0,19283,[0],"Позволь губам моим коснуться губ прекраснейших твоих!"],["42123149269033406","12","2",0,19283,[0],"Для истинной любви моей этого и достаточно."],["42123148866380222","11","2",0,19283,[0],"Вспомнил! Сузуки, верно?"],["42123148044296638","10","2",0,19283,[0],"Она так сильно покраснела..."],["42123147121549758","9","2",0,19283,[0],"Изничтожающий торнадо-пинок!"],["42123146685342142","8","2",0,19283,[0],"Только не моя Шираиши!.."],["42123145796149694","7","1",0,19283,[0],"Давай сделаем это по-быстрому"],["42122022796419518","6","1",0,19283,[0],"Ребят, я вам не лабораторная крыса..."],["42122020246282686","5","1",0,19283,[0],"И ты пойдёшь со мной!"],["42122019491307966","4","1",0,19283,[0],"Чувак, пятый размер!"],["42122019055100350","3","1",0,19283,[0],"Ну что сказать, в сильных женщинах есть свой особый шарм."],["42122018266571198","2","1",0,19283,[0],"Эй, парниша, дай и мне глянуть"],["42122015800320446","1","1",0,19283,[0],"Давай попробуем!"]],"w":{"n":["Ямада-кун и семь Ведьм","Дьявольский класс","Yamada-kun to 7-nin no Majo","Yamada-kun and the Seven Witches","山田くんと7人の魔女","Yamada-kun to Nananin no Majo","The Devil's Classroom","Maou no Kyoushitsu","7 Witches","yamada and the seven witches"],"t":"manga","p":8338,"s":["yamada-kun-to-7-nin-no-majo",245,"2022-10-18","39839994197598600/covers/e98be077dd834e5d50a1bfda244f88bbe3f99bc1_51770534437872052.jpeg",1],"h":["yamada_and_the_seven_witches","0006/69/568384.png"],"l":[8,15,1,44,11,120,16,117],"st":"f"}}