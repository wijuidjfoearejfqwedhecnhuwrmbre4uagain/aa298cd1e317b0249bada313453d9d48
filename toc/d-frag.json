,[1],"Если бы они были здесь"],["207145094338332179","161.5","19",0,20422,[1],"Продолжение 161 главы"],["207144960842024467","161","18",0,20422,[1],"Это было бы неприлично, десунооо!"],["207145037631342099","160","18",0,20422,[1],"Мы не проиграем!"],["207145005687522835","159","18",0,20422,[1],"Только в этот клуб!"],["207145048083547667","158","18",0,20422,[1],"Пора действовать"],["207144995839297043","157","18",0,20422,[1],"Так вот она какая - Академия Фудзё!"],["141382412021024307","156","18",0,19968,[5]],["221683728236168749","155.5","18",0,20522,[1],"Доп страницы"],["141382389740946995","155","18",0,19968,[5]],["141382367729239603","154","18",0,19968,[5]],["141382347277813299","153","18",0,19968,[5]],["110251778997503516","152","18",0,19753,[5]],["110251752456013340","151.5","17",0,19753,[5]],["110251732088407580","151","17",0,19753,[5]],["110251689860220444","150","17",0,19753,[5]],["110251146043475484","149","17",0,19753,[5]],["110250969664669212","148","17",0,19753,[5]],["110250943626364444","147","17",0,19753,[5]],["110250922084419100","146","17",0,19753,[5]],["215961602011186707","145.5","17",0,20482,[1],"Омакэ"],["66464471215792572","145","17",0,19451,[6],"Заказывайте всё, что душе угодно"],["207145105612621331","144.5","17",0,20422,[1]],["66464470410486204","144","17",0,19451,[6],"Заостренные штуки - крутые"],["66464469991055804","143","17",0,19451,[6],"Балующий щит"],["66464469168972220","142","17",0,19451,[6],"Делить с нами комнату"],["66463862957826492","141","17",0,19451,[6],"Мы должны пожениться и быть вместе навсегда!"],["66463862219628988","140","17",0,19451,[6],"Он бросил его!"],["207145120074581523","139.5","17",0,20422,[1],"Продолжение 139 главы"],["66463861062001084","139","17",0,19451,[6],"Великий тест на храбрость"],["66463643193074108","138.5","17",0,19451,[6],"Ну, знаете, всё хорошее"],["66463310786093500","138","17",0,19451,[3,4],"Всё в порядке!"],["66463090853568956","137","17",0,19451,[8],"Время платить по долгам"],["66461655764066748","136","17",0,19451,[6],"Банда Кадзамы..."],["215958587212580371","135.5","16",0,20482,[1],"Омакэ"],["66461655378190780","135","16",0,19451,[6],"Тут всё ещё есть скрытый босс"],["66461654623216060","134","16",0,19451,[6],"Покажи мне свою силу духа!"],["66461654237340092","133","16",0,19451,[6],"Что за чертовщина?"],["66461653834686908","132","16",0,19451,[6],"Cмахнём его с треском!"],["66461653448810940","131","16",0,19451,[6],"Что вы подразумеваете под «настоящим проклятием»?"],["66461653062934972","130","16",0,19451,[6],"Неплохой огурчик"],["66461651888595388","129","16",0,19451,[6],"Мм, я уже знала это!"],["66461651066446268","128","16",0,19451,[6],"Даже не знаю, ниндзя?"],["66461650244362684","127","16",0,19451,[6],"Это Казама?"],["66461649002848700","126","16",0,19451,[6],"Заря нового мира"],["66461643063714236","125.5","15",0,19451,[6],"Зарисовки глав"],["207144932052321811","125.1","15",0,20422,[1],"Зарисовки глав"],["66461642694615484","125","15",0,19451,[6],"Лето моей юности"],["66461642325516732","124","15",0,19451,[6],"В этом клубе из всех возможных мест"],["66461641553764796","123","15",0,19451,[6],"Моя комната"],["66461640379359676","122","15",0,19451,[6],"Почему бы тебе не сделать этого?"],["66461639976706492","121","15",0,19451,[6],"Я всё улажу"],["66461639590830524","120","15",0,19451,[6],"Мы подельники"],["66461639188177340","119","15",0,19451,[6],"Кто-то другой сделает всё остальное!"],["66461638382870972","118","15",0,19451,[6],"Это не долбаный метеорит!"],["66461637980217788","117","15",0,19451,[6],"Вне нашей компетенции-Харуно Томоя"],["66461637560787388","116","15",0,19451,[6],"Просто идите по очереди!"],["211779503586821658","115.5","14",0,20454,[1],"Омакэ"],["66459647866855868","115","14",0,19451,[7],"Я тоже хочу съесть унаги"],["66459647480979900","114","14",0,19451,[7],"Нет, спасибо"],["66452888225866172","113","14",0,19451,[2],"Это у нас всё плачевно!"],["66452887806435772","112","14",0,19451,[2],"Глава семьи Казама"],["66452887437337020","111","14",0,19451,[2],"У тебя со мной счёты?!"],["66452886665585084","110","14",0,19451,[2],"Как насчёт сувениров?"],["66452886262931900","109","14",0,19451,[2],"Это же пустая трата денег!"],["66452885507957180","108","14",0,19451,[2],"В чём твоя проблема?!"],["66452885105303996","107","14",0,19451,[2],"Ты выбираешь лапшу?!"],["66452883947676092","106","13",0,19451,[2],"Они вареные или запеченные?"],["211778533712741914","105.5","13",0,20453,[1],"Омакэ"],["66397303111442876","105","13",0,19451,[2],"С кучей мяса"],["66397302742344124","104","13",0,19451,[2],"Ты же поранишься!"],["66397302373245372","103","13",0,19451,[2],"Хочешь, правда?"],["66397301987369404","102","13",0,19451,[2],"Лёгкая как пёрышко"],["66397301618270652","101","13",0,19451,[2],"Ох боже!"],["66397301232394684","100","13",0,19451,[2],"AILOVE"],["66397300846518716","99","13",0,19451,[2],"Холодное и ледяное"],["66397300460642748","98","13",0,19451,[2],"Что-нибудь да будет"],["66397300057989564","97","13",0,19451,[2],"Не хочешь немного подработать?"],["66397299655336380","96","13",0,19451,[2],"Ну, она сама виновата..."],["207145017649677843","95.5","12",0,20422,[1],"Омакэ"],["66397299235905980","95","12",0,19451,[2],"У него даже помидор Черри на верхушке......"],["66397298833252796","94","12",0,19451,[2],"ЭТА ШКОЛА ОТСТОЙ!!"],["66397298413822396","93","12",0,19451,[2],"Нам нужно просто собрать все печати, верно?"],["66397297994391996","92","12",0,19451,[2],"Это......ВОСХИТИТЕЛЬНО!"],["66394312656576956","91","12",0,19451,[2],"Мы не позволим тебе принять это одному"],["66394312270700988","90","12",0,19451,[2],"Я хочу обезжиренный креп"],["66394311868047804","89","12",0,19451,[2],"Я дам 40,000 йен!"],["57532547168494002","88","12",0,19389,[0],"Это ещё не факт"],["57354473110004107","87","12",0,19388,[0],"Помощь в создании новых воспоминаний"],["57354278209085835","86.5","11",0,19388,[0],"Омаке"],["57354277286338955","86","11",0,19388,[0],"Ты хочешь Мисо суп?"],["57354271900852619","85","11",0,19388,[0],"Идеальная плоскость"],["57354269552042379","84","11",0,19388,[0],"Мне так понравилась эта поездка!"],["57354268528632203","83","11",0,19388,[0],"Ах, я снова уселась!"],["57354267538776459","82","11",0,19388,[0],"Чего это ты какая-то радостная?!"],["57354264955085195","81","11",0,19388,[0],"Твой отец..."],["57354264401437067","80","11",0,19388,[0],"Только не учиняйте у меня дома погром"],["57353950466171275","79","11",0,19388,[0],"Разве игра не закончится, если выкинуть больше семи?!"],["57353949627310475","78","11",0,19388,[0],"Он сказал, это за счет заведения"],["57353837320626571","77","11",0,19388,[0],"Конечно, можно и харигане"],["57353831817699723","76","11",0,19388,[0],"От этой предыстории за версту несет брехней"],["207144953711707667","75.5","10",0,20422,[1],"Омакэ"],["57353830274195851","75","10",0,19388,[0],"Это что, конец флешбека?!"],["57353719695565195","74","10",0,19388,[0],"Надо было мне открыть ее..."],["57353717296423307","73","10",0,19388,[0],"Alive всемогущ!"],["57353503856681355","72","10",0,19388,[0],"Брешь в защите лысых"],["57353499427496331","71","10",0,19388,[0],"Если честно, по этой же причине я..."],["57353499041620363","70","10",0,19388,[0],"А вот насчет этого вы ошибаетесь"],["57353498269868427","69","10",0,19388,[0],"Мы больше так не будем~"],["57353497464562059","68","10",0,19388,[0],"Это тайна"],["57353496709587339","67","10",0,19388,[0],"Будущее"],["57353495937835403","66","10",0,19388,[0],"Э... п-правда?"],["57353494343999883","65.5","9",0,19388,[0],"Омаке"],["57353493454807435","65","9",0,19388,[0],"Что случилось с твоей личностью?!"],["57353105834008971","64","9",0,19388,[0],"Мне что-то нехорошо!"],["57353099911651723","63","9",0,19388,[0],"Шибасаки здесь!"],["57353098703692171","62","9",0,19388,[0],"А, я же не из клуба"],["57353097478955403","61","9",0,19388,[0],"И чья же это вина?!"],["57353096220664203","60","9",0,19388,[0],"Значит, все-таки она?!"],["57353094542942603","59","9",0,19388,[0],"Держи полотенчико"],["207144975555642899","58.6","8",0,20422,[1],"Омейк"],["207144921365235219","58.5","8",0,20422,[1]],["57352767320121739","58","8",0,19388,[0],"И это тоже судьба геймера..."],["57352759552270731","57","8",0,19388,[0],"К... Кто он?"],["57352757673222539","56","8",0,19388,[0],"Чем займемся?"],["57352756012278155","55","8",0,19388,[0],"Как ты можешь быть такой наивной?!"],["57352753982235019","54","8",0,19388,[0],"Мы всосем свою удачу обратно!"],["57352462914314635","53","8",0,19388,[0],"Э... Это же явный сговор!"],["57352461656023435","52","8",0,19388,[0],"Извиняйте!"],["207144940810028563","51.5","7",0,20422,[1],"Омэйк ① и ②"],["57352459441430923","51","7",0,19388,[0],"Так кайфово!"],["57352456857739659","50","7",0,19388,[0],"Бесполезные... дойки?!"],["57352197867856267","49","7",0,19388,[0],"Достигла вершин мастерства!"],["57352197012218251","48","7",0,19388,[0],"Худшая высота в моей жизни!"],["57352069522153867","47","7",0,19388,[0],"Что за идиотский поворот сюжета?!"],["57352068364525963","46","7",0,19388,[0],"Что ты вдыхаешь?!"],["57352066770690443","45","7",0,19388,[0],"Насладимся юностью на полную катушку!"],["207145004060132883","44.5","6",0,20422,[1],"Омэйк"],["57351875678200203","44","6",0,19388,[0],"Ты обманываешь мою старшую сестру!"],["57351860444488075","43","6",0,19388,[0],"Хыдыщ!"],["57351783789388171","42","6",0,19388,[0],"Встали!"],["57351781524464011","41","6",0,19388,[0],"Такао-семпай, айда с нами!"],["57351781138588043","40","6",0,19388,[0],"Столько всего произошло"],["57351779930628491","39","6",0,19388,[0],"Зови меня тётей"],["57351771441357195","38","6",0,19388,[0],"Полотенце!"],["57351770703159691","37","6",0,19388,[0],"Черт бы тебя побрал, Шон Конкон!"],["207144904520910355","36.6","5",0,20422,[1],"Доп. страницы"],["207144905041004051","36.5","5",0,20422,[1],"Омейк ① и ②"],["57351769176433035","36","5",0,19388,[0],"И добивающим ударом станет..."],["57351767565820299","35","5",0,19388,[0],"Ей и одной играется неплохо"],["57351767146389899","34","5",0,19388,[0],"Он достал нечто удивительное!"],["57351765535777163","33","5",0,19388,[0],"Алмазы нельзя разбить"],["57351764696916363","32","5",0,19388,[0],"Я хочу распустить ваш «временный» клуб разработки игр"],["57351088759660939","31","5",0,19388,[0],"Просто ты слабак"],["57351087652364683","30","5",0,19388,[0],"Плывет себе, покачиваясь"],["57351085806870923","29","5",0,19388,[0],"Легендарная и невероятная Такао-семпай!"],["207144778842785299","28.9","5",0,20422,[1],"Оглавление"],["207144913496720915","28.5","4",0,20422,[1],"Омэйк"],["57351075421774219","28","4",0,19388,[0],"В конце концов, кровные родственники лучше всего!"],["57351073962156427","27","4",0,19388,[0],"Бесишь!"],["57351071714009483","26","4",0,19388,[0],"Водичка!"],["57351070539604363","25","4",0,19388,[0],"Тем лучше!"],["57351069751075211","24","4",0,19388,[0],"Поразительна"],["57350922581336459","23","4",0,19388,[0],"Я такая жалкая"],["57350920719065483","22","4",0,19388,[0],"Растущая проблема"],["57350919997645195","21","3",0,19388,[0],"Или я тебя не прощу"],["57350917598503307","20","3",0,19388,[0],"Кого бы ты выбрал?"],["57350916004667787","19","3",0,19388,[0],"Я не хочу, чтобы ты победил!"],["57350249982747019","18","3",0,19388,[0],"Давай сразимся!"],["57350243120865675","17","3",0,19388,[0],"Враг приближается!"],["57350241577361803","16","3",0,19388,[0],"Такой классный!"],["57350239597650315","15","3",0,19388,[0],"Что это?!"],["57350238372913547","14.5","2",0,19388,[0],"Омэйк"],["57350237131399563","14","2",0,19388,[0],"Это должен сделать я!"],["57349904304988555","13","2",0,19388,[0],"Ты все никак не сдаешься?!"],["57349798021325195","12","2",0,19388,[0],"Я в этом уверена"],["57349748796973451","11","2",0,19388,[0],"Это же очевидно"],["57349746431385995","10","2",0,19388,[0],"Это я"],["57349644845343115","9","2",0,19388,[0],"Думаю, пора начинать собрание"],["57349642899186059","8","2",0,19388,[0],"Ты ведь тоже хочешь сделать «это»... Не так ли?"],["57349431372046731","7","1",0,19388,[0],"Да начнётся же состязание!"],["57349429308449163","6","1",0,19388,[0],"Так намного интереснее?"],["57349286500786571","5","1",0,19388,[0],"Я все ещё думаю над этим"],["57349284068090251","4","1",0,19388,[0],"Первый раз видим!"],["57349283246006667","3","1",0,19388,[0],"Хватит и минуты"],["57349281601839499","2","1",0,19388,[0],"Приятно познакомиться"],["57349006220616075","1","1",0,19388,[0],"Клан Казамы!"]],"w":{"n":["Дефрагментация!","Адский ад!","D-Frag!","ディーふらぐ！","D-Fragments!"],"t":"manga","p":7357,"s":["d-frag",210,"2026-09-14","57347592253628811/covers/9078d2a3fe4169c5f074b193e0aeebddf0437be4_141381755780220465.jpeg",1],"d":["d-frag",885],"h":["d_frag","0008/44/743024.jpeg"],"l":[156,15,62,8,1],"st":"o"}}