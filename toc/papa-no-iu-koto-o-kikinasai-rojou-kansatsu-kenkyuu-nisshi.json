{"slug":"papa-no-iu-koto-o-kikinasai-rojou-kansatsu-kenkyuu-nisshi","m":"39899592707301768","at":"2026-10-15","b":["39899592707367304"],"t":[["39804024769241531","Rikudou-Sennin Clan"]],"c":[["63355458777276861","32","4",0,19430,[0],"Райка — от колыбели до «бииип»?! Часть 2"],["63354489490399677","31","4",0,19430,[0],"Райка — от колыбели до «бииип»?! Часть 1"],["63354488148222397","30","4",0,19430,[0],"А мама-то не в курсе?!"],["63353472807887293","29","4",0,19430,[0],"Тайное свидание?!"],["63353132901491133","28","4",0,19430,[0],"На горячих источниках!"],["63353132230402493","27","3",0,19430,[0],"Победа от сердца!"],["63353131559313853","26","3",0,19430,[0],"Раика и шипастый цветник"],["63352977259258301","25","3",0,19430,[0],"Неофициальная битва началась"],["63352976923713981","24","3",0,19430,[0],"Лучшее гостеприимство"],["63352976604946877","23","3",0,19430,[0],"Карате-девчонка"],["63352976286179773","22","3",0,19430,[0],"Мы едем в Икебукуро!"],["63352975950635453","21","3",0,19430,[0],"Конкурс красоты!"],["63352975615091133","20","3",0,19430,[0],"Добро пожаловать в традиционный отель Райки!"],["63352975279546813","19","3",0,19430,[0],"И замерло сердце в непроглядной тьме..."],["63352974927225277","18","2",0,19430,[0],"Всё благодаря вам!"],["63352974591680957","17","2",0,19430,[0],"Всё во имя искусства!"],["63352974256136637","16","2",0,19430,[0],"Сердце, от чего ты так болишь?"],["63352973903815101","15","2",0,19430,[0],"Ценность дружбы"],["63352973551493565","14","2",0,19430,[0],"Бенто, приготовленное с любовью"],["63352973199172029","13","2",0,19430,[0],"Райка-сама на прицеле!"],["63352972830073277","12","2",0,19430,[0],"Чрезвычайно опасная практика"],["63352972460974525","11","2",0,19430,[0],"О чём же ты думаешь, райка-сан?!"],["63352972108652989","10","2",0,19430,[0],"Появление трёх сестрёнок"],["63352971722777021","9","2",0,19430,[0],"А всё потому, что его здесь нет!"],["63352971353678269","8","1",0,19430,[0],"Путь к признанию!"],["63352970934247869","7","1",0,19430,[0],"Неизвестный доселе Юта!"],["63352970548371901","6","1",0,19430,[0],"Что такое дружба?"],["63352056441758141","5","1",0,19430,[0],"Быстрое завоевание"],["63352055770669501","4","1",0,19430,[0],"Испуганный котёнок!"],["63352055066026429","3","1",0,19430,[0],"Появление соперницы на любовном фронте!"],["63352054025839037","2","1",0,19430,[0],"Ну, пошли в И.С.?!"],["63352053639963069","1","1",0,19430,[0],"Провальный дебют!"]]}