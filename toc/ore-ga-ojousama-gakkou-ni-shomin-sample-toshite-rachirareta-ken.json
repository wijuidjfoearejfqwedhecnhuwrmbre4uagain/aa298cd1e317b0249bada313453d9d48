{"slug":"ore-ga-ojousama-gakkou-ni-shomin-sample-toshite-rachirareta-ken","m":"63631889801437577","at":"2026-10-15","b":["63631889801503113"],"t":[["45241483413971349","Unnamed Manga"],["52103979642937739","Revolt Squad"],["55033449362252196","KIPch Team"],["61588513006576012","mrBadGuy&EviLF"],["63631711140864393","Funsea"]],"c":[["63643854204592521","81","15",0,19432,[4,2],"К-Куда ты смотришь?!"],["63643853197959561","80","15",0,19432,[4,2],"Она была в совершенно другой лиге, чем я"],["63643850798817673","79","15",0,19432,[4,2],"Маи Маи"],["63643450041459081","78","15",0,19432,[4,2],"Точнее, я хочу их увидеть"],["63643449320038793","77","15",0,19432,[4,2],"Я была запятнана Кимито"],["63643196353175945","76","14",0,19432,[4,2],"И все же у нас только что был действительно хороший разговор"],["63643196017631625","75","14",0,19432,[4,2],"Я все еще одета там, внизу!!"],["63643195346542985","74","14",0,19432,[4,2],"Я уверен в этом"],["63643194994221449","73","14",0,19432,[4,2],"Во славу твою"],["63643194641899913","72","14",0,19432,[4,2],"У них будет много детей!!"],["63643194289578377","71","14",0,19432,[4,2],"Блин~ Теперь я уже не знаю, что делать"],["63643193937256841","70.5","13",0,19432,[4,2],"Экстра: Эпилог"],["63643193584935305","70","13",0,19432,[4,2],"Стихии?!"],["63643193249390985","69.5","13",0,19432,[4,2],"Экстра: Разговор харизматичный матери и неуклюжей дочери"],["63643192880292233","69","13",0,19432,[4,2],"Я промокла"],["63643192511193481","68","13",0,19432,[4,2],"Как только я вспотею..."],["63643191018021257","67","13",0,19432,[4,2],"Теперь... Я вспомнил"],["63642175023374729","66","13",0,19432,[4,2],"Земля Ханаанская"],["63642072883683721","65.5","12",0,19432,[2,4],"Экстра: Специальная глава"],["63642067934405001","65","12",0,19432,[2,4],"Пенал, который вы ищете, лежит на столе"],["63642066491564425","64","12",0,19432,[2,4],"Расслабляющая ночь"],["63642065770144137","63","12",0,19432,[2,4],"Звезды"],["63642064713179529","62","12",0,19432,[2,4],"На ком ты женишься?"],["63642063622660489","61","12",0,19432,[2,4],"Воспоминания возвращаются"],["63641231959286153","60","12",0,19432,[2],"Боже мой!"],["63639122912240009","59","11",0,19432,[4],"AUFHEBUNG"],["63639012333609353","58","11",0,19432,[4],"Как буря"],["63639011612189065","57","11",0,19432,[4],"Бамбук!!!"],["63639010890768777","56","11",0,19432,[4],"Дамские твиты"],["63639009649254793","55","11",0,19432,[4],"Закати глаза как надо!"],["63639008911057289","54","10",0,19432,[4],"Когда все на миг остановилось"],["63639008139305353","53","10",0,19432,[4],"Как же я могу оставить тебя..."],["63638430331986313","52","10",0,19432,[4],"Боже мой! Молодость прекрасна"],["63638353274233225","51","10",0,19432,[4],"Легендарный феникс вылупился из яйца!"],["63638352217268617","50","10",0,19432,[4],"Пора нам послушать, что вы скажете"],["63638350036230537","49","9",0,19432,[4],"Ибо там, будет разворачиваться неприемлемое действо"],["63638345539936649","48","9",0,19432,[4],"Да здравствует «союз цветущей розы»"],["63638344097096073","47","9",0,19432,[4],"Такое чувство, будто передо мной два платиновых слитка"],["63638342989799817","46","9",0,19432,[4],"Я сейчас с наполовину спущенными трусами!"],["63638341513404809","45","9",0,19432,[4],"Девушка, стоящая за моей спиной"],["63638340758430089","44","9",0,19432,[4],"Трусишка Рэйко"],["63638339600802185","43","8",0,19432,[4],"Это последний кролик"],["63637409522278793","42","8",0,19432,[4],"Июньский свадебный бал"],["63637348369326473","41","8",0,19432,[4],"На белом коне"],["63637225308447113","40","8",0,19432,[4],"В великом вихре комплементации"],["63637029199569289","39","7",0,19432,[4],"Азиатский моллюск"],["63637028092273033","38","7",0,19432,[4],"Вам понравится"],["63636946202681737","37","7",0,19432,[4],"Это так по-гейски"],["63636941706387849","36","7",0,19432,[4],"Спокойный выходной с Хакуа"],["63636941354066313","35","7",0,19432,[4],"Не то, чтобы у меня было к тебе какое-то важное дело..."],["63636941001744777","34","7",0,19432,[4],"Будь ты проклята, тугоухая девчонка!"],["63636940615868809","33","7",0,19432,[4],"Совсем как ниндзя в американском представлении"],["63636940263547273","32","6",0,19432,[4],"Мне придется...изводить Вас до тех пор, пока Вы не разведетесь"],["63636939911225737","31","6",0,19432,[4],"Все совсем наоборот!"],["63636939542126985","30","6",0,19432,[4],"Мы пойдем вместе"],["63636939173028233","29","6",0,19432,[4],"Разве небо, на которое ты смотрел, отличается от этого, Кимито-сама?"],["63636938434830729","28.5","6",0,19432,[4],"Экстра: Я один раз попробовал воспользоваться голубиной почтой"],["63636938015400329","28","6",0,19432,[4],"Меня уже давно мучает один вопрос, что такое «попался»?"],["63636937260425609","27","5",0,19432,[4],"Бежать так быстро, чтобы ваша юбка вся помялась"],["63636936874549641","26","5",0,19432,[4],"Кагурадзака-сан ушел!!"],["63636936488673673","25","5",0,19432,[4],"Чего это она ни с того ни с сего(вдруг) решила покрасоваться своими навыками?"],["63636936102797705","24","5",0,19432,[4],"Aйка-сама, у вас много друзей"],["63636935700144521","23","5",0,19432,[4],"Незрелый горох-незрелые соевые бобы"],["63636935314268553","22","4",0,19432,[4],"Быстрое утро для старшей горничной"],["63636934894838153","21","4",0,19432,[4],"Главная особенность мисс Тсун-пур"],["63634947197395337","20","4",0,19431,[0],"Я верю, что это сбудется"],["63634618363961737","19","4",0,19431,[1],"Йогасим не для новичков"],["63634617659318665","18","4",0,19431,[1],"Сейчас же покажись!"],["63634121137611145","17","4",0,19431,[1],"Кто-нибудь, пожалуйста, составьте пару Тенкуубаши-сан"],["63634120432968073","16","3",0,19431,[1],"Моя жизнь стоит так дёшево?!"],["63634120063869321","15","3",0,19431,[1],"Большой случай"],["63633944540635529","14","3",0,19431,[1],"Только друзья"],["63633944171536777","13","3",0,19431,[1],"Сегодня обычный выходной с Хакуей"],["63633763581583753","12","3",0,19431,[1],"Тогда... Может, разденем его?"],["63633740177367433","11","3",0,19431,[1],"Любовь+Девушка"],["63633739808268681","10","2",0,19431,[1],"Одиночка против нормалфага"],["63633739472724361","9","2",0,19431,[1],"Вечеринка простолюдинов"],["63633739137180041","8","2",0,19431,[1],"Происшествие на чаепитии"],["63633738784858505","7","2",0,19431,[1],"Заседание клуба любителей простолюдинов"],["63633738432536969","6","2",0,19431,[1],"Как будто я признаю своё поражение"],["63633738080215433","5","2",0,19431,[1],"Это Хакуа-сама?!"],["63633737711116681","4","1",0,19431,[1],"Попался!"],["63632996594377097","3","1",0,19431,[1],"Чистые сердцем девы"],["63632369663369609","2","1",0,19431,[3],"Поцелуй меня!"],["63632369311048073","1","1",0,19431,[3],"Приветствуем, простолюдин"]]}