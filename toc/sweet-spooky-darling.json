{"slug":"sweet-spooky-darling","m":"40112233467896193","at":"2026-10-15","b":["40112233467961729"],"t":[["40098855584293249","Rescue Team"]],"c":[["80364005020950922","78","1",0,19547,[0],"Она нашла своё счастье?"],["80363986616344970","77","1",0,19547,[0],"Если бы произошло чудо…"],["80363985056063882","76","1",0,19547,[0],"Давай однажды встретимся снова…"],["80363984569524618","75","1",0,19547,[0],"Позволь мне остаться с тобой…"],["80363983680332170","74","1",0,19547,[0],"Чувство, которое я не могу забыть"],["80363982740808074","73","1",0,19547,[0],"Тогда не останавливай нас"],["80363981784506762","72","1",0,19547,[0],"Мои чувства бесполезны"],["80363981348299146","71","1",0,19547,[0],"Я знаю, что мне нужно действовать осторожно"],["80363980358443402","70","1",0,19547,[0],"Кого ты называешь идиоткой?"],["80363979402142090","69","1",0,19547,[0],"С каких пор ты…"],["80363978445840778","68","1",0,19547,[0],"Лжец"],["80363964168429962","67","1",0,19547,[0],"Видишь? Ты давно обо всём знала"],["80363963681890698","66","1",0,19547,[0],"Словно сон"],["80363962171941258","65","1",0,19547,[0],"Давно не виделись"],["80363960846541194","64","1",0,19547,[0],"Я поймал тебя…"],["80363960376779146","63","1",0,19547,[0],"Я хочу покончить с этим"],["80363958363513226","62","1",0,19547,[0],"Было бы лучше, если бы ты не был таким милым"],["80363957776310666","61","1",0,19547,[0],"Как печально"],["80363957155553674","60","1",0,19547,[0],"Разве мы не можем просто забыть о прошлом?"],["80363956635459978","59","1",0,19547,[0],"Я буду ждать тебя"],["80363956148920714","58","1",0,19547,[0],"Я просто привыкла к этому"],["80363955595272586","57","1",0,19547,[0],"Что-то случилось?"],["80363954739634570","56","1",0,19547,[0],"Забудь обо мне"],["80363952827031946","55","1",0,19547,[0],"Это не так легко сказать, понимаешь?"],["80363952256606602","54","1",0,19547,[0],"Ты разочарована? Или чувствуешь облегчение?"],["80363950780211594","53","1",0,19547,[0],"Я не могу перестать присматривать за ним"],["80363950260117898","52","1",0,19547,[0],"Это к лучшему"],["80363936452469130","51","1",0,19547,[0],"Я... признался?"],["80363936033038730","50","1",0,19547,[0],"У меня нет времени?"],["80363935177400714","49","1",0,19547,[0],"Ты ревнуешь?"],["80363934707638666","48","1",0,19547,[0],"Редкое зрелище"],["80363933852000650","47","1",0,19547,[0],"Ненавижу..."],["80363933415793034","46","1",0,19547,[0],"Потому что ты боишься призраков…"],["80363932358828426","45","1",0,19547,[0],"Прости меня..."],["80363931503190410","44","1",0,19547,[0],"Ты ничем не можешь помочь"],["80363930144235914","43","1",0,19547,[0],"Наверное, я просто слегка испугалась"],["80363929573810570","42","1",0,19547,[0],"Это не то, что я имела в виду!"],["80363926688129418","41","1",0,19547,[0],"Могут ли призраки простужаться?"],["80363926218367370","40","1",0,19547,[0],"Он сумасшедший?"],["80363925312397706","39","1",0,19547,[0],"Разве для каждого это не по-своему?"],["80363924423205258","38","1",0,19547,[0],"Сон?"],["80362870008734090","37","1",0,19547,[0],"Я понял"],["80362868280680842","36","1",0,19547,[0],"Разве это не обман?"],["80362866787508618","35","1",0,19547,[0],"Ты не ошиблась…"],["80362861402022282","34","1",0,19547,[0],"Потому что она влюблена в тебя"],["80362859841741194","33","1",0,19547,[0],"Неуклюжий человек…"],["80362858633781642","32","1",0,19547,[0],"Я могу быть…немного опасен"],["80362858214351242","31","1",0,19547,[0],"Я буду по тебе скучать"],["80362857174163850","30","1",0,19547,[0],"30 Было бы совершенно естественно, если бы я исчез в любой момент"],["80362856553406858","29","1",0,19547,[0],"Где-то я это уже слышала"],["80362856117199242","28","1",0,19547,[0],"Я…хочу домой"],["80362855060234634","27","1",0,19547,[0],"Хотя бы попрощайся"],["80362854439477642","26","1",0,19547,[0],"Можно пригласить тебя на ужин?"],["80362853516730762","25","1",0,19547,[0],"Не желая принимать советы"],["80362852593983882","24","1",0,19547,[0],"Кто ты?"],["80362851620905354","23","1",0,19547,[0],"Делай, что хочешь"],["80362849725079946","22","1",0,19547,[0],"Я не хочу быть один"],["80362848886219146","21","1",0,19547,[0],"Сделаем вид, что ничего не видели"],["80362847896363402","20","1",0,19547,[0],"Кого ты возьмешь с собой?"],["80362846671626634","19","1",0,19547,[0],"Кто виноват?"],["80362846235419018","18","1",0,19547,[0],"Ты боишься меня?"],["80362845664993674","17","1",0,19547,[0],"Что этот придурок здесь делает?"],["80362436988789130","16","1",0,19547,[0],"Хм-м?"],["80362436569358730","15","1",0,19547,[0],"Запах твоих духов"],["80362435646611850","14","1",0,19547,[0],"Ты прям сталкер"],["80362435176849802","13","1",0,19547,[0],"Ты с ума сошёл! Безумец!"],["80362434321211786","12","1",0,19547,[0],"Ты серьёзно туда пойдёшь?"],["80362433650123146","11","1",0,19547,[0],"Кто виноват?"],["80362433213915530","10","1",0,19547,[0],"Мне всё о тебе интересно"],["80362432727376266","9","1",0,19547,[0],"Ты что, плачешь?"],["80362432224059786","8","1",0,19547,[0],"Разве он не игрок?"],["80362431368421770","7","1",0,19547,[0],"Мы снова встретились"],["80362218096451978","6","1",0,19547,[0],"Сладких снов"],["80362211821773194","5","1",0,19547,[0],"Это вроде как нормально?"],["80362211284902282","4","1",0,19547,[0],"Иди сюда и ложись"],["80362210781585802","3","1",0,19547,[0],"Похоже, тебе весело?"],["80362209472962954","2","1",0,19547,[0],"Как тебя зовут?"],["80362208885760394","1","1",0,19547,[0],"Ты… видишь меня?"]],"w":{"n":["Милый, Жуткий, Дорогая","Sweet Spooky Darling","スウィート・スプーキー・ダーリン","甜蜜幽灵男友","스윗스푸키달링","Mon Coloc le fantôme","SS Darling","SS Darlingle"],"t":"manhwa","p":2614,"s":["sweet-spooky-darling",78,"2023-07-09","40112233467896193/covers/793eaf0667a9553b24096888d12f2c62d831b563_80361445186888074.jpeg",1],"d":["sweet-spooky-darling",6153],"h":["sweet_spooky_darling","0018/87/1786965.jpeg"],"l":[8,16,1,22,58],"st":"f"}}