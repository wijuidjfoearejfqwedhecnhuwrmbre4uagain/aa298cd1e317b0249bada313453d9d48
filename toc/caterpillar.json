{"slug":"caterpillar","m":"74639817966641556","at":"2026-10-15","b":["74639817966707092"],"t":[["46247178997358990","Flaming Rose"],["74485247311372735","Kurogitsune"],["74646688203039124","Z4lupaTEAM"],["74651755224261012","AuroraTeam"]],"c":[["214365360957179418","97","11",0,20471,[1],"Никогда не полагайся на других."],["214365360218981914","96","11",0,20471,[1],"Это был сон."],["209720788390004250","95","11",0,20439,[1],"Что ты хотел сказать?"],["209720770874590746","94","11",0,20439,[1],"Спасибо, что позаботились о моём отце."],["205307911105168915","93","11",0,20409,[1],"Если не хочешь умереть, гони на полную."],["205307910551520787","92","11",0,20409,[1],"Сестра"],["200815353821939242","91","11",0,20378,[1],"Так и должно было случиться."],["200815351758341674","90","11",0,20378,[1],"Заткнись."],["200815349493417514","89","10",0,20378,[1],"Я умерла 10 лет назад."],["195745334796764691","88","10",0,20343,[1],"Мика."],["195745334276670995","87","10",0,20343,[1],"Всё в конечном счёте обратится в атомы."],["192036744772732435","86","10",0,20317,[1],"В чём сила имомуши."],["192036743900317203","85","10",0,20317,[1],"Как ты вообще выживала до сих пор."],["185892093154051629","84","10",0,20275,[1],"Что за невероятная мощь."],["185892092466185773","83","10",0,20275,[1],"Привет"],["182019874959148582","82","10",0,20248,[1],"Перед лицом истинного искусства всё остальное - сущий пустяк."],["182019871855363622","81","10",0,20248,[1],"Я всё ещё нахожусь в стадии роста."],["176347164379727387","80","10",0,20209,[1],"Живи"],["176347161225610779","79","10",0,20209,[1],"Я не уступлю звание сильнейшей"],["172470121208499424","78","9",0,20182,[1],"Я искажена."],["172470120419970272","77","9",0,20182,[1],"По какой-то причине я чувствую убийственное намерение"],["167525054727343354","76","9",0,20148,[1],"Геркулес."],["167525054022700282","75","9",0,20148,[1],"Я даже не хочу говорить об этом."],["162321391704624358","74","9",0,20112,[1],"Почему бы тебе не раздеться?"],["162321391016758502","73","9",0,20112,[1],"Давай сойдём с ума."],["157252487525451324","72","9",0,20077,[1],"У меня есть сестра"],["157252478750967356","71","9",0,20077,[1],"Почему ты."],["154315010124826160","70","9",0,20057,[1],"Я покажу тебе."],["154315009470514736","69","9",0,20057,[1],"Ко мне невозможно прикоснуться."],["149998432533104161","68","8",0,20027,[1],"Мне, похоже, придётся тебя убить."],["145941694959863310","67","8",0,19999,[1],"Я могу убить инструктора."],["145941694490101262","66","8",0,19999,[1],"Моя сестра придёт."],["140718800986195507","65","8",0,19963,[1],"Это просто не имеет смысла."],["140718800466101811","64","8",0,19963,[1],"Я оскверню твою чистоту ❤"],["135803561341634104","63","8",0,19929,[1],"Это всё что ты можешь?"],["135803560871872056","62","8",0,19929,[1],"Сила это всё."],["131012041199601199","61","8",0,19896,[1],"Шутки кончились"],["131012040662730287","60","8",0,19896,[1],"Мы уже \"Насекомые\""],["126224491922605588","59","7",0,19863,[1],"Что-то не так"],["121989629372024377","58","7",0,19834,[1],"Я просто проходящий мимо иллюстратор."],["121989628868707897","57","7",0,19834,[1],"Я не собираюсь никому проигрывать."],["116659425254589972","56","7",0,19797,[1],"Это моя специальность"],["116659424818382356","55","7",0,19797,[1],"Ты когда-нибудь задумывалась, ради чего ты живешь?"],["112624839075841564","54","7",0,19769,[1],"Давай поиграем в доктора ❤"],["112624837582669340","53","7",0,19769,[1],"Поиграй с нами"],["108267761284702637","52","7",0,19739,[1],"Я не злюсь."],["108267753030312365","51","7",0,19739,[1],"«Кабутомуши» слаба"],["104339484857885057","50","6",0,19712,[1],"Самый смертоносный страж"],["104339484170019201","49","6",0,19712,[1],"\"Маскировка\""],["100685409075356050","48","6",0,19687,[1],"Я не позволю тебе сбежать."],["100685398790922642","47","6",0,19687,[1],"Ты переродишься как \"Насекомое\""],["95938334529970620","46","6",0,19654,[1],"Он меня точно убьёт."],["95938334110540220","45","6",0,19654,[1],"Превратись из \"Насекомого\" обратно в \"Собаку\"."],["91578524552421777","44","6",0,19624,[1],"Я должен убедиться, что отношения \"хозяин-раб\" чётко определены"],["86366554979066261","43","6",0,19588,[1],"\"Кабуто-слайд\""],["82606133574918561","42","6",0,19562,[1],"\"Всегда помни\""],["78104469551735194","41","5",0,19531,[1],"Я убью эту девку"],["74653032591155604","40","5",0,19508,[1],"Не дави на меня"],["74652821013684628","39","5",0,19508,[1],"Моя личная игрушка"],["74652820594254228","38","5",0,19508,[1],"Давай решим, кто сильнее"],["74652681158812052","37","5",0,19508,[1],"Ты провалилась ♥"],["74652248340193684","36","4",0,19508,[3],"Сильнейшая?"],["74652247501332884","35","4",0,19508,[3],"Таракана ни за что не догнать"],["74652246679249300","34","4",0,19508,[3],"Это немного неразумно"],["74652245823611284","33","4",0,19508,[3],"Как же прекрасно быть руководителем!"],["74648053096669588","32","4",0,19507,[2],"Правда всегда жестока"],["74648052677239188","31","4",0,19507,[2],"Быстрейший на поле боя"],["74648052224254356","30","4",0,19507,[2],"Никакого уважения к старшим"],["74648051804823956","29","4",0,19507,[2],"Идеальная добыча"],["74648051385393556","28","4",0,19507,[2],"Пожалуйста, не убивай меня"],["74648050949185940","27","4",0,19507,[2],"Это бесполезно"],["74648050462646676","26","4",0,19507,[2],"Сестричка точно меня отругает!"],["74648049959330196","25","4",0,19507,[2],"Веселье начинается"],["74648049523122580","24","3",0,19507,[2],"Я не проигрываю"],["74648049070137748","23","3",0,19507,[2],"Безумно влюблена"],["74644438881690004","22","3",0,19507,[0],"Настоящее веселье только начинается"],["74644437623398804","21","3",0,19507,[0],"Наслаждайтесь шоу от всего сердца"],["74644435878568340","20","3",0,19507,[0],"Не забудь"],["74644433680753044","19","3",0,19507,[0],"Найти оригинал"],["74644429218013588","18","3",0,19507,[0],"Это подделка"],["74644428412707220","17","3",0,19507,[0],"Используй все свое тело"],["74644427557069204","16","2",0,19507,[0],"Так не честно!"],["74644426282000788","15","2",0,19507,[0],"Всего лишь детская игра"],["74644425426362772","14","2",0,19507,[0],"Не впечатляющее оружие"],["74644424553947540","13","2",0,19507,[0],"Идеально"],["74644423681532308","12","2",0,19507,[0],"Давай убьем"],["74644422775562644","11","2",0,19507,[0],"Это ты слабачка"],["74644421869592980","10","2",0,19507,[0],"Если хочешь, я скажу"],["74644420946846100","9","2",0,19507,[0],"Вот, что я думаю"],["74643024763707796","8","2",0,19507,[0],"Рискну жизнью, но спрошу"],["74642902088704404","7","1",0,19507,[0],"Стань моим псом"],["74642901199511956","6","1",0,19507,[0],"Одна семья"],["74642900763304340","5","1",0,19507,[0],"Ничего уже не вернуть?"],["74642899907666324","4","1",0,19507,[0],"Это и есть гусеница"],["74642899035251092","3","1",0,19507,[0],"Сильнейший в мире убийца"],["74642898078949780","2","1",0,19507,[0],"Так же, как твою сестру"],["74642897609187732","1","1",0,19507,[0],"Таковы правила"]],"w":{"n":["Гусеница","Caterpillar","キャタピラー","Imomushi","After School","芋虫","애벌레"],"t":"manga","p":6168,"s":["caterpillar",97,"2026-01-18","74639817966641556/covers/fcdf67b5e9a672ec9ca4a33a3b1a2467f0a0419e_74639883884323220.jpeg",1],"d":["caterpillar",6924],"h":["caterpillar","0027/28/2627689.jpg"],"x":1,"l":[24,120,62],"st":"f"}}