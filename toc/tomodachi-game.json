"62449623129678268","96","20",0,19423,[0],"Суд диктатора"],["61389161579438504","95","20",0,19416,[0],"Особенный друг"],["59864544540909976","94","20",0,19405,[0],"Установление справедливости"],["59864535648985496","93","19",0,19405,[0],"Подозреваемый в убийстве"],["59864534877233560","92","19",0,19405,[0],"Союзник правосудия"],["59864534491357592","91","19",0,19405,[0],"Семена сомнения"],["59864534088704408","90","19",0,19405,[0],"Обмен паролями"],["59864533635719576","89","19",0,19405,[0],"Игра без друзей"],["59864533233066392","88","18",0,19405,[0],"Последняя игра"],["59864532796858776","87","18",0,19405,[0],"Это последний шанс"],["59864532360651160","86","18",0,19405,[0],"Те, кто выжили"],["59864531941220760","85","18",0,19405,[0],"Время принять решение"],["59864531505013144","84","18",0,19405,[0],"Все совсем иначе"],["59864531068805528","83","17",0,19405,[0],"Пустая трата времени"],["59864530632597912","82","17",0,19405,[0],"А теперь умри"],["59864528971653528","81","17",0,19405,[0],"Единственно верный выбор"],["59864528501891480","80","17",0,19405,[0],"Убийство игрока"],["59862318439227800","79","17",0,19405,[0],"Бессонная ночь"],["59862318070129048","78","16",0,19405,[0],"Это действительно прощание"],["59862314328809880","77","16",0,19405,[0],"Юичи такой страшный..."],["59862313909379480","76","16",0,19405,[0],"Это последний раз"],["59862313523503512","75","16",0,19405,[0],"Ты никогда не меняешься"],["59862313154404760","74","16",0,19405,[0],"Давайте жить дружно"],["59862312751751576","73","16",0,19405,[0],"Ты все видела?"],["59862312332321176","72","15",0,19405,[0],"Ты не сделаешь этого"],["59862311929667992","71","15",0,19405,[0],"Идеальный шанс"],["59862311225024920","70","15",0,19405,[0],"Он... Демон."],["59862310805594520","69","15",0,19405,[0],"Очевидно, первым из игры вылетит... Шиномия Кей."],["59862310386164120","68","14",0,19405,[0],"Он - худший из лжецов."],["59862309798961560","67","14",0,19405,[0],"Я собираюсь заставить вас поубивать друг друга"],["59862309312422296","66","14",0,19405,[0],"Я собираюсь заполучить вас всех"],["59862308892991896","65","14",0,19405,[0],"Специальный метод для победы в гемблинге"],["59862308456784280","64","14",0,19405,[0],"Из того, что я только что подтвердил..."],["59862307987022232","63","14",0,19405,[0],"Игра в монетку на 800 миллионов!!!"],["59862307550814616","62","13",0,19405,[0],"Что ж, ты действительно... собираешься это сделать?"],["59862307097829784","61","13",0,19405,[0],"Это будет хорошая битва"],["59862306611290520","60","13",0,19405,[0],"Возможно, вы зашли слишком далеко."],["59862306124751256","59","13",0,19405,[0],"Продай себя"],["59862305621434776","58","13",0,19405,[0],"Думаешь, ты выиграл?"],["59848730387440024","57","12",0,19405,[0],"В глубине души ты никому не доверяешь..."],["59848729598910872","56","12",0,19405,[0],"...Похоже, я победил."],["59848727954743704","55","12",0,19405,[0],"Каждый может последовать за ним"],["59848725756928408","54","12",0,19405,[0],"Очевидно, это ваше поражение."],["59848221098271128","53","12",0,19405,[0],"Я бы сказал, что её слабость – это ты, Кей-кун."],["59848218900455832","52","11",0,19405,[0],"Я хочу, чтобы вы объединились с нами."],["59848216383873432","51","11",0,19405,[0],"Что ж... Давайте сохраним это в секрете."],["59848214974587288","50","11",0,19405,[0],"Я ставлю 10 миллионов йен"],["59848213951177112","49","11",0,19405,[0],"«Взрослая игра друзей» номер два, «игра на все ставки», начинается!!!"],["59848212910989720","48","11",0,19405,[0],"Пожалуйста, продайте ваших друзей!"],["59847623510614424","47","10",0,19405,[0],"Игра закончилась успешным побегом"],["59847575058014616","46","10",0,19405,[0],"У меня для тебя важные новости."],["59847573984272792","45","10",0,19405,[0],"Раз вы все так хорошо ладите..."],["59847412671340952","44","10",0,19405,[0],"Твоё изгнание уже определенно."],["59847411698262424","43","10",0,19405,[0],"Сегодня у меня для вас головокружительное объявление."],["59847410255421848","42","9",0,19405,[0],"Мы никогда не думали. что такое может произойти."],["59847408309264792","41","9",0,19405,[0],"Так изгоните его."],["59847069493387672","40","9",0,19405,[0],"Эй, вы слышали о такой игре как [оборотень]?"],["59847068302205336","39","9",0,19405,[0],"Настоящий виновник кто-то другой...?!"],["59846760792613272","38","9",0,19405,[0],"Настала пора отчаянно гадать и... Заводить хорошие отношения."],["59846760037638552","37","8",0,19405,[0],"У меня для вас хорошие новости"],["59846759232332184","36","8",0,19405,[0],"В мире взрослых результаты – это всё."],["59846405887386008","35","8",0,19405,[0],"Заводим хорошие отношения"],["59846262106644888","34","8",0,19405,[0],"Если честно... Я соврал."],["59846260412146072","33","8",0,19405,[0],"Игра окончена... Жизнь Шибе, как человека, заканчивается прямо здесь."],["59846257912340888","32","7",0,19405,[0],"\"Любовь\" или \"деньги\""],["59846256603718040","31","7",0,19405,[0],"Этот взгляд... Ей крышка."],["59846255311872408","30","7",0,19405,[0],"Ты издеваешься над \"судом\"?"],["59846254842110360","29","7",0,19405,[0],"Посмотрим, на что ты способен."],["59846253567041944","28","7",0,19405,[0],"Кем для вас был Шибе Макото?"],["59844148143874456","27","6",0,19405,[0],"Вы же друзья, разве нет?"],["59844146348712344","26","6",0,19405,[0],"Вы можете «Отказаться» от этой игры."],["59844144972980632","25","6",0,19405,[0],"Бумага, бумага, бумага!"],["59844143647580568","24","6",0,19405,[0],"Слабейший и правда победил."],["59844141919527320","23","6",0,19405,[0],"Экстренный выпуск Игры Друзей [Побеждает слабейший] начинается!"],["59844140996780440","22","5",0,19405,[0],"А у тебя правда нет \"важного для тебя человека\"?"],["59844139671380376","21","5",0,19405,[0],"Вам запрещается \"убегать\" или \"рассказывать кому-либо\" об этом."],["59844134805987736","20","5",0,19405,[0],"Перейдем сразу к оглашению итогов"],["59844133849686424","19","5",0,19405,[0],"Третья игра окончена!"],["59844131668648344","18","5",0,19405,[0],"Это определенно можно назвать насилием."],["59844129923817880","17","4",0,19405,[0],"Становится интересно."],["59844128480977304","16","4",0,19405,[0],"Да предавай ты уже быстрее!"],["59844118548865432","15","4",0,19405,[0],"Те, кто \"ищут\", приносите еду тем, кто \"прячется\", хорошо?"],["59844116955029912","14","4",0,19405,[0],"Жди, жди и жди... Игра в которой ты будешь ждать вечно - \"Прятки дружбы\""],["59844116116169112","13","3",0,19405,[0],"У вашей группы \"С\" текущая сумма долга составляет 10,8 млн йен"],["59844114824323480","12","3",0,19405,[0],"Нам придется забрать 20 млн йен ценой твоей жизни"],["59844113968685464","11","3",0,19405,[0],"Как и думал, они не станут дружить с \"убийцей\"."],["59844112643285400","10","3",0,19405,[0],"Это внезапно, но игра заканчивается здесь~"],["59844111284330904","9","3",0,19405,[0],"Я оглашу последнее Злословие"],["59844110378361240","8","3",0,19405,[0],"Юичи-кун, а ты на самом деле такой глупый?"],["59844104372117912","7.6","2",0,19405,[0],"Экстра Неудачник"],["59844103952687512","7.5","2",0,19405,[0],"Экстра"],["59844103130603928","7","2",0,19405,[0],"Шибе, это законно?"],["59844101855535512","6","1",0,19405,[0],"Как и ожидалось, это невероятно"],["59844101436105112","5","1",0,19405,[0],"Я уверен, вам есть, что сказать, не так ли?"],["59844099942932888","4","1",0,19405,[0],"Злословие Сугороку"],["59840749952328088","3","1",0,19405,[2],"Эй, достаточно. Хватит разговоров."],["59840749163798936","2","1",0,19405,[2],"Ответ на этот вопрос - \"ДА\"♥"],["59840636857115032","1","1",0,19405,[2],"А? Юити-кун сомневается в своих друзьях?"],["59840635716264344","0","1",0,19405,[1],"Экстра"]]}