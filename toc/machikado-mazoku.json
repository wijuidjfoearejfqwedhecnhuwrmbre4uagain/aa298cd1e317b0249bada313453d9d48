ации! Новая цель демонессы!"],["75334293307548093","17","2",0,19512,[0],"Проклятый фрукт! Будь осторожен с кислым мандарином!"],["75333835625095594","16","2",0,19512,[0],"Запретная встреча! Даже гуляющая кошка может столкнуться с волшебницей!"],["75333835356660138","15","2",0,19512,[0],"Розовый метод! Круглая шина - колесо фортуны!"],["75333834769457578","14","2",0,19512,[0],"Раскаты грома, удары молнии! Запретный ритуал рода тьмы!"],["75333834182255018","13.9","1",0,19512,[0]],["75333833897042346","13","1",0,19512,[0],"Готовность к завтрашнему дню! Тяжёлый «валик» уже не остановить!"],["75333833259508138","12","1",0,19512,[0],"Первое внедрение! База момо - общественный центр?!"],["75333823176401322","11","1",0,19512,[0],"А предок как всегда! Штурм соседского сна"],["75333818411671978","10.5","1",0,19512,[0]],["75333817925132714","10","1",0,19512,[0],"Новое испытание!?! Сегодня я - демонесса-курьер!"],["75333817455370666","9","1",0,19512,[0],"Искушения торгового района! Одной лишь камере ведомая правда."],["75333810526380458","8","1",0,19512,[0],"Закаляй своё сердце! Новая сила девочки-волшебницы!"],["75333809939177898","7","1",0,19512,[0],"Секрет статуи! Явление предка народу!"],["75333809049985450","6","1",0,19512,[0],"Желание Шамико! Стопроцентные коровы спасут этот мир?!"],["75333808177570218","5","1",0,19512,[0],"Кошмар или удача?! Явление народу подножки для двери клана тьмы."],["75333807238046122","4","1",0,19512,[0],"Бюджеты растут! а расходы на углеводы учитываются?"],["75333806348853674","3","1",0,19512,[0],"Боевой дух?! Мировое течение."],["75333784605581738","2","1",0,19512,[0],"Первая битва! Мой заклятый враг - красавица-одногодка?"],["75333784035156394","1","1",0,19512,[0],"Пробуждение Юко! Демонесса по семейный обстоятельствам!"]],"w":{"n":["Моя соседка - демон","Городская дьяволица","Machikado Mazoku","The Demon Girl Next Door","まちカドまぞく","Street corner demon","街角魔族"],"t":"manga","p":260,"s":["machikado-mazoku",97,"2024-07-26","75328285973701034/cover