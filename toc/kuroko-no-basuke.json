20",0,19388,[0,1],"Сдаться!"],["57365582076469643","172","20",0,19388,[0,1],"Не стой у меня на пути!"],["57365581556375947","171","19",0,19388,[0,1],"Теперь это принадлежит мне!"],["57365576489656715","170","19",0,19388,[0,1],"Я просто убиваю время!"],["57365575986340235","169","19",0,19388,[0,1],"Вот такие дела!"],["57370926643175819","168","19",0,19388,[4],"Все кончено!"],["57370636665774475","167","19",0,19388,[4],"Сделай или умри!"],["57370636279898507","166","19",0,19388,[4],"Победить!"],["57370635860468107","165","19",0,19388,[4],"Меня больше не волнует."],["57370635441037707","164","19",0,19388,[4],"Я хочу увидеть."],["57370635038384523","163","19",0,19388,[4],"Свет Сейрин."],["57370634535068043","162","18",0,19388,[4],"Кто ты?"],["57370633998197131","161","18",0,19388,[4],"Вы просто смотрите на нас свысока!"],["57370633528435083","160","18",0,19388,[4],"Слава Богу, я продолжил играть."],["57370633075450251","159","18",0,19388,[4],"Куда он делся?!"],["57370217956794763","158","18",0,19388,[4],"Я не хочу проигрывать!"],["57370217487098251","157","18",0,19388,[4],"Пожалуйста, выиграй"],["57370217050825099","156","18",0,19388,[4],"Это всего лишь мусор."],["57370216597840267","155","18",0,19388,[4],"Я раздавлю их всех."],["57370216128078219","154","18",0,19388,[4],"Я понял!!.."],["57370215641538955","153","17",0,19388,[4],"Это очевидно"],["57369456791282059","152","17",0,19388,[2],"Щит Эгиды сломлен!"],["57369456287965579","151","17",0,19388,[2],"Я хочу сокрушить их всех!"],["57369455784649099","150","17",0,19388,[2],"Предоставь это нам!"],["57369455231000971","149","17",0,19388,[2],"Это все равно, что пытаться остановить нас с помощью зубочистки!"],["57366748126536075","148","17",0,19388,[2],"Первые очки!"],["57366747707105675","147","17",0,19388,[2],"Я буду защищать ее!"],["57366747270898059","146","17",0,19388,[2],"Давайте остановим их!"],["57366746834690443","145","17",0,19388,[2],"Мяч в игре!"],["57366746348151179","144","16",0,19388,[2],"Не могу дождаться з