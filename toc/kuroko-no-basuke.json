26",0,19389,[2],"Финальный матч начинается!"],["57474199735787910","231","26",0,19389,[2],"Начинается"],["57474195910582662","230","26",0,19389,[2],"Я принимаю твой вызов"],["57474195105276294","229","26",0,19389,[2],"Я иду"],["57474194719400326","228","26",0,19389,[2],"Мы были друзьями все это время!"],["57474194316747142","227","26",0,19389,[2],"Я - Куроко"],["57474193142342022","226","26",0,19389,[2],"Что такое победа?"],["57474192672579974","225","25",0,19389,[2],"Ну и какое у тебя к нему дело?"],["57474192219595142","224","25",0,19389,[2],"Это так здорово"],["57474191330402694","223","25",0,19389,[2],"Я ужасен..."],["57474190894195078","222","25",0,19389,[2],"Мы больше не можем..."],["57474190424433030","221","25",0,19389,[2],"Те...цу...я"],["57474189988225414","220","25",0,19389,[2],"Я забыл..."],["57474189535240582","219","25",0,19389,[2],"Спасибо..."],["57474189031924102","218","25",0,19389,[2],"В любом случае..."],["57474188545384838","217","25",0,19389,[2],"Пошли..."],["57474188092400006","216","24",0,19389,[2],"Мне очень жаль"],["57474187605860742","215","24",0,19389,[2],"Давай постараемся вместе!"],["57474187136098694","214","24",0,19389,[2],"Не могу дождаться!"],["57472235845214598","213","24",0,19389,[2],"Порвите их, как тузик грелку!"],["57472235039908230","212","24",0,19389,[2],"Такое чувство, будто я не проиграю никому"],["57472234637255046","211","24",0,19389,[2],"Прощай"],["57472234217824646","210","24",0,19389,[2],"Я знаю"],["57472226181538182","209","24",0,19389,[2],"Ты сможешь это сделать"],["57472225778884998","208","24",0,19389,[2],"Я в порядке"],["57472224789029254","207","23",0,19389,[2],"Добро пожаловать!"],["57472224369598854","206","23",0,19389,[2],"Как можно скорее"],["57472223933391238","205","23",0,19389,[2],"Я уже и не знаю..."],["57472223497183622","204","23",0,19389,[2],"День с ясным синим небом"],["57472222540882310","203","23",0,19389,[2],"Самый ценный игрок!"],["57472222071120262","202","23",0,19389,[2],"Я и подумать не мог!"],[