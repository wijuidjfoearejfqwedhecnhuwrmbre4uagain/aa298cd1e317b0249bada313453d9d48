 когда он в самой лучшей форме!"],["57365511712825739","116","13",0,19388,[0,1],"Я бы расстроился!"],["57365511209509259","115","13",0,19388,[0,1],"Вырваться вперед"],["57365510689415563","114","13",0,19388,[0,1],"На этот раз мы точно..."],["57365510186099083","113","13",0,19388,[0,1],"Я заставил вас ждать"],["57365509682782603","112","13",0,19388,[0,1],"Мы начинаем серию игр Зимнего Кубка!"],["57365509129134475","111","13",0,19388,[0,1],"Мы приступаем!"],["57365508609040779","110","13",0,19388,[0,1],"Прошу вас, позаботьтесь о нас!"],["57365508105724299","109","13",0,19388,[0,1],"Давно не виделись!"],["57365507568853387","108","12",0,19388,[0,1],"Я устал ждать!"],["57365506998428043","107","12",0,19388,[0,1],"Хватит прикалываться!"],["57365505991795083","106","12",0,19388,[0,1],"Я просто чувствую это"],["57365505354260875","105","12",0,19388,[0,1],"Это доверие"],["57365495841579403","104","12",0,19388,[0,1],"Это ловушка"],["57365494969164171","103","12",0,19388,[0,1],"Вы проиграете!"],["57365493928976779","102","12",0,19388,[0,1],"Именно поэтому я решил!"],["57365492972675467","101","12",0,19388,[0,1],"Я у тебя точно выиграю!"],["57365491949265291","100","12",0,19388,[0,1],"Мы просто не могли не воодушевиться!"],["57365490992963979","99","11",0,19388,[0,1],"Я скоро вернусь!"],["57365490506424715","98","11",0,19388,[0,1],"Слава Богу, что я встретил Вас!"],["57365489365574027","97","11",0,19388,[0,1],"Баскетбольная команда старшей школы Сэйрин!"],["57365488291832203","96","11",0,19388,[0,1],"Сдавайся!"],["57365487285199243","95","11",0,19388,[0,1],"Так давай создадим!"],["57365486647665035","94","11",0,19388,[0,1],"Время для уборки!"],["57365440308994443","93","11",0,19388,[0,1],"Это именно то, чего я хочу!"],["57365439352693131","92","11",0,19388,[0,1],"Время вышло!"],["57365438362837387","91","11",0,19388,[0,1],"Я превзошел это давным-давно!"],["57365437389758859","90","11",0,19388,[0,1],"Давай… Пришло твое время!"],["57365436316017035","89","10",0,19388,[0,1],"Я ждал тебя!"],["57365435208720779","88","10",0,19388,[0,1],"Беги!"],["57365434168533387","87","10",0,19388,[0,1],"Это намного хуже, чем могло бы быть!"],["57365432960573835","86","10",0,19388,[0,1],"Есть только один ответ!"],["57365431735837067","85","10",0,19388,[0,1],"Одного раза достаточно!"],["57360040813683083","84","10",0,19388,[0,1],"Мы, наконец-то здесь!"],["57360039907713419","83","10",0,19388,[0,1],"Объявление войны, пожалуйста!"],["57360038984966539","82","10",0,19388,[0,1],"Давайте повеселимся"],["57359900338053515","81","10",0,19388,[0,1],"Поехали"],["57359897234268555","80","9",0,19388,[0,1],"Взгляни пожалуйста!"],["57359896311521675","79","9",0,19388,[0,1],"На Зимнем Кубке!"],["57359895355220363","78","9",0,19388,[0,1],"Стань моим противником!"],["57359894365364619","77","9",0,19388,[0,1],"Я принял решение!"],["57359893358731659","76","9",0,19388,[0,1],"Скажу, что я его старший брат!"],["57359888443007371","75","9",0,19388,[0,1],"Не ожидал увидеть тебя здесь!"],["57359887553814923","74","9",0,19388,[0,1],"Смотрите, что я нашел!"],["57359886664622475","73","9",0,19388,[0,1],"Они заплатят!"],["57359885741875595","72","9",0,19388,[0,1],"Не говори так, будто можешь победить!"],["57359885305667979","71","9",0,19388,[0,1],"Они монстры!"],["57359884802351499","70","8",0,19388,[0,1],"Не недооценивай меня! + Omake Предупреждение"],["57359884332589451","69","8",0,19388,[0,1],"Что же произойдет!"],["57359883829272971","68","8",0,19388,[0,1],"Я не считаю это странным!"],["57359882839417227","67","8",0,19388,[0,1],"Я перестаю!"],["57359882302546315","66","8",0,19388,[0,1],"Вот небольшое предостережение!"],["57359881715343755","65","8",0,19388,[0,1],"Ты так думаешь?"],["57359881195250059","64","8",0,19388,[0,1],"Все еще не готов!"],["57359880725488011","63","8",0,19388,[0,1],"Я выиграю, даже если умру"],["57359880238948747","62","8",0,19388,[0,1],"Я знаю,что делаю"],["57359877202272651","61","7",0,19388,[0,1],"Пробные прыжки"],["57359876380189067","60","7",0,19388,[0,1],"Не смешите меня"],["57359875524551051","59","7",0,19388,[0,1],"Давайте начнём"],["57359874635358603","58","7",0,19388,[0,1],"Предоставьте это мне!"],["57359869350535563","57","7",0,19388,[0,1],"Не \"хочу\""],["57359868276793739","56","7",0,19388,[0,1],"Отказ"],["57357090171150731","55","7",0,19388,[0,1],"Это талант"],["57357089399398795","54","7",0,19388,[0,1],"Вот за что я его не люблю"],["57357088979968395","53","7",0,19388,[0,1],"Кто ты?"],["57357088157884811","52","6",0,19388,[0,1],"Новый вызов"],["57357086379499915","51","6",0,19388,[0,1],"Я никогда!"],["57357085943292299","50","6",0,19388,[0,1],"Твой баскетбол"],["57356749643997579","49","6",0,19388,[0,1],"Давай сразимся!"],["57356746456326539","48","6",0,19388,[0,1],"Вы все с ума посходили, ребята!"],["57356746003341707","47","6",0,19388,[0,1],"Мы рассчитываем на тебя!"],["57356744661164427","46","6",0,19388,[0,1],"Неплохо, а?"],["57356743788749195","45","6",0,19388,[0,1],"Столкновение"],["57356742866002315","44","6",0,19388,[0,1],"Это не сработает"],["57356741104394635","43","5",0,19388,[0,1],"Понял"],["57356735819571595","42","5",0,19388,[0,1],"Это только начало"],["57356734980710795","41","5",0,19388,[0,1],"Ты имел в виду чай?"],["57356733688865163","40","5",0,19388,[0,1],"Не смеши меня"],["57356732397019531","39","5",0,19388,[0,1],"Они так похожи"],["57356730585080203","38","5",0,19388,[0,1],"Я пришел!"],["57356729695887755","37","5",0,19388,[0,1],"Дураки не выигрывают!"],["57356728789918091","36","5",0,19388,[0,1],"Давайте... сыграем еще"],["57356722666234251","35","5",0,19388,[0,1],"Я верил в тебя!"],["57356721391165835","34","4",0,19388,[0,1],"Вот что я называю \"Человек предполагает\""],["57356720065765771","33","4",0,19388,[0,1],"Вперед"],["57356717834396043","32","4",0,19388,[0,1],"Что значит \"победа\"?"],["57356716441887115","31","4",0,19388,[0,1],"Я выиграю"],["57356715502363019","30","4",0,19388,[0,1],"Я лев"],["57356715015823755","29","4",0,19388,[0,1],"Это еще не конец"],["57355587435913611","28","4",0,19388,[0,1],"Простите"],["57355586697716107","27","4",0,19388,[0,1],"Он ветеран"],["57355580121047435","26","4",0,19388,[0,1],"Это будет проблематично"],["57355579265409419","25","3",0,19388,[0,1],"Ну, тогда..."],["57355578124558731","24","3",0,19388,[0,1],"Я даже умру ради этого"],["57355577839346059","23","3",0,19388,[0,1],"Ради победы"],["57355577017262475","22","3",0,19388,[0,1],"Не беспокойся"],["57330465601773963","21","3",0,19388,[3],"Мы преодолеем это"],["57330465232675211","20","3",0,19388,[3],"Все будет хорошо"],["57329203384705419","19","3",0,19388,[3],"Это снова заставило меня понять"],["57329202629730699","18","3",0,19388,[3],"Давайте посмотрим"],["57329201841201547","17","3",0,19388,[3],"Разве вас это не заводит?"],["57328903273865611","16","2",0,19388,[3],"Мы увидим что-то невероятное"],["57328902552445323","15","2",0,19388,[3],"Невероятно сильны!"],["57328901847802251","14","2",0,19388,[3],"Я скажу тебе две вещи"],["57328901109604747","13","2",0,19388,[3],"Погнали!"],["57328900723728779","12","2",0,19388,[3],"Принесите его"],["57328624151323019","11","2",0,19388,[3],"Твой баскетбол"],["57328623346016651","10","2",0,19388,[3],"Человек предполагает, а Бог располагает"],["57328622926586251","9","2",0,19388,[3],"Я пообещал"],["57328513824350603","8","2",0,19388,[3],"Я пошел"],["57328513404920203","7","1",0,19388,[3],"Я рассчитываю на тебя в контратаке!"],["57328512633168267","6","1",0,19388,[3],"Все просто идеально, если есть вероятность проигрыша"],["57328511878193547","5","1",0,19388,[3],"Это не только ради показухи"],["57328317749027211","4","1",0,19388,[3],"Он не может быть достойным этого"],["57328317379928459","3","1",0,19388,[3],"Я серьезен"],["57328220390842763","2","1",0,19388,[3],"Понедельник, в 8:40 на крыше"],["57328219635868043","1","1",0,19388,[3],"Я Куроко"]],"w":{"n":["Баскетбол, в который играет Куроко","Баскетбол Куроко","Kuroko no Basuke","Kuroko's Basketball","黒子のバスケ","The Basketball Which Kuroko Plays"],"t":"manga","p":