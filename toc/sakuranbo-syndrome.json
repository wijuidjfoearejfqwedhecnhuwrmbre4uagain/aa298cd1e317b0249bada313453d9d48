{"slug":"sakuranbo-syndrome","m":"36278340356694420","at":"2026-10-15","b":["36278340356759956"],"t":[["36240557764272525","Violent Manga Project"]],"c":[["37019667482567065","95.5","11",0,19248,[0],"Экстра. Радужные леденцы"],["37019667029582233","95","11",0,19248,[0],"Я вернулась. ❤️"],["37019666190721433","94","11",0,19248,[0],"Я стану еще моложе!"],["37019660352250265","93","11",0,19248,[0],"Дура!"],["37019659731493273","92","11",0,19248,[0],"Как неприлично. ❤️"],["37019659194622361","91.5","10",0,19248,[0],"Экстра. Psychic Duo"],["37019626965590425","91","10",0,19248,[0],"На самом деле, я..."],["37019626361610649","90","10",0,19248,[0],"Не валяй дурака."],["37019625908625817","89","10",0,19248,[0],"Теперь я спокоен."],["37019625388532121","88","10",0,19248,[0],"Умная женщина"],["37019624935547289","87","10",0,19248,[0],"Вместе..."],["37019624465785241","86","10",0,19248,[0],"Иди сюда."],["37019658540310937","85.5","9",0,19248,[0],"Экстра. Радужные шарики из \"ponchi\""],["37019624012800409","85","9",0,19248,[0],"Не так мала, как ты думаешь."],["37019609148187033","84","9",0,19248,[0],"Я не ребенок!"],["37019608477098393","83","9",0,19248,[0],"Это о тебе."],["37019607873118617","82","9",0,19248,[0],"И это все?.."],["37019607269138841","81","9",0,19248,[0],"Кто-то следит за мной?"],["37019606816154009","80","9",0,19248,[0],"Поздравляю."],["37019606262505881","79","9",0,19248,[0],"Но это все-таки я..."],["37019587774013849","78","8",0,19248,[0],"Так здорово!"],["37019587337806233","77","8",0,19248,[0],"Сообщник?"],["37019586029183385","76","8",0,19248,[0],"Маленькая дрянь!"],["37019585358094745","75","8",0,19248,[0],"На все 180 градусов?"],["37019584687006105","74","8",0,19248,[0],"У меня есть просьба..."],["37019584217244057","73","8",0,19248,[0],"Я не проиграю!"],["37019560896913817","72","8",0,19248,[0],"Эта девушка..."],["37019560427151769","71","8",0,19248,[0],"О чем ты думаешь?"],["37019559957389721","70","8",0,19248,[0],"Это же настоящее чудо!"],["37019559487627673","69","8",0,19248,[0],"Абсолютное обещание."],["37019558984311193","68","7",0,19248,[0],"Вот только не надо!"],["37019547827462553","67","7",0,19248,[0],"Давай?.."],["37019547307368857","66","7",0,19248,[0],"Что ты задумал?"],["37019546837606809","65","7",0,19248,[0],"А вы, собственно, кто?"],["37019546300735897","64","7",0,19248,[0],"Все-таки сказала!"],["37019545696756121","63","7",0,19248,[0],"С этого момента."],["37019545126330777","62","7",0,19248,[0],"Девушка, которую я любил."],["37019544589459865","61","7",0,19248,[0],"Похожие женщины."],["37019542005768601","60","7",0,19248,[0],"Жалеть не придется!"],["37019541334679961","59","7",0,19248,[0],"Я ведь на себя рассердился."],["37019540730700185","58","6",0,19248,[0],"Все кончено."],["37019540294492569","57","6",0,19248,[0],"К-как она может быть одной и той же?"],["37019539858284953","56","6",0,19248,[0],"Но она вспомнила."],["37019539405300121","55","6",0,19248,[0],"Давно не виделись."],["37019538750988697","54","6",0,19248,[0],"Вы для меня не просто \"другие люди\"."],["37019538130231705","53","6",0,19248,[0],"Я жду."],["37019537660469657","52","6",0,19248,[0],"Я никогда не могу быть собой."],["37019537207484825","51","6",0,19248,[0],"Я не могу позволить этому случиться!"],["37019536737722777","50","6",0,19248,[0],"Поняла!"],["37019536251183513","49","6",0,19248,[0],"Я хочу работать."],["37019535764644249","48","5",0,19248,[0],"Давай пожмем руки!"],["37019508736549273","47","5",0,19248,[0],"Я это сделаю!"],["37019508317118873","46","5",0,19248,[0],"Я могу забрать тебя к себе."],["37019507444703641","45","5",0,19248,[0],"Я сказала это тебе."],["37019506723283353","44","5",0,19248,[0],"Как жаль."],["37019506119303577","43","5",0,19248,[0],"Это нечестно!"],["37019505632764313","42","5",0,19248,[0],"Я должна была поговорить с ним."],["37019505012007321","41","5",0,19248,[0],"Это работает!"],["37019504106037657","40","5",0,19248,[0],"Высокие девчонки - клевые."],["37019482312434073","39","5",0,19248,[0],"Вот так всегда!"],["37019481809117593","38","4",0,19248,[0],"Что ты будешь с этим делать?"],["37019481339355545","37","4",0,19248,[0],"Вылитая копия."],["37019480852816281","36","4",0,19248,[0],"Случилось что-то плохое."],["37019480349499801","35","4",0,19248,[0],"Она не моя!"],["37019479879737753","34","4",0,19248,[0],"Он не понимает."],["37019479376421273","33","4",0,19248,[0],"Что все это значит?"],["37019478873104793","32","4",0,19248,[0],"Ты должна это понимать."],["37019478420119961","31","4",0,19248,[0],"Что будешь делать ночью?"],["37019477883249049","30","4",0,19248,[0],"Я бы сказала, 50 на 50."],["37019477396709785","29","4",0,19248,[0],"Я никогда тебя не отпущу."],["37019476910170521","28","3",0,19248,[0],"Я так больше не могу."],["37019399785308569","27","3",0,19248,[0],"Какого дьявола..."],["37019399181328793","26","3",0,19248,[0],"Я мог бы поговорить с ней."],["37019398577349017","25","3",0,19248,[0],"Я тебя недооценивала."],["37019397956592025","24","3",0,19248,[0],"Я ненавижу детей."],["37019397352612249","23","3",0,19248,[0],"Похоже, будет весело."],["37019396866072985","22","3",0,19248,[0],"Теперь мне спокойнее."],["37019396245315993","21","3",0,19248,[0],"Уступлю?"],["37019395607781785","20","3",0,19248,[0],"Что ты здесь делаешь?"],["37019395003802009","19","3",0,19248,[0],"Поступить так же."],["37019382538330521","18","2",0,19248,[0],"Я просто исчезну."],["37019382085345689","17","2",0,19248,[0],"Наверное, показалось..."],["37019381632360857","16","2",0,19248,[0],"Интересно, как у нее дела?.."],["37019381179376025","15","2",0,19248,[0],"У тебя крепкие нервы."],["37019380709613977","14","2",0,19248,[0],"Что скажешь?"],["37019380239851929","13","2",0,19248,[0],"Скорее в аду выпадет снег..."],["37019379602317721","12","2",0,19248,[0],"Вы мне нравитесь."],["37019379115778457","11","2",0,19248,[0],"Что за черт?"],["37019378646016409","10","2",0,19248,[0],"Давай сделаем это."],["37019378125922713","9","2",0,19248,[0],"Чушь"],["37019361852023193","8","1",0,19248,[0],"Я знаю, каково это."],["37019361415815577","7","1",0,19248,[0],"Иди за мной"],["37019360811835801","6","1",0,19248,[0],"Давай, я угощаю."],["37019360174301593","5","1",0,19248,[0],"О чем ты говоришь?"],["37019359754871193","4","1",0,19248,[0],"Ложь за ложью."],["37019359335440793","3","1",0,19248,[0],"Так же, как и у любого другого!"],["37019358765015449","2","1",0,19248,[0],"Давай!"],["37019358026817945","1","1",0,19248,[0],"Пожалуйста?"]],"w":{"n":["Вишневый синдром","Sakuranbo Syndrome - Cupid no Itazura II","Sakuranbo Syndrome","さくらんぼシンドローム クピドの悪戯II","Psychic Duo","Nijidama Punch","Nijidama Bonbon","Cupid's Prank II: Cherry Syndrome"],"t":"manga","p":2544,"s":["sakuranbo-syndrome",98,"2022-09-13","36278340356694420/covers/15b0a35883f96961e487f45169d4fad130b52767_83068535273709989.jpeg",1],"d":["sakuranbo-syndrome-cupid-no-itazura-ii",630],"h":["sakuranbo_syndrome","0006/69/568243.jpeg"],"x":1,"l":[1,22,62,119,48,8,159],"st":"f"}}