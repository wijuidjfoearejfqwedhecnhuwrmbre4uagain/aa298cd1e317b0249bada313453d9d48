{"slug":"wo-bei-kun-zai-tongyi-tian-shiwannian","m":"63299568636289469","at":"2026-10-16","b":["63299568636355005"],"t":[["52604506105471410","PULSAR TEAM"],["62878638722277803","Ливери"]],"c":[["253632830628709894","418","2",0,20742,[1],"Удачно подлизнул!"],["253252852539999783","417","2",0,20740,[1],"Давно не виделись"],["246680987637925377","416","2",0,20694,[1],"К сожалению, этого всё ещё недостаточно"],["245032101089396258","415","2",0,20683,[1],"Вход в Башню царя алхимии"],["243987733519812142","414","2",0,20676,[1],"За всё нужно платить"],["243417462123546123","413","2",0,20672,[1],"Ты только сейчас понял?"],["243057093764990475","412","2",0,20669,[1],"Убийство союзника?!"],["242190880063112763","411","2",0,20663,[1],"Да, я тебя игнорирую, и что?"],["239873125171349055","410","2",0,20647,[1],"Наследие царя алхимии"],["239653678615643711","409","2",0,20646,[1],"Убив тебя... я запачкаю руки!"],["239227354105267738","408","2",0,20643,[1],"Пытаешься уйти? Слишком поздно!"],["239005390514177562","407","2",0,20641,[1],"Нехорошо вот так убегать"],["238814148304061978","406","2",0,20640,[1],"В новое приключение"],["238568546437711386","405","2",0,20638,[1],"Почему ты спас меня?"],["237990202583303706","404","2",0,20634,[1],"Готовимся к побегу"],["237545798273877542","403","2",0,20631,[1],"Не хочешь остановиться?"],["236899511576839718","402","2",0,20627,[1],"Тот, кто посмеет прикоснуться к ней, умрёт!"],["236471197489972774","401","2",0,20624,[1],"Я заставлю ваш клан заплатить!"],["235524458503226918","400","2",0,20617,[1],"Линвьет спешит на помощь!"],["233691372920522281","399","2",0,20605,[1],"Хочешь, чтобы я взял вину на себя?"],["233636648208844329","398","2",0,20604,[1],"Вы трое должны умереть!"],["233636539240826409","397","2",0,20604,[1],"Останься в живых"],["233632497777264169","396","2",0,20604,[1],"Приказ короля богов"],["233624451441247785","395","2",0,20604,[1],"Угнетение"],["233604339065701929","394","2",0,20604,[1],"Вы никогда не учитесь!"],["233600288425002537","393","2",0,20604,[1],"Опасная троица"],["233577635341420073","392","2",0,20604,[1],"Плюс один в гарем злодея?"],["233571589805852201","391","2",0,20604,[1],"Твоя сила - фальшивка!"],["233404996765369897","390","2",0,20603,[1],"Ты не годишься мне в противники!"],["228075367603127852","389","2",0,20566,[1],"Судья продажная!"],["227116562576852524","388","2",0,20559,[1],"Кто подойдёт ближе - умрёт!"],["226767750700221996","387","2",0,20557,[1],"Я дам тебе шанс!"],["226376687384806956","386","2",0,20554,[1],"Будете нападать по одному или как обычно?"],["226247833030772268","385","2",0,20553,[1],"Пошла жара!"],["225811459806873132","384","2",0,20550,[1],"Взять их!"],["225595535510226476","383","2",0,20549,[1],"Благодетель, будь любезен, сдохни"],["224942224377398828","382","2",0,20544,[1],"Небесный демон? Пойду встречусь с ним!"],["224061429865530907","381","2",0,20538,[1],"Хочешь отомстить? Нападай!"],["223785098263152171","380","2",0,20536,[1],"Не люблю зависеть от других"],["222903790955677227","379","2",0,20530,[1],"Нечего бояться!"],["222768940256871979","378","2",0,20529,[1],"Я не встану перед ним на колени!"],["222186073818678790","377","2",0,20525,[1],"Теперь стало потише!"],["221869480320452102","376","2",0,20523,[1],"Тебя не должно здесь быть"],["220971569558603283","375","2",0,20517,[1],"Нападение на шестую область!"],["220709336706467347","374","2",0,20515,[1],"И эт овся твоя сила?!"],["219726893723698707","373","2",0,20508,[1],"Посмотрим, хватит ли этого!"],["219126415134574099","372","2",0,20504,[1],"Я не стану рубить вас на куски"],["218939171958441491","371","2",0,20503,[1],"Хорошая идея"],["218272804074702355","370","2",0,20498,[1],"Горячая картофелина"],["217785079835936275","369","2",0,20495,[1],"Земля изменилась?"],["217687964837234195","368","2",0,20494,[1],"Снова в Солнечной системе!"],["217367318534047251","367","2",0,20492,[1],"Пора тебе стать женщиной!"],["217038650876118547","366","2",0,20490,[1],"Морское сражение"],["216917852488222227","365","2",0,20489,[1],"Пора вернуться домой"],["216815204699227667","364","2",0,20488,[1],"Кто сказал, что нельзя убить бога!"],["216311361683080723","363","2",0,20485,[1],"Я хочу вырваться из этого неба!"],["215953522825381395","362","2",0,20482,[1],"Небо... рушится!"],["215730026501391898","361","2",0,20481,[1],"Пришло время старичка"],["214797392573711898","360","2",0,20474,[1],"Я сам с ним справлюсь!"],["214139551692637722","359","2",0,20470,[1],"Ты боишься?!"],["214028330209396250","358","2",0,20469,[1],"Судьбоносный момент"],["213927188007765530","357","2",0,20468,[1],"Я отомщу за вас!"],["213596986610304538","356","2",0,20466,[1],"От смерти к жизни"],["212183156760004122","355","2",0,20456,[1],"Я позволю тебе увидеть своё тело!"],["211553006137656858","354","2",0,20452,[1],"Неожиданная развязка"],["211318971473872410","353","2",0,20450,[1],"Нашей вражде конец!"],["211349739294180890","352","2",0,20451,[1],"Я оставлю тебе жизнь!"],["211349735217317402","351","2",0,20451,[1],"Битва с четырьмя лордами!"],["211349736072955418","350","2",0,20451,[1],"Давайте отправимся в Бездну Отчаяния!"],["211349738623092250","349","2",0,20451,[1],"Лорд дао? Пф!"],["211349737096365594","348","2",0,20451,[1],"Создание десятого царства дао"],["228126579115443766","347","2",0,20566,[1],"Золотой Ворон"],["211349729278182938","346","2",0,20451,[1],"Решим всё раз и навсегда!"],["211349733808031258","345","2",0,20451,[1],"Хочешь проиграть мне ещё раз?!"],["211349720000382490","344","2",0,20451,[1],"Кто-то не желает подчиняться?!"],["209279072662996506","343","2",0,20436,[1],"Вторжение императора зверей"],["209238253696468506","342","2",0,20436,[1],"Веселье только начинается!"],["209131062519940634","341","2",0,20435,[1],"Не боишься, что это ловушка?"],["209100909064504858","340","2",0,20435,[1],"Ты уже проиграл!"],["208987105534166554","339","2",0,20434,[1],"Сыграем ещё раз!"],["208208974061782536","338","2",0,20429,[1],"Пришло время выплеснуть гнев!"],["146468964858414647","337","