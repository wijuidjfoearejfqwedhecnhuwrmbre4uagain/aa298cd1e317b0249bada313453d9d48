{"slug":"kozure-batsuichi-saigo-no-koi-wa-numa-deshita","m":"248847029856388611","at":"2026-10-15","b":["248847029856454147"],"t":[["35867622918611374","HOLLYHOCK • TEAM"]],"c":[["252783356343764484","18","2",0,20736,[0],"Я просто хочу тебе помочь."],["251472562993776146","17","2",0,20727,[0],"Хочешь убедиться?"],["249296571433240065","16","2",0,20712,[0],"Прими это!"],["248923370668705281","15","2",0,20710,[0],"Придётся положиться на ничтожество."],["248923368118568449","14","2",0,20710,[0],"Ведь у тебя есть все мы!"],["248923365551654401","13","2",0,20710,[0],"Это было по-настоящему важно."],["248923362481423873","12","2",0,20710,[0],"Что такое семья?"],["248923360115836417","11","2",0,20710,[0],"Не пора ли тебе домой?"],["248923357146269185","10","1",0,20710,[0],"Не думай, что сможешь добиться успеха в жизни только благодаря приятной внешности."],["248923354730350081","9","1",0,20710,[0],"Я такая слабая женщина!"],["248923352465425921","8","1",0,20710,[0],"Тебе нравятся такие парни?"],["248923350133392897","7","1",0,20710,[0],"Чей это ребёнок?"],["248923347784582657","6","1",0,20710,[0],"Я не дружу с такими, как он."],["248923345368663553","5","1",0,20710,[0],"Мамочка не поможет ему?"],["248874790612387329","4","1",0,20709,[0],"Значит, я особенный?"],["248874787726706177","3","1",0,20709,[0],"Принц Юки-кун"],["248874783112971777","2","1",0,20709,[0],"Спаси меня."],["248874779757528577","1","1",0,20709,[0],"Мне не нужен партнёр."]],"w":{"n":["Последняя любовь матери-одиночки была болотом.","Kozure Batsuichi, Saigo no Koi wa Numa deshita.","When a Divorced Single Mother Met Her Love Swamp","Single Mother's Last Love Was a Bog","子連れバツイチ、最後の恋は沼でした。"],"t":"manga","p":8456,"s":["kozure-batsuichi-saigo-no-koi-wa-numa-deshita",18,"2026-10-10","248847029856388611/covers/84521239f867a29d2cd8a08aae4bfa6ce5b1e7fa_248847860110476850.jpeg",1],"h":["single_mother_s_last_love_was_a_bog","0027/49/2648240.jpg"],"l":[10,27,180,181,1,15,50,22,8,52],"st":"o"}}