{"slug":"saikin-imouto-no-yousu-ga-chotto-okashiinda-ga","m":"55412112318554534","at":"2026-10-15","b":["55412112318620070"],"t":[["35340452257358263","FixMyManga"],["55413592404550054","ТЕФТЕЛЬКА"],["55419298805473702","TISARO"],["55419913371672998","NeverMore Team"]],"c":[["55428121289056678","54","11",0,19375,[0],"Я вернулась, братик. Конец"],["55428120836071846","53","11",0,19375,[0],"Тебе нужно идти...верно?"],["55428120416641446","52","11",0,19375,[0],"Это... поцелуй, да?"],["55428120013988262","51","11",0,19375,[0],"Тебя это устраивает, Митсуки?"],["55428116440441254","50","11",0,19375,[0],"Такое случалось и раньше, верно?"],["55428116004233638","49","11",0,19375,[0],"Спасибо... юки-чан"],["55428115584803238","48.5","10",0,19375,[0],"Юуу-кун, я люблю тебя"],["55428115148595622","48","10",0,19375,[0],"Ты мне всё ещё нравишься даже сейчас"],["55428114695610790","47","10",0,19375,[0],"По какой-то причине это действительно неловко..."],["55428114276180390","46","10",0,19375,[0],"Я не могу просто сидеть здесь и ничего не делать"],["55428113873527206","45","10",0,19375,[0],"Как я могла забыть?"],["55428113437319590","44","10",0,19375,[0],"Хорошо, давайте работать вместе"],["55428112950780326","43.6","9",0,19375,[0],"Причина по которой я решила носить боковой хвостик"],["55428112497795494","43.5","9",0,19375,[0],"Я... я не толстая!"],["55428112061587878","43","9",0,19375,[0],"А также... из-за моих собственных чувств"],["55428111591825830","42","9",0,19375,[0],"Значит мы обе тебе нравимся?"],["55428111071732134","41","9",0,19375,[0],"Спасибо тебе юя... братик"],["55428110618747302","40","9",0,19375,[0],"Со мной что-то не так"],["55428110165762470","39","8",0,19375,[0],"Он такой маленький... и такой милый"],["55428109628891558","38","8",0,19375,[0],"Если бы ты только смогла назвать его по имени"],["55428109075243430","37","8",0,19375,[0],"Хочешь увидеть... больше?"],["55428108504818086","36","8",0,19375,[0],"Удивительное чувство свободы"],["55428107951169958","35","7",0,19375,[0],"Даже несмотря на это, они так сильно любят друг друга..."],["55428107280081318","34","7",0,19375,[0],"А-ах, боже! Что же мне теперь делать?"],["55426142718419366","33","7",0,19375,[0],"Тогда... обними меня как можно крепче!"],["55426142315766182","32","7",0,19375,[0],"Если бы я сейчас поговорила с мамой..."],["55426141594345894","31","7",0,19375,[0],"Могу я... сесть с тобой?"],["55426141242024358","30.5","7",0,19375,[0],"Не записывай туда таких странных слов!"],["55425478055453094","30","7",0,19375,[3],"Хочу это прямо от братика..."],["55425477703131558","29.6","6",0,19375,[3],"Этот парень ничего не понял."],["55425477350810022","29.5","6",0,19375,[3],"Ах, эта Золовка очень милая!"],["55425476981711270","29","6",0,19375,[3],"Как это выглядит с твоей стороны?"],["55425476612612518","28","6",0,19375,[3],"Насчёт этого утра..."],["55425476243513766","27","6",0,19375,[3],"Это расслабляет, когда мы вместе?"],["55425475857637798","26","6",0,19375,[3],"Вместе с Юу-у-куном внутри Митсуки-чан..."],["55420386254283174","25","5",0,19375,[3],"Она просто забавляется"],["55419706626040230","24","5",0,19375,[2],"Эй, а как мне тебя называть?"],["55419684262011302","23","5",0,19375,[2],"Я должна быть девушкой этого парня?"],["55419683842580902","22","5",0,19375,[2],"Ты ошибаешься! Юки-тян это мальчик!"],["55419683473482150","21.5","5",0,19375,[2],"Экстра"],["55417444671447462","21","4",0,19375,[1],"Что я сказал такого, из-за чего ты плачешь?"],["55417444302348710","20","4",0,19375,[1],"Почему... Я такая чувствительная..."],["55417443950027174","19","4",0,19375,[1],"Если утратить этот ваш самоконтроль..."],["55417443564151206","18","4",0,19375,[1],"Свидание?! Это - свидание?.."],["55417443161498022","17","4",0,19375,[1],"Будешь ужин? Ванную? Или же..."],["55415538712600998","16","4",0,19375,[1],"Словно что-то сковывает"],["55415441874510246","15","3",0,19375,[1],"Я тут совсем ни при чем!"],["55415440398115238","14","3",0,19375,[1],"Ревность? Не-не-не, не может быть!"],["55415438972051878","13","3",0,19375,[1],"Что плохого в том, чтоб млеть перед любимым?"],["55415437663429030","12","3",0,19375,[1],"Рывок вперед!"],["55415070175289766","11","3",0,19375,[1],"Сволочь, ты что делаешь?!"],["55415069017661862","10","2",0,19375,[1],"Братик, давай теперь со мной..."],["55414865157710246","9","2",0,19375,[1],"Почему именно сейчас моё тело..."],["55414864469844390","8","2",0,19375,[1],"Всё-таки я не могу спать одна"],["55414864117522854","7","2",0,19375,[1],"Братик, ты не забыл..."],["55414863765201318","6","2",0,19375,[1],"Следи за чувствами других, дурак!"],["55414863396102566","5","1",0,19375,[1],"Теперь ты больше похожа девушку"],["55414425678537126","4","1",0,19375,[1],"Мы ведь стали одной семьёй"],["55414424252473766","3","1",0,19375,[1],"Как так? Неужто... Смерть?"],["55414423883375014","2","1",0,19375,[1],"Ах! Как же это приятно!"],["55414423497499046","1","1",0,19375,[1]]]}