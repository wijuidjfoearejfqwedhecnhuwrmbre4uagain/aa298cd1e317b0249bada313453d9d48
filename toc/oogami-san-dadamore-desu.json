{"slug":"oogami-san-dadamore-desu","m":"42420776678220215","at":"2026-10-15","b":["42420776678285751"],"t":[["42321627542741431","Просто по Фану / Just for Fun"]],"c":[["42429637313192375","38.5","7",0,19285,[0],"Экстра. Многим после"],["42429636256227767","38","7",0,19285,[0],"Только одни во всём мире"],["42429481066979767","37","7",0,19285,[0],"Большое замешательство"],["42429479708025271","36","7",0,19285,[0],"Не ври мне с этими глазами"],["42429478516842935","35","7",0,19285,[0],"Правильное использование подушки"],["42429477224997303","34","7",0,19285,[0],"Вчетвером на Дзинботё"],["42429475245285815","33","7",0,19285,[0],"Пришёл новый дурачок"],["42429473383014839","32.5","6",0,19285,[0],"Экстра."],["42429472493822391","32","6",0,19285,[0],"Злись! Сражайся! Огами Мейко!"],["42428291696583095","31","6",0,19285,[0],"Ярость Мейко на грани взрыва"],["42428189087130039","30","6",0,19285,[0],"Баллада отца и снега"],["42428187812061623","29","6",0,19285,[0],"Это не друг, которого я не могу ненавидеть"],["42428187040309687","28","6",0,19285,[0],"Переживания и юная леди"],["42427666678178231","27.5","5",0,19285,[0],"Экстра. Рождество с другой стороны"],["42427660588048823","27","5",0,19285,[0],"Справить рождество, не потерпев при этом неудачу."],["42427659665301943","26","5",0,19285,[0],"Ты застенчивее, чем роза."],["42427659195539895","25","5",0,19285,[0],"Счастливый жёлтый букет цветов. Земля семьи Ягинума"],["42427658742555063","24","5",0,19285,[0],"К выздоравливающему синему небу"],["42427657165496759","23","5",0,19285,[0],"Завтра будет соединяющий год"],["42427654850240951","22","5",0,19285,[0],"Материнские зрачки в 10000 вольт"],["42427652534985143","21.5","4",0,19285,[0],"Экстра. Форзацы"],["42427651998114231","21","4",0,19285,[0],"Не стать волчицей"],["42427649213096375","20","4",0,19285,[0],"Колыбельная мисс Каору"],["42426185250005431","19","4",0,19285,[0],"Игры полуживой молодежи"],["42426183555506615","18","4",0,19285,[0],"Бессмертная Венера"],["4242617318718