{"slug":"zong-de-lai-shuo-he-zhi-pian-ba-zong-hezule","m":"36128846151442872","at":"2026-10-15","b":["36128846151508408"],"t":[["36039053451223479","Трискелион"]],"c":[["121216275799098898","18","1",0,19829,[0],"Конец"],["121216258183022098","17","1",0,19829,[0],"Тебе весело контролировать меня?"],["121216238838957586","16","1",0,19829,[0],"Никому нельзя доверять"],["121216216541971986","15","1",0,19829,[0],"Работа пустяк для меня!"],["121216175286797842","14","1",0,19829,[0],"Такой надежный!"],["121216154483050002","13","1",0,19829,[0],"Почему ты не рада?"],["121216138762798610","12","1",0,19829,[0],"Фантазии не от мира сего."],["121216123361314322","11","1",0,19829,[0],"Один стейк пожалуйста!"],["121216105711814162","10","1",0,19829,[0],"Попалась на глаза богатой старушке?!"],["121216087038707218","9","1",0,19829,[0],"Хватит притворятся! Ты же болен!"],["121216072106984978","8","1",0,19829,[0],"Я не интересуюсь тобой!"],["121216055900194322","7","1",0,19829,[0],"Слезь с высокой лошади!"],["121215630379664914","6","1",0,19829,[0],"Почему всё стоит денег?!"],["121215582665262610","5","1",0,19829,[0],"Это не твой секретарь"],["121215543557572114","4","1",0,19829,[0],"Не создавай проблем!"],["36153141556699576","3","1",0,19242,[0],"Женщина, я думаю ты..."],["36153125047919032","2","1",0,19242,[0],"Почему всё выходит из-под моего контроля?!"],["36153105854783928","1","1",0,19242,[0],"У меня галлюцинации?!"]]}