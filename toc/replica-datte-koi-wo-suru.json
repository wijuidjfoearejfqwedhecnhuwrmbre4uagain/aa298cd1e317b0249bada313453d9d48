{"slug":"replica-datte-koi-wo-suru","m":"80653404329763208","at":"2026-10-15","b":["80653404329828744"],"t":[["78949483529920925","Не знайки"]],"c":[["229272210152375844","21","1",0,20574,[0],"Подготовка к культурному фестивалю подходит к концу."],["212825090658682394","20","1",0,20461,[0]],["212824909179536922","19","1",0,20461,[0],"С тобой я готова хоть сто кругов нарезать"],["212825006856488474","18","1",0,20461,[0],"Подготовка к культурному фестивалю должна быть веселой, но..."],["212809845236057626","17","1",0,20461,[0],"Из огня да в полымя"],["212825490661066266","16","1",0,20461,[0],"Смена времен года..."],["212824901076141594","15","1",0,20461,[0],"Душераздирающее представление"],["212844183499589146","14","1",0,20461,[0],"Трудности реплики..."],["212809604684334618","13","1",0,20461,[0]],["212809472362432026","12","1",0,20461,[0],"Она должна быть мертва..."],["212809421426804250","11","1",0,20461,[0],"Идем к себе, вдвоем в тишине!"],["212809613962135066","10","1",0,20461,[0],"Напряженный разговор"],["212809778194302490","9","1",0,20461,[0],"Вот и настал долгожданный момент!"],["212809582907508250","8","1",0,20461,[0],"Встреться со своим заклятым врагом!"],["212824820377732634","7","1",0,20461,[0],"Строганный лёд и летний фестиваль всегда идут рука об руку!"],["212824763721074202","6","1",0,20461,[0],"Тот, кто зовет тебя, это..."],["108891453836517801","5","1",0,19744,[0],"Давно не виделись"],["84737712589922714","4","1",0,19577,[0],"Пока мы вместе, мы можем пойти куда угодно."],["83993918659649934","3","1",0,19572,[0],"Прогулка, только для нас двоих!"],["82282957653434776","2","1",0,19560,[0],"Это... Первое свидание?"],["80798147227443591","1","1",0,19550,[0],"Весенний ветерок в начале лета"]]}