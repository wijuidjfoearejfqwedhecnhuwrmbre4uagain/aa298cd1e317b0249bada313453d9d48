{"slug":"twenty-nights","m":"106872356542112144","at":"2026-10-15","b":["106872356542177680"],"t":[["50844433691730326","Rosarium Manga Team"]],"c":[["130818567955301935","20","1",0,19895,[0]],["130818567435208239","19","1",0,19895,[0]],["130818566915114543","18","1",0,19895,[0]],["130704817893951023","17","1",0,19894,[0],"Хочешь попробовать это?"],["130704817407411759","16","1",0,19894,[0],"Не стесняйся говорить мне."],["130704816904095279","15","1",0,19894,[0],"Что со мной не так?"],["130704816400778799","14","1",0,19894,[0],"Давай расстанемся."],["130704815897462319","13","1",0,19894,[0],"Тебе лучше приготовиться..."],["125327614469490178","12","1",0,19857,[0],"Не хочешь сходить на свидание?"],["124283922619057666","11","1",0,19850,[0],"Я же согласился помочь..."],["124283922115741186","10","1",0,19850,[0],"Я ревную..."],["124283921629201922","9","1",0,19850,[0],"У меня дилемма..."],["124283921159439874","8","1",0,19850,[0],"Нам нужно выпить только вдвоем."],["118644204820776493","7","1",0,19811,[0],"Даже садизм и мазохизм могут быть интересными."],["116944591873132052","6","1",0,19799,[0],"И это всё?"],["116777368059659796","5","1",0,19798,[0],"Не убегай в этот раз."],["116449426989401620","4","1",0,19796,[0],"Пожалуйста, дай мне шанс!"],["116449426586748436","3","1",0,19796,[0],"Это твой сон."],["108927509617205673","2","1",0,19744,[0],"Я просто не могу видеть твое лицо прямо сейчас!"],["107209176450621840","1","1",0,19732,[0],"Каковы на вкус твои слёзы?"]]}