{"slug":"ijiranaide-nagatoro-san","m":"40721051692327334","at":"2026-10-15","b":["40721051692392870"],"t":[["36923890114519449","Maougumi"],["39497904800424334","Dead Inside Team"],["51885373390872970","Inegeld"],["53181442183684504","Чернилко"],["53181445774008728","Just Nerd"],["53181455085363608","ZEDDTAY"]],"c":[["139114004978091540","154.5","20",0,19952,[1]],["135460484118824504","154","20",0,19927,[1]],["132968329278211628","153","19",0,19910,[1]],["130876787193366063","152","19",0,19895,[1]],["128839120473572889","151","19",0,19881,[1]],["125372675773253122","150","19",0,19857,[1]],["123625601255949826","149","18",0,19845,[1]],["121416488803452434","148","18",0,19830,[1]],["118948857152357933","147","18",0,19813,[1]],["116083919232779796","146","18",0,19793,[1]],["139113871196636692","145.5","19",0,19952,[1]],["113485805770589730","145","18",0,19775,[1]],["111249420208588316","144","18",0,19760,[1]],["108105581004349869","143","18",0,19738,[1],"Ну же, Сэмпай, скажи хоть что-нибудь."],["108105415279075757","142","18",0,19738,[1],"Сэмпай, это... Н-ну..."],["103343283568206226","141","18",0,19705,[1],"Сражаюсь ради себя и сэмпая"],["101900023310147986","140","18",0,19695,[1],"В тот день... Я встретила Сэмпая."],["98346496973365647","139","18",0,19671,[1],"Перевожу на тебя, Сэмпай!"],["139113787511883284","138.5","18",0,19952,[1]],["97665602939871676","138","18",0,19666,[1],"Сэмпай, это в твоём духе."],["94603947112686014","137","18",0,19645,[1],"Оставляю на тебя, Пайсэм"],["92754011064721841","136","18",0,19632,[1],"Вперёд, Гамо-тян!"],["90561654957302173","135","17",0,19617,[1],"Выше нос, Хатиодзи!"],["86950280477893032","134","17",0,19592,[1],"Сэмпай! Н-ну как?!"],["83869174253773200","133","17",0,19571,[1],"Я знаю, что ты имеешь в виду."],["81727737399632297","132","17",0,19556,[1],"Эй, Сэмпай... Что ты имел в виду?.."],["139113703457965588","131.5","17",0,19952,[1]],["80674411518124424","131","17",0,19549,[1],"А ну стоять! Сэмпай!"],["77961901199352208","130","17",0,19530,[1],"Мне интересно, как тут у тебя дела..."],["76048612924088756","129","17",0,19517,[1],"Ведь Сэмпай так старается!"],["72998934250807703","128","17",0,19496,[1],"Спасибо, что позаботились о моём Сэмпае!"],["70561303986463166","127","17",0,19479,[1],"Сэмпай, сегодня особенный день..."],["67648608144482725","126","16",0,19459,[1],"Сэмпай, время рафтинга!"],["66602671905202577","125","16",0,19452,[1],"Всё же Сэмпай застал меня врасплох!"],["139113615813854740","124.5","16",0,19952,[1]],["63409442154111370","124","16",0,19430,[0],"Сэмпай, я принимаю твой вызов!"],["61548488592220556","123","16",0,19417,[0],"Слушай... Сэмпай..."],["61548367125176716","122","16",0,19417,[0],"Учитывая, что это ты, Сэмпай… слишком уж много о себе возомнил!"],["59538706024915388","121","16",0,19403,[0],"Раз ты меня так слёзно просишь, Сэмпай!"],["59537375675572668","120","16",0,19403,[0],"Хотелось бы, чтобы Хаятти посидела с нами"],["53197728062136728","119","16",0,19359,[0],"Так ведь, Сэмпай-кун?"],["53197727642706328","118","15",0,19359,[0],"Сэмпай?! Да ещё и ушастые..."],["53197727189721496","117","15",0,19359,[0],"Так у тебя тоже будет тренировочный лагерь, Сэмпай?"],["139113518455670292","116.5","15",0,19952,[1]],["53197726518632856","116","15",0,19359,[0],"Смертельный приём: убийство Сэмпая!"],["53197725210010008","115","15",0,19359,[0],"Так сильно хочешь, чтобы я поцеловала тебя, Сэмпай?"],["53197324536537496","114","15",0,19359,[0],"Всецело полагаюсь на тебя, Сэмпай!"],["53197324200993176","113","15",0,19359,[0],"Всецело полагаюсь на тебя, Сэмпай!"],["53197323462795672","112","15",0,19359,[0],"И кого же ты хочешь нарисовать, Сэмпай?"],["53197322724598168","111","15",0,19359,[0],"Посоветуйте что-нибудь Сэмпаю, прошу!"],["53197322338722200","110","14",0,19359,[0],"Сэмпай, а что у вас с Нагаторо-сэмпай?"],["139113427908970004","109.5","14",0,19952,[1]],["53196800886071704","109","14",0,19359,[0],"Что ты там плетёшься, Сэмпай?!"],["53196739833782680","108.1","14",0,19359,[0],"Устроим конкурс на самую большую грудь!"],["53196739431129496","108","14",0,19359,[0],"Сэмпай! Сэмпай!!!"],["53196738994921880","107","14",0,19359,[0],"Я... Я!.."],["53196736444785048","106","14",0,19359,[0],"Ну что, ты готов, Сэмпай?"],["53196735991800216","105","14",0,19359,[0],"Сегодня весь день ты будешь рядом со мной, Сэмпай!"],["53196734532182424","104","14",0,19359,[0],"С Пайсэмом у тебя как там всё обстоит?"],["53196734297301400","103","14",0,19359,[0],"Ну и что ты тут замер, Сэмпай?"],["53196733793984920","102","13",0,19359,[0],"Раз уж ты так настаиваешь, Сэмпай!"],["53196731780719000","101","13",0,19359,[0],"Какой же ты дурак, Сэмпай!"],["53196731243848088","100","13",0,19359,[0],"Вот если бы мы были в одной параллели, Сэмпай..."],["53195687365468568","99.1","13",0,19359,[0],"Теперь моя очередь!"],["53195734794658200","99","13",0,19359,[0],"Ну что, испытал удовлетворение от изучения её груди и зада...?"],["53195686274949528","98","13",0,19359,[0],"А как насчёт тебя, сэмпай?"],["53195684748222872","97","13",0,19359,[0],"Я прямо вижу, как ты задёргался!"],["53195683557040536","96","13",0,19359,[0],"Что-то нужно от моего Сэмпая...?"],["53195109474263448","95","13",0,19359,[0],"Нагаторо... Поднажми...!!"],["53195107075121560","94.2","12",0,19359,[0],"Сладость и гадость! ♡"],["53195106706022808","94.1","12",0,19359,[0],"А!! Мой вулкан..!!"],["53195091522642328","94","12",0,19359,[0],"А, Сэмпай, этот тип..."],["53194506702447000","93","12",0,19359,[0],"Сэмпай... Не слишком ли довольный вид?"],["53194504437522840","92","12",0,19359,[0],"Мне всё-таки хочется, чтобы Сэмпай удивился..."],["53194502977905048","91","12",0,19359,[0],"Что скажешь, Сэмпай? Хочешь ли отведать?"],["53194500209664408","90","12",0,19359,[0],"А раз так, то давай сделаем нечто подходящее для свидания?"],["53194499807011224","89","12",0,19359,[0],"Объявляю твои очки за сегодня, Сэмпай!!"],["53194498146066840","88","12",0,19359,[0],"Ведь это всего лишь подготовка к свиданию, понял меня, Сэмпай?!"],["53193939447996824","87","12",0,19359,[0],"Салют, Сэмпай"],["53193856098787736","86.2","11",0,19359,[0],"Реклама нового томика"],["53193855427699096","86.1","11",0,19359,[0],"Сделай мне массаж, Сэмпай♡"],["53193855075377560","86","11",0,19359,[0],"Сэмпай, а давай отправимся вместе!"],["53193844304404888","85","11",0,19359,[0],"Сэмпай, а тебе не одиноко ли без меня...?"],["53193843968860568","84","11",0,19359,[0],"Значит, ты нашёл её, сэмпай..."],["53193836167455128","83","11",0,19359,[0],"Хатиодзи-сэмпай основательно позаботился обо мне."],["53193833214665112","82","11",0,19359,[0],"Ну же! Что скажешь? Сэмпай!"],["53193832442913176","81","11",0,19359,[0],"Прямо как у тебя, Сэмпай~"],["53193357362487704","80","11",0,19359,[0],"Если ты одержишь победу хотя бы раз, Сэмпай... Идет?"],["53193356792062360","79","11",0,19359,[0],"Чего тебе, Сэмпай?"],["53193349326201240","78.2","10",0,19359,[0],"Реклама манги"],["53193348051132824","78.1","10",0,19359,[0],"Глава-сан и Пайсэм~ У них там особый урок один на один~"],["53193347229049240","78","10",0,19359,[0],"Ты чего так испугался, Сэмпай?"],["53193346088198552","77","10",0,19359,[0],"Сэмпай, ты ведь таким не интересуешься?!"],["53193345232560536","76","10",0,19359,[0],"Пайсэм, а ты не хочешь немного подкачаться?"],["53193344007823768","75","10",0,19359,[0],"Было довольно неплохо! Сэмпай♡"],["53193340115509656","74","10",0,19359,[0],"Сэмпай, ты катаешься именно так, как я себе и представляла…"],["53193338773332376","73","10",0,19359,[0],"Сэмпай, так ты решил носить линзы?!"],["53193337850585496","72","10",0,19359,[0],"Так чего же ты пожелал в итоге, Сэмпай?"],["53193322482655640","71","9",0,19359,[0],"Ну что, какая судьба уготована в этом году, Сэмпай~?"],["53193336877506968","70.3","9",0,19359,[0],"Белый призрак девушки"],["53193336424522136","70.2","9",0,19359,[0],"Подарок на Рождество"],["53193323959050648","70.1","9",0,19359,[0],"Компания без парней: гнев и караоке на всю ночь"],["53193320804934040","70","9",0,19359,[0],"Ну, тогда, и для тебя... От меня, Сэмпай..."],["53193319395647896","69","9",0,19359,[0],"У тебя, Сэмпай, разве не рожденочество, а~?♡"],["53193318422569368","68","9",0,19359,[0],"Ух... Спасибо за угощение, Сэмпай!"],["53193316895842712","67","9",0,19359,[0],"А тебе, Сэмпай, я не ска-ажу♡"],["53193315302007192","66","9",0,19359,[0],"Ах ты... А ещё и Сэмпай"],["53193313875943832","65","9",0,19359,[0],"Пригляди за домом, сэмпай"],["53193313389404568","64","9",0,19359,[0],"Так это твоя комната, сэмпай"],["53192065835622808","63","8",0,19359,[0],"Утречка, сэмпай"],["53193320268063128","62.1","8",0,19359,[0],"Так тебе нравится по-доб-но-е, Сэмпай"],["53192065097425304","62","8",0,19359,[0],"Сэмпай... Хочешь узнать... Моё имя!!"],["53192063906242968","61","8",0,19359,[0],"Сэмпай, о чём ты говорил с сестрой?"],["53192061892977048","60","8",0,19359,[0],"Сэмпай, это... Спасибо... Что навестил"],["53192060685017496","59","8",0,19359,[0],"Ты можешь войти, Cэмпай-кун!"],["53192059812602264","58","8",0,19359,[0],"Сэмпай... Ты слышал... Что я сказала...?"],["53191216103186840","57","8",0,19359,[0],"Это так мило~ слышать такое от тебя, Пайсем!!"],["53191215012667800","56","8",0,19359,[0],"Сэмпай, что стряслось?"],["53190964948263320","55","8",0,19359,[2],"Тогда.. Я лизну твоё~♡"],["53190964579164568","54","8",0,19359,[2],"Так ты читаешь сёдзё мангу, Сэмпай~"],["53190964243620248","53.1","7",0,19359,[2],"Давай кто лучше нарисует, Сэмпай"],["53190963874521496","53","7",0,19359,[2],"Сэмпай, живее надевай его на меня ♡"],["53190963522199960","52","7",0,19359,[2],"У вас какие-то проблемы с моим сэмпаем...?"],["53190963153101208","51","7",0,19359,[2],"Протяни мне руку помощи и всему научи, Сэмпай"],["53190962784002456","50","7",0,19359,[2],"Ты приглашаешь меня, Сэмпай?"],["53190962431680920","49","7",0,19359,[2],"Ты — главный герой!"],["53190962062582168","48","7",0,19359,[2],"Это реальная картина твоего будущего, Сэмпай"],["53190474197918104","47","6",0,19359,[2],"В конце концов мы же друзья!"],["53190473828819352","46.2","6",0,19359,[2],"Ты как, Сэмпай?"],["53190472922849688","46.1","6",0,19359,[2],"Сэмпай ♡ как насчёт этой позы?"],["53190422020776344","46","6",0,19359,[2],"Она сказала: \"Здесь есть любовь\", Сэмпай."],["53190420510826904","45","6",0,19359,[2],"Неужели и к нашему непопулярному Сэмпаю наконец-то пришла весна?"],["53190420141728152","44","6",0,19359,[2],"Не недооценивай Торо кошку"],["53188568390066584","43","6",0,19359,[2],"Я уверена, ты достойно проявишь себя, Сэмпай!"],["53188167246832024","42","6",0,19359,[2],"Ты недооцениваешь этот матч, так ведь, Сэмпай?"],["53188165636219288","41","6",0,19359,[2],"Ты в порядке, Сэмпай?"],["53188155100127640","40","6",0,19359,[2],"Ты такой скромный, Сэмпай~♡"],["53188149764972952","39","6",0,19359,[2],"Что думаешь, Сэмпай?"],["53188147583934872","38.2","5",0,19359,[1],"Рутина Нагаторо"],["53188147164504472","38.1","5",0,19359,[2],"Сэмпай, почему твоё лицо такое красное~?"],["53188146308866456","38","5",0,19359,[2],"Давай сделаем это, Сэмпай!!"],["53187713876124056","37","5",0,19359,[2],"Сэмпай пялится в пустоту"],["53187713137926552","36","5",0,19359,[2],"Ты вынудил меня сделать это, Сэмпай..."],["53187656162501016","35","5",0,19359,[2],"Мы ведь станем сэмпаями Пайсэма, не так ли?"],["53187655961239960","34.1","5",0,19359,[2],"Было бы весьма забавно, случись все так, бывший Сэмпай"],["53187097950970264","34","5",0,19359,[2],"У Сэмпая не может быть настоящего свидания!!"],["53187097514762648","33","5",0,19359,[2],"Ты принёс бэнто, Сэмпай?"],["53186936034058648","32","5",0,19359,[2],"Сэмпай — скрытый извращенец!!"],["53186744455029144","31","5",0,19359,[2],"В тебе не хватает духа авантюризма, Сэмпай"],["53186727241605528","30.4","4",0,19359,[2],"Вставай, Сэмпай!"],["53186726855729560","30.3","4",0,19359,[2],"Вставай, Сэмпай!"],["53186726167863704","30.2","4",0,19359,[2],"Твои мышцы затекли, не так ли?"],["53186723735167384","30.1","4",0,19359,[2],"Ты такой отсталый, Сэмпай~ ♡"],["53186718332903832","30","4",0,19359,[2],"Сэмпай, давай сыграем в камень, ножницы, бумага!!"],["53186717594706328","29","4",0,19359,[2],"Не рыпайся, Пайсэм!"],["53186716319637912","28","4",0,19359,[2],"Я всё видела, Сэмпай..."],["53186713064858008","27","4",0,19359,[2],"Идём домой, Сэмпай"],["53186708384014744","26.1","4",0,19359,[2],"Ты прав, Сэмпай"],["53186707327050136","26","4",0,19359,[2],"Мы на свидании, Сэмпай? ♡"],["53186701488578968","25","4",0,19359,[2],"Не сдерживай меня, Сэмпай"],["53186700330951064","24","4",0,19359,[2],"Сэмпай, хочешь пойти на фестиваль?"],["53186699206877592","23.2","3",0,19359,[2],"Давайте вернём Сэмпаю мотивацию ♡"],["53186698468680088","23.1","3",0,19359,[2],"Как делишки, Сэмпай!! Зацени мой хула-хуп!"],["53186697378161048","23","3",0,19359,[2],"Я намажу тебя ♡ Сэмпай"],["53183859914727832","22","3",0,19359,[5],"Сэмпай! Пошли на море!!"],["53183679794536856","21","3",0,19359,[5],"Спасибо, Сэмпай!!"],["53183668990009752","20","3",0,19359,[5],"Спасибо, Сэмпай..."],["53183660551070104","19","3",0,19359,[5],"Грубый Сэмпай~♡"],["53183659544437144","18","3",0,19359,[5],"Давай как-нибудь повторим, Сэмпай"],["53183658420363672","17","3",0,19359,[5],"Привет, Сэмпай?"],["53182989865083288","16","3",0,19359,[5],"Пух Сэмпая"],["53182989026222488","15","3",0,19359,[4],"Сэмпай, твои руки такие тощие!!"],["53182987717599640","14.4","2",0,19359,[4],"Ты кажешься таким чувствительным, Сэмпай~♡"],["53182981191262616","14.3","2",0,19359,[4],"Сэмпай, отпусти его ниже, пожалуйста..."],["53182980285292952","14.2","2",0,19359,[4],"Увидимся, Сэм-пай♡"],["53182979345768856","14.1","2",0,19359,[4],"Сэмпай, теперь я готова"],["53182977399611800","14","2",0,19359,[4],"Сэмпай трус!"],["53182976409756056","13","2",0,19359,[4],"Это ты нарисовал, Сэмпай?"],["53182976896295320","12.1","2",0,19359,[3],"Это всего лишь практика, Сэмпай"],["53182603284472216","12","2",0,19359,[3],"Давай поиграем, Сэмпай!"],["53182602428834200","11","2",0,19359,[3],"Сюда, Сэмпай!"],["53182601069879704","10","2",0,19359,[3],"Тсуккоми, Сэмпай, тсуккоми!"],["53182599778034072","9","2",0,19359,[3],"Сэмпай, ты такой добродушный~♡"],["53182593352360344","8.2","1",0,19359,[3],"Неужели я забила голову сэмпая всякими пошлостями~?♡"],["53182592547053976","8.1","1",0,19359,[3],"Сэмпай, кто дал тебе шоколад?..."],["53182592144400792","8","1",0,19359,[3],"Сэмпай, можешь больше..."],["53182590064026008","7","1",0,19359,[3],"Сэмпай, на тебе мыло осталось"],["53182589174833560","6","1",0,19359,[3],"Как жизнь, Сэмпай?"],["53182587413225880","5","1",0,19359,[3],"Сэмпай, почисть пожалуйста свои зубы"],["53182586423370136","4","1",0,19359,[3],"Похоже желание Сэмпая наконец исполнилось!"],["53182585064415640","3","1",0,19359,[3],"Сэмпай, разве ты совсем не злишься?"],["53182583588020632","2","1",0,19359,[3],"За тобой забавно наблюдать"],["53182543826018712","1","1",0,19359,[3],"Ты слегка..."]],"w":{"n":["Не издевайся, Нагаторо-сан","Не издевайся, Нагаторо","Не дразни меня, Нагаторо-сан!","Нагаторо, хватит издеваться!","Please Don't Bully Me, Nagatoro","Ijiranaide, Nagatoro-san","Don't Toy With Me, Miss Nagatoro","イジらないで、長瀞さん","Please don't bully me","Nagatoro","please dont bully me nagatoro"],"t":"manga","p":51882,"s":["ijiranaide-nagatoro-san",193,"2024-08-17","40721051692327334/covers/2ddee77d10c35a1c6abc316dae3843838094f692_83914692535280014.jpeg",1],"h":["please_dont_bully_me_nagatoro",""],"l":[8,15,1,228],"st":"f"}}