{"slug":"seishun-forget","m":"84859231022375341","at":"2026-10-15","b":["84859231022440877"],"t":[["46479345484587422","Rulate Project"],["84859217449607597","Digamo"]],"c":[["84861546664059309","20","4",0,19578,[1],"Конец"],["84861544801788333","19","4",0,19578,[1],"Последний бой, стааарт~"],["84861543275061677","18","4",0,19578,[1],"Я не сдамся!"],["84861542251651501","17","4",0,19578,[1],"Я отстаиваю свою позицию"],["84861541714780589","16","4",0,19578,[1],"Ничего хорошего из этого не выйдет, понимаешь?"],["84861540758479277","15","3",0,19578,[1],"Ты правда это сказал?"],["84861189477130669","14","3",0,19578,[1],"Мне придётся это сделать..!"],["84861188957036973","13","3",0,19578,[1],"Вы правда встречаетесь?"],["84861187883295149","12","3",0,19578,[1],"Ты её знаешь?"],["84861187363201453","11","3",0,19578,[1],"Уверен, она не была бы против"],["84861186859884973","10","2",0,19578,[1],"Пришло моё время! Вот и я!"],["84861186356568493","9","2",0,19578,[1],"Почему с этого момента я не помню?"],["84861185299603885","8","2",0,19578,[1],"Если сделаешь так, я прощу тебя"],["84861184762732973","7","2",0,19578,[1],"Насладимся любовным треугольником!"],["84861183672213933","6","2",0,19578,[1],"Может ли это быть... знаком?"],["84859882297123245","5","1",0,19578,[0],"Я заставлю его сиять!"],["84859880250302893","4","1",0,19578,[0],"Две большие проблемы"],["84859879294001581","3","1",0,19578,[0],"Я сделаю всё для этого"],["84859878690021805","2","1",0,19578,[0],"Мужчина никогда не берёт назад своё слово!!"],["84859877716943277","1","1",0,19578,[0],"До завтра!"]]}